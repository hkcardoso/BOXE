{%- liquid
  assign vs_lang = request.locale.iso_code | slice: 0, 2
  assign vs_title = 'Pesquisar no VIRIATTO'
  assign vs_placeholder = 'Pesquisar produtos e marcas...'
  assign vs_suggest = 'Descobre no catálogo'
  assign vs_hint = 'Pesquisa por marca, modalidade ou equipamento'
  assign vs_matches = 'Resultados do catálogo'
  assign vs_empty = 'Não encontrámos produtos para esta pesquisa.'
  assign vs_error = 'Não foi possível carregar os resultados. Podes abrir a pesquisa completa.'
  assign vs_all = 'Ver todos os resultados'
  assign vs_loading = 'A procurar produtos...'
  assign vs_close = 'Fechar pesquisa'
  assign vs_popular = 'Pesquisar por marca'
  assign vs_brands = 'Fairtex,Venum,Everlast,Charlie,Leone 1947,RDX' | split: ','
  if vs_lang == 'en'
    assign vs_title = 'Search VIRIATTO'
    assign vs_placeholder = 'Search products and brands...'
    assign vs_suggest = 'Explore the catalogue'
    assign vs_hint = 'Search by brand, sport or equipment'
    assign vs_matches = 'Catalogue results'
    assign vs_empty = 'No products matched this search.'
    assign vs_error = 'Could not load results. You can open the full search.'
    assign vs_all = 'View all results'
    assign vs_loading = 'Finding products...'
    assign vs_close = 'Close search'
    assign vs_popular = 'Search by brand'
  elsif vs_lang == 'es'
    assign vs_title = 'Buscar en VIRIATTO'
    assign vs_placeholder = 'Buscar productos y marcas...'
    assign vs_suggest = 'Explora el catálogo'
    assign vs_hint = 'Busca por marca, disciplina o equipamiento'
    assign vs_matches = 'Resultados del catálogo'
    assign vs_empty = 'No encontramos productos para esta búsqueda.'
    assign vs_error = 'No se pudieron cargar los resultados. Puedes abrir la búsqueda completa.'
    assign vs_all = 'Ver todos los resultados'
    assign vs_loading = 'Buscando productos...'
    assign vs_close = 'Cerrar búsqueda'
    assign vs_popular = 'Buscar por marca'
  endif
-%}
<div class="vs-search" data-vs-search hidden
  data-search-route="{{ routes.search_url | escape }}"
  data-suggest-route="{{ routes.predictive_search_url | escape }}"
  data-loading="{{ vs_loading | escape }}"
  data-empty="{{ vs_empty | escape }}"
  data-error="{{ vs_error | escape }}">
  <button type="button" class="vs-search__backdrop" data-vs-close tabindex="-1" aria-label="{{ vs_close | escape }}"></button>
  <section class="vs-search__dialog" id="ViriattoSearchDialog" role="dialog" aria-modal="true" aria-labelledby="vs-search-heading" tabindex="-1">
    <div class="vs-search__top">
      <div class="vs-search__form-area">
        <p class="vs-search__overline" id="vs-search-heading">{{ vs_title }}</p>
        <form class="vs-search__form" data-vs-form method="get" action="{{ routes.search_url }}" role="search">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="vs-search__magnify" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 5 5"></path></svg>
          <input data-vs-input id="ViriattoSearchInput" name="q" type="search" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="{{ vs_placeholder | escape }}">
          <input type="hidden" name="options[prefix]" value="last">
          <button type="button" class="vs-search__clear" data-vs-clear hidden aria-label="{{ 'general.search.reset' | t }}">×</button>
        </form>
      </div>
      <button class="vs-search__exit" data-vs-close type="button" aria-label="{{ vs_close | escape }}">
        <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M5 5 19 19M19 5 5 19"></path></svg>
      </button>
    </div>
    <div class="vs-search__scroll">
      <div data-vs-initial>
        <div class="vs-search__head"><h2>{{ vs_suggest }}</h2><span>{{ vs_hint }}</span></div>
        <div class="vs-search__suggestions">
          {%- assign vs_products = collections['all'].products -%}
          {%- for product in vs_products limit: 8 -%}
            <a class="vs-search__suggestion" href="{{ product.url }}">
              <span class="vs-search__suggestion-media">
                {%- if product.featured_image != blank -%}
                  {{ product.featured_image | image_url: width: 144 | image_tag: loading: 'lazy', widths: '72, 144', alt: product.title }}
                {%- else -%}<span aria-hidden="true">V</span>{%- endif -%}
              </span>
              <span class="vs-search__suggestion-info">
                <small>{{ product.vendor | escape }}</small>
                <strong>{{ product.title | escape }}</strong>
                <b>{{ product.price | money }}</b>
              </span>
            </a>
          {%- endfor -%}
        </div>
        <div class="vs-search__chips">
          <span>{{ vs_popular }}</span>
          <div>
            {%- for vs_brand in vs_brands -%}
              <button type="button" data-vs-chip data-query="{{ vs_brand | escape }}">{{ vs_brand }}</button>
            {%- endfor -%}
          </div>
        </div>
      </div>
      <div data-vs-results hidden>
        <div class="vs-search__head vs-search__results-head">
          <h2>{{ vs_matches }}</h2>
          <span class="vs-search__status" data-vs-status role="status" aria-live="polite"></span>
        </div>
        <div class="vs-search__grid" data-vs-grid></div>
        <p class="vs-search__empty" data-vs-empty hidden>{{ vs_empty }}</p>
        <a class="vs-search__all" data-vs-all href="{{ routes.search_url }}">{{ vs_all }} <span aria-hidden="true">{% render 'viri-arrow-icon' %}</span></a>
      </div>
    </div>
  </section>
</div>