{%- liquid
  assign bx_lang = request.locale.iso_code | slice: 0, 2
  case bx_lang
    when 'en'
      assign bx_about_tag = 'ABOUT US'
      assign bx_about_title_a = 'MADE FOR'
      assign bx_about_title_b = 'THOSE WHO TRAIN.'
      assign bx_about_intro = 'VIRIATTO is a Portuguese multi-brand store dedicated to combat sports. We bring equipment and brands together to make choosing gear simpler.'
      assign bx_about_second = 'From boxing to Muay Thai, our goal is to help you find what you need and get back to training.'
      assign bx_about_catalog = 'Explore the catalogue'
      assign bx_about_steps_tag = 'HOW IT WORKS'
      assign bx_about_steps_title = 'FROM BROWSING TO TRAINING'
      assign bx_about_step_1 = 'Explore'
      assign bx_about_step_1_text = 'Browse equipment by category, brand or combat sport.'
      assign bx_about_step_2 = 'Choose'
      assign bx_about_step_2_text = 'Compare products and find the right option for your training.'
      assign bx_about_step_3 = 'Train'
      assign bx_about_step_3_text = 'Choose your gear and focus on the next session.'
      assign bx_about_help_title = 'NEED SOME HELP CHOOSING?'
      assign bx_about_help_text = 'Ask us about products, orders or partnerships.'
      assign bx_about_contact = 'Contact us'
    when 'es'
      assign bx_about_tag = 'SOBRE NOSOTROS'
      assign bx_about_title_a = 'HECHO PARA'
      assign bx_about_title_b = 'QUIEN ENTRENA.'
      assign bx_about_intro = 'VIRIATTO es una tienda online portuguesa multimarca dedicada a los deportes de combate. Reunimos equipamiento y marcas para que elegir sea más sencillo.'
      assign bx_about_second = 'Del boxeo al Muay Thai, queremos ayudarte a encontrar lo que necesitas y volver al entrenamiento.'
      assign bx_about_catalog = 'Ver catálogo'
      assign bx_about_steps_tag = 'CÓMO FUNCIONA'
      assign bx_about_steps_title = 'DE LA ELECCIÓN AL ENTRENAMIENTO'
      assign bx_about_step_1 = 'Explora'
      assign bx_about_step_1_text = 'Descubre productos por categoría, marca o modalidad.'
      assign bx_about_step_2 = 'Elige'
      assign bx_about_step_2_text = 'Compara productos y encuentra el equipo adecuado.'
      assign bx_about_step_3 = 'Entrena'
      assign bx_about_step_3_text = 'Prepara tu equipo y céntrate en el próximo entrenamiento.'
      assign bx_about_help_title = '¿NECESITAS AYUDA PARA ELEGIR?'
      assign bx_about_help_text = 'Consúltanos sobre productos, pedidos o colaboraciones.'
      assign bx_about_contact = 'Contactar'
    else
      assign bx_about_tag = 'SOBRE NÓS'
      assign bx_about_title_a = 'FEITO PARA'
      assign bx_about_title_b = 'QUEM TREINA.'
      assign bx_about_intro = 'A VIRIATTO é uma loja online portuguesa multimarca dedicada aos desportos de combate. Reunimos equipamento e marcas num só lugar para simplificar a tua escolha.'
      assign bx_about_second = 'Do Boxe ao Muay Thai, queremos que percas menos tempo à procura e tenhas mais tempo para treinar.'
      assign bx_about_catalog = 'Explorar catálogo'
      assign bx_about_steps_tag = 'COMO FUNCIONA'
      assign bx_about_steps_title = 'DO CLIQUE AO TREINO'
      assign bx_about_step_1 = 'Explora'
      assign bx_about_step_1_text = 'Procura equipamento por categoria, marca ou modalidade.'
      assign bx_about_step_2 = 'Escolhe'
      assign bx_about_step_2_text = 'Compara produtos e encontra a opção certa para o teu treino.'
      assign bx_about_step_3 = 'Treina'
      assign bx_about_step_3_text = 'Prepara o equipamento e foca-te no próximo treino.'
      assign bx_about_help_title = 'PRECISAS DE AJUDA A ESCOLHER?'
      assign bx_about_help_text = 'Fala connosco sobre produtos, encomendas ou parcerias.'
      assign bx_about_contact = 'Contactar'
  endcase
-%}
<section class="viri-about" aria-labelledby="ViriAboutTitle">
  <div class="viri-about__container">
    <div class="viri-about__intro">
      <div class="viri-about__heading">
        <p class="viri-about__eyebrow">{{ bx_about_tag | escape }}</p>
        <h1 id="ViriAboutTitle">{{ bx_about_title_a | escape }}<span>{{ bx_about_title_b | escape }}</span></h1>
      </div>
      <div class="viri-about__summary">
        <p>{{ bx_about_intro | escape }}</p>
        <p>{{ bx_about_second | escape }}</p>
        <a class="viri-about__catalog-link" href="{{ routes.all_products_collection_url }}">{{ bx_about_catalog | escape }} <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <div class="viri-about__process">
      <div class="viri-about__process-heading">
        <p class="viri-about__eyebrow">{{ bx_about_steps_tag | escape }}</p>
        <h2>{{ bx_about_steps_title | escape }}</h2>
      </div>
      <div class="viri-about__steps">
        <article class="viri-about__step">
          <span class="viri-about__step-number" aria-hidden="true">01</span>
          <h3>{{ bx_about_step_1 | escape }}</h3>
          <p>{{ bx_about_step_1_text | escape }}</p>
        </article>
        <article class="viri-about__step">
          <span class="viri-about__step-number" aria-hidden="true">02</span>
          <h3>{{ bx_about_step_2 | escape }}</h3>
          <p>{{ bx_about_step_2_text | escape }}</p>
        </article>
        <article class="viri-about__step">
          <span class="viri-about__step-number" aria-hidden="true">03</span>
          <h3>{{ bx_about_step_3 | escape }}</h3>
          <p>{{ bx_about_step_3_text | escape }}</p>
        </article>
      </div>
    </div>

    <div class="viri-about__help">
      <div>
        <h2>{{ bx_about_help_title | escape }}</h2>
        <p>{{ bx_about_help_text | escape }}</p>
      </div>
      <a href="{{ pages['contact'].url | default: '/pages/contact' }}">{{ bx_about_contact | escape }} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
