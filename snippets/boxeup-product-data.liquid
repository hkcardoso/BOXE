{% doc %}
  @param {product} product - Product to describe with published catalogue data.
{% enddoc %}
{
  "id": {{ product.id | json }},
  "title": {{ product.title | json | replace: '<', '\u003c' }},
  "url": {{ product.url | json }},
  "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 420 | json }}{% else %}null{% endif %},
  "vendor": {{ product.vendor | json | replace: '<', '\u003c' }},
  "type": {{ product.type | json | replace: '<', '\u003c' }},
  "price": {{ product.price | json }},
  "varies": {{ product.price_varies | json }},
  "available": {{ product.available | json }},
  "material": {{ product.metafields.custom.material.value | default: '' | json | replace: '<', '\u003c' }},
  "usage": [{% assign bx_first_usage = true %}{% for tag in product.tags %}{% case tag %}{% when 'bx:usage:bag' %}{% unless bx_first_usage %},{% endunless %}"bag"{% assign bx_first_usage = false %}{% when 'bx:usage:sparring' %}{% unless bx_first_usage %},{% endunless %}"sparring"{% assign bx_first_usage = false %}{% endcase %}{% endfor %}],
  "collections": {{ product.collections | map: 'handle' | json }},
  "options": [{% for option in product.options_with_values %}{"name":{{ option.name | json | replace: '<', '\u003c' }},"values":{{ option.values | map: 'name' | json | replace: '<', '\u003c' }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
}
