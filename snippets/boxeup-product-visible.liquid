{% doc %}
  @param {product} product - Product to check before showing a catalogue card.
{% enddoc %}
{%- liquid
  assign bx_vendor = product.vendor | downcase | strip
  assign bx_title = product.title | downcase | strip
  assign bx_test = false
  if bx_vendor == 'my store' or bx_title == 'test' or bx_title == 'teste' or bx_title == 'produto de teste'
    assign bx_test = true
  endif
  for tag in product.tags
    assign bx_tag = tag | downcase
    if bx_tag == 'test' or bx_tag == 'teste' or bx_tag == 'demo'
      assign bx_test = true
    endif
  endfor
  if product.price != nil and product.price <= 0
    assign bx_test = true
  endif
  if bx_test
    echo 'false'
  else
    echo 'true'
  endif
-%}
