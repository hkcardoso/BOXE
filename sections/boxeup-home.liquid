    assign vh_eyebrow = 'EQUIPMENT FOR'
    assign vh_title_a = 'THOSE WHO'
    assign vh_title_b = 'TRAIN.'
    assign vh_intro = 'Gloves, protection, clothing and accessories from leading combat sports brands.'
    assign vh_shop = 'SHOP PRODUCTS'
    assign vh_video_play = 'Play video'
    assign vh_video_pause = 'Pause video'
    assign vh_brands = 'EXPLORE BRANDS'
    assign vh_featured = 'FEATURED'
    assign vh_new = 'NEW ARRIVALS'
    assign vh_all = 'VIEW ALL'
    assign vh_delivery = 'DELIVERY IN PORTUGAL'
    assign vh_delivery_desc = 'Mainland Portugal'
    assign vh_returns = 'RETURNS'
    assign vh_returns_desc = 'See our policy'
    assign vh_support = 'CUSTOMER SUPPORT'
    assign vh_support_desc = 'Here to help'
    assign vh_shipping = 'FREE SHIPPING'
    assign vh_shipping_desc = 'On orders over €79'
