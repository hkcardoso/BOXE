{% doc %}
  @param {product} product - Product available for glove comparison.
{% enddoc %}
{% assign bx_kind = product.type | append: ' ' | append: product.title | downcase %}
{% if bx_kind contains 'luva' or bx_kind contains 'glove' %}
  <div class="bx-compare-control">
    <button type="button" class="bx-compare-button" data-bx-compare="{{ product.id }}" aria-pressed="false" aria-label="{{ 'boxeup_experience.compare' | t }}: {{ product.title | escape }}"><span aria-hidden="true">⇄</span> {{ 'boxeup_experience.compare' | t }}</button>
    <script type="application/json" data-bx-product>{% render 'boxeup-product-data', product: product %}</script>
  </div>
{% endif %}
