{%- comment -%}
  VIRIATTO SEO: store identity and simple navigation trails.
  Shopify already generates the Product schema via product | structured_data.
  Do not duplicate Product or pricing structured data here.
{%- endcomment -%}
{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": {{ request.origin | append: '/#organization' | json }},
          "name": "VIRIATTO",
          "url": {{ request.origin | append: routes.root_url | json }}
          {%- if settings.logo != blank -%},
          "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}
          {%- else -%},
          "logo": "https://cdn.shopify.com/s/files/1/0944/3937/5184/files/viriatto-v-favicon-512_ed2fad25-efd9-4e92-bf04-9bdf1191b02a.png?v=1794449408"
          {%- endif %}
        },
        {
          "@type": "WebSite",
          "@id": {{ request.origin | append: '/#website' | json }},
          "url": {{ request.origin | append: routes.root_url | json }},
          "name": "VIRIATTO",
          "inLanguage": {{ request.locale.iso_code | json }},
          "publisher": { "@id": {{ request.origin | append: '/#organization' | json }} }
        },
        {
          "@type": "WebPage",
          "@id": {{ canonical_url | append: '#webpage' | json }},
          "url": {{ canonical_url | json }},
          "name": {{ seo_title | default: page_title | json }},
          "inLanguage": {{ request.locale.iso_code | json }},
          "isPartOf": { "@id": {{ request.origin | append: '/#website' | json }} },
          "primaryImageOfPage": {{ 'viriatto-pack-training.jpg' | asset_url | prepend: 'https:' | json }}
        }
      ]
    }
  </script>
{%- elsif request.page_type == 'collection' or request.page_type == 'product' -%}
  {%- liquid
    assign breadcrumb_home = 'Início'
    assign seo_lang = request.locale.iso_code | slice: 0, 2
    if seo_lang == 'en'
      assign breadcrumb_home = 'Home'
    elsif seo_lang == 'es'
      assign breadcrumb_home = 'Inicio'
    endif
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ breadcrumb_home | json }},
          "item": {{ request.origin | append: routes.root_url | json }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {%- if request.page_type == 'product' -%}{{ product.title | json }}{%- else -%}{{ collection.title | json }}{%- endif -%},
          "item": {{ canonical_url | json }}
        }
      ]
    }
  </script>
  {%- if request.page_type == 'product' and product.featured_image != blank -%}
    {%- comment -%} Point search engines to the actual first product photo, not the brand logo. {%- endcomment -%}
    {%- assign viriatto_primary_product_image = product.featured_image | image_url: width: 1600 | prepend: 'https:' -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "@id": {{ canonical_url | append: '#webpage' | json }},
        "url": {{ canonical_url | json }},
        "name": {{ product.title | json }},
        "primaryImageOfPage": {
          "@type": "ImageObject",
          "url": {{ viriatto_primary_product_image | json }},
          "contentUrl": {{ viriatto_primary_product_image | json }},
          "caption": {{ product.title | json }}
        }
      }
    </script>
  {%- endif -%}
{%- endif -%}