{% comment %}
  Additional VIRIATTO navigation items, scoped to the multilingual theme.
  The promotion collection is maintained by Shopify's compare-at-price rule.
  "Novidades" uses the latest additions from the full catalogue.
{% endcomment %}
{%- liquid
  assign vi_nav_lang = request.locale.iso_code | slice: 0, 2
  case vi_nav_lang
    when 'en'
      assign vi_nav_new = 'New arrivals'
      assign vi_nav_sale = 'Offers'
    when 'es'
      assign vi_nav_new = 'Novedades'
      assign vi_nav_sale = 'Ofertas'
    else
      assign vi_nav_new = 'Novidades'
      assign vi_nav_sale = 'Promoções'
  endcase
  assign vi_nav_sale_url = collections['promocoes'].url | default: '/collections/promocoes'
-%}
{% if mode == 'mobile' %}
  <li>
    <a id="HeaderDrawer-ViriNew" href="{{ routes.all_products_collection_url }}?sort_by=created-descending" class="menu-drawer__menu-item list-menu__item link link--text focus-inset viri-nav-special viri-nav-special--new">{{ vi_nav_new }}</a>
  </li>
  <li>
    <a id="HeaderDrawer-ViriSale" href="{{ vi_nav_sale_url }}" class="menu-drawer__menu-item list-menu__item link link--text focus-inset viri-nav-special viri-nav-special--promo">{{ vi_nav_sale }}</a>
  </li>
{% else %}
  <li>
    <a id="HeaderMenu-ViriNew" href="{{ routes.all_products_collection_url }}?sort_by=created-descending" class="header__menu-item list-menu__item link link--text focus-inset viri-nav-special viri-nav-special--new"><span>{{ vi_nav_new }}</span></a>
  </li>
  <li>
    <a id="HeaderMenu-ViriSale" href="{{ vi_nav_sale_url }}" class="header__menu-item list-menu__item link link--text focus-inset viri-nav-special viri-nav-special--promo"><span>{{ vi_nav_sale }}</span></a>
  </li>
{% endif %}