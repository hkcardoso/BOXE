{%- if page.handle == 'sobre-a-viriatto' or page.handle == 'sobre-a-boxeup' -%}
  {% render 'boxeup-about-content' %}
{%- else -%}
  {{ 'viriatto-footer-pages.css' | asset_url | stylesheet_tag }}
  {% liquid
    assign info_lang = request.locale.iso_code | slice: 0, 2
    case info_lang
      when 'en'
        assign info_eyebrow = 'VIRIATTO / SUPPORT'
        assign info_home = 'Home'
        assign info_section = 'Information'
        assign info_navigation = 'Useful information'
        assign info_shipping = 'Shipping and delivery'
        assign info_returns = 'Returns and warranties'
        assign info_terms = 'Terms of sale'
        assign info_privacy = 'Privacy policy'
        assign info_contact = 'Contact us'
        assign info_back = 'Explore catalogue'
      when 'es'
        assign info_eyebrow = 'VIRIATTO / AYUDA'
        assign info_home = 'Inicio'
        assign info_section = 'Información'
        assign info_navigation = 'Información útil'
        assign info_shipping = 'Envíos y entregas'
        assign info_returns = 'Devoluciones y garantías'
        assign info_terms = 'Condiciones de venta'
        assign info_privacy = 'Política de privacidad'
        assign info_contact = 'Contacto'
        assign info_back = 'Explorar catálogo'
      else
        assign info_eyebrow = 'VIRIATTO / APOIO'
        assign info_home = 'Início'
        assign info_section = 'Informações'
        assign info_navigation = 'Informações úteis'
        assign info_shipping = 'Envios e entregas'
        assign info_returns = 'Devoluções e garantias'
        assign info_terms = 'Condições de venda'
        assign info_privacy = 'Política de privacidade'
        assign info_contact = 'Contactos'
        assign info_back = 'Explorar catálogo'
    endcase
  %}
  <section class="vi-support-page" aria-labelledby="ViriSupportHeading">
    <header class="vi-support-page__hero">
      <div class="vi-support-page__wrap">
        <nav class="vi-support-page__breadcrumb" aria-label="{{ info_section | escape }}">
          <a href="{{ routes.root_url }}">{{ info_home }}</a>
          <span aria-hidden="true">/</span>
          <span>{{ info_section }}</span>
        </nav>
        <p class="vi-support-page__eyebrow">{{ info_eyebrow }}</p>
        <h1 id="ViriSupportHeading">{{ page.title | escape }}</h1>
      </div>
    </header>
    <div class="vi-support-page__wrap vi-support-page__layout">
      <aside class="vi-support-page__sidebar" aria-label="{{ info_navigation | escape }}">
        <p>{{ info_navigation }}</p>
        <nav class="vi-support-page__nav">
          <a href="{{ pages['envios-e-entregas'].url | default: '/pages/envios-e-entregas' }}"{% if page.handle == 'envios-e-entregas' %} aria-current="page"{% endif %}>{{ info_shipping }} <span aria-hidden="true">↗</span></a>
          <a href="{{ pages['devolucoes-e-garantias'].url | default: '/pages/devolucoes-e-garantias' }}"{% if page.handle == 'devolucoes-e-garantias' %} aria-current="page"{% endif %}>{{ info_returns }} <span aria-hidden="true">↗</span></a>
          <a href="{{ pages['condicoes-gerais-de-venda'].url | default: '/pages/condicoes-gerais-de-venda' }}"{% if page.handle == 'condicoes-gerais-de-venda' %} aria-current="page"{% endif %}>{{ info_terms }} <span aria-hidden="true">↗</span></a>
          <a href="{{ pages['politica-de-privacidade'].url | default: '/pages/politica-de-privacidade' }}"{% if page.handle == 'politica-de-privacidade' %} aria-current="page"{% endif %}>{{ info_privacy }} <span aria-hidden="true">↗</span></a>
          <a href="{{ pages['contact'].url | default: '/pages/contact' }}">{{ info_contact }} <span aria-hidden="true">↗</span></a>
        </nav>
      </aside>
      <article class="vi-support-page__article">
        <div class="vi-support-page__content rte">
          {{ page.content }}
        </div>
        <footer class="vi-support-page__article-footer">
          <a href="{{ routes.all_products_collection_url }}">{{ info_back }} <span aria-hidden="true">→</span></a>
          <a href="{{ pages['contact'].url | default: '/pages/contact' }}">{{ info_contact }} <span aria-hidden="true">→</span></a>
        </footer>
      </article>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}