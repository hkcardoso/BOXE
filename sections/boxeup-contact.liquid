<section class="boxeup-contact page-width">
  <nav class="boxeup-breadcrumb" aria-label="{{ 'boxeup_sections.aria_breadcrumb' | t }}">
    <a href="{{ routes.root_url }}">{{ 'boxeup_sections.contact_home' | t }}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ 'boxeup_sections.contact_contact' | t }}</span>
  </nav>
  <div class="boxeup-contact__heading">
    <p class="boxeup-contact__eyebrow">{% if request.locale.iso_code == 'pt-PT' or request.locale.iso_code == 'pt' %}{{ section.settings.eyebrow | escape }}{% else %}{{ 'boxeup_experience.support' | t }}{% endif %}</p>
    <h1>{{ 'boxeup_experience.about_contact_title' | t }}</h1>
    <p>{{ 'boxeup_experience.contact_intro' | t }}</p>
  </div>
  <div class="boxeup-contact__grid">
    <aside class="boxeup-contact__details">
      <div class="boxeup-contact__detail">
        <span class="boxeup-contact__detail-number">{{ 'boxeup_sections.contact_support' | t }}</span>
        <h2>{{ 'boxeup_experience.help_title' | t }}</h2>
        <p>{{ 'boxeup_experience.about_contact_text' | t }}</p>
        <a class="boxeup-contact__email" href="mailto:business@boxeup.com">business@boxeup.com <span aria-hidden="true">→</span></a>
      </div>
      <div class="boxeup-contact__detail">
        <span class="boxeup-contact__detail-number">{{ 'boxeup_sections.contact_explore' | t }}</span>
        <h2>{{ 'boxeup_sections.contact_equipment' | t }}</h2>
        <p>{{ 'boxeup_sections.contact_equipment_desc' | t }}</p>
        <a class="boxeup-contact__link" href="{{ routes.all_products_collection_url }}">{{ 'boxeup_sections.contact_catalog' | t }} <span aria-hidden="true">↗</span></a>
      </div>
      {% if page.content != blank %}
        <div class="boxeup-contact__extra rte">
          {{ page.content }}
        </div>
      {% endif %}
    </aside>

    <div class="boxeup-contact__form-wrap">
      <span class="boxeup-contact__form-overline">{{ 'boxeup_sections.contact_send' | t }} </span>
      <h2>{{ 'boxeup_experience.send' | t }}</h2>
      <p class="boxeup-contact__form-intro">{{ 'boxeup_experience.contact_intro' | t }}</p>
      {% form 'contact', id: 'BoxeupContactForm', class: 'boxeup-contact__form' %}
        {% if form.posted_successfully? %}
          <div class="boxeup-contact__success" role="status" tabindex="-1" autofocus>
            <strong>{{ 'boxeup_sections.contact_sent' | t }}</strong>
            <p>{{ 'boxeup_sections.contact_received' | t }}</p>
          </div>
        {% endif %}
        {% if form.errors %}
          <div class="boxeup-contact__error" role="alert" tabindex="-1" autofocus>
            <strong>{{ 'boxeup_sections.contact_error' | t }}</strong>
            {{ form.errors | default_errors }}
          </div>
        {% endif %}
        <div class="boxeup-contact__fields">
          <div class="boxeup-contact__field">
            <label for="BoxeupContactName">{{ 'boxeup_sections.contact_name' | t }} <span aria-hidden="true">*</span></label>
            <input type="text" id="BoxeupContactName" name="contact[name]" autocomplete="name"
              value="{{ form.name | escape }}" placeholder="{{ 'boxeup_sections.contact_your_name' | t }}" required>
          </div>
          <div class="boxeup-contact__field">
            <label for="BoxeupContactEmail">{{ 'boxeup_sections.contact_email' | t }} <span aria-hidden="true">*</span></label>
            <input type="email" id="BoxeupContactEmail" name="contact[email]" autocomplete="email"
              value="{{ form.email | escape }}" placeholder="exemplo@email.com" autocapitalize="off" spellcheck="false"
              {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="BoxeupEmailError"{% endif %} required>
            {% if form.errors contains 'email' %}
              <span id="BoxeupEmailError" class="boxeup-contact__field-error">{{ 'boxeup_sections.contact_email_error' | t }}</span>
            {% endif %}
          </div>
          <div class="boxeup-contact__field">
            <label for="BoxeupContactSubject">{{ 'boxeup_experience.contact_subject' | t }} <span aria-hidden="true">*</span></label>
            <select id="BoxeupContactSubject" name="contact[assunto]" required>
              <option value="" disabled{% if form.assunto == blank %} selected{% endif %}>{{ 'boxeup_experience.subject_placeholder' | t }}</option>
              {% assign bx_subjects = 'produto,encomenda,devolucao,parceria' | split: ',' %}
              {% for value in bx_subjects %}{% assign bx_subject_key = 'boxeup_experience.subject_' | append: value %}<option value="{{ value }}"{% if form.assunto == value %} selected{% endif %}>{{ bx_subject_key | t }}</option>{% endfor %}
            </select>
          </div>
          <div class="boxeup-contact__field">
            <label for="BoxeupContactPhone">{{ 'boxeup_sections.contact_telephone' | t }} <span class="boxeup-contact__optional">{{ 'boxeup_sections.contact_optional' | t }}</span></label>
            <input type="tel" id="BoxeupContactPhone" name="contact[phone]" autocomplete="tel"
              value="{{ form.phone | escape }}" placeholder="+351">
          </div>
          <div class="boxeup-contact__field boxeup-contact__field--full">
            <label for="BoxeupContactBody">{{ 'boxeup_sections.contact_message' | t }} <span aria-hidden="true">*</span></label>
            <textarea id="BoxeupContactBody" name="contact[body]" rows="7" placeholder="{{ 'boxeup_sections.contact_message_help' | t }}" required>{{ form.body | escape }}</textarea>
          </div>
        </div>
        <div class="boxeup-contact__submit-row">
          <button type="submit">{{ 'boxeup_sections.contact_send_message' | t }} <span aria-hidden="true">↗</span></button>
          <span>{{ 'boxeup_sections.contact_required' | t }}</span>
        </div>
        {% if shop.privacy_policy != blank %}
          <p class="boxeup-contact__privacy">{{ 'boxeup_sections.contact_privacy' | t }} <a href="{{ shop.privacy_policy.url }}">{{ 'boxeup_sections.contact_policy' | t }}</a>.</p>
        {% endif %}
      {% endform %}
    </div>
  </div>
  {% render 'boxeup-faq', id: 'BxContactFaq' %}
</section>
{% schema %}
{
  "name": "BOXEUP | Contacto",
  "tag": "section",
  "class": "section-boxeup-contact",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "ESTAMOS AQUI PARA AJUDAR"},
    {"type": "text", "id": "heading", "label": "Título principal", "default": "Fala connosco."},
    {"type": "textarea", "id": "description", "label": "Introdução", "default": "Precisas de ajuda a escolher equipamento, tens uma dúvida sobre um produto ou queres apresentar uma proposta de parceria? Envia-nos uma mensagem."},
    {"type": "text", "id": "details_heading", "label": "Título do apoio", "default": "Como podemos ajudar?"},
    {"type": "textarea", "id": "details_text", "label": "Texto de apoio", "default": "Dúvidas sobre produtos, encomendas e colaborações. Explica-nos o que precisas e responderemos através do contacto que indicares."},
    {"type": "text", "id": "form_heading", "label": "Título do formulário", "default": "Envia-nos uma mensagem"},
    {"type": "textarea", "id": "form_intro", "label": "Introdução ao formulário", "default": "Preenche os campos abaixo para entrar em contacto com a BOXEUP."}
  ],
  "presets": [{"name": "BOXEUP | Contacto"}]
}
{% endschema %}

