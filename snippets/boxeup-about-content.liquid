{%- liquid
  assign vi_lang = request.locale.iso_code | slice: 0, 2
  assign vi_tagline = 'SOBRE NÓS'
  assign vi_title_prefix = 'FEITO PARA'
  assign vi_title_emphasis = 'QUEM TREINA.'
  assign vi_paragraph_1 = 'A VIRIATTO é uma loja online portuguesa multimarca dedicada aos desportos de combate.'
  assign vi_paragraph_2 = 'Boxe, Muay Thai, MMA ou jiu-jitsu. As marcas que procuras, num só lugar.'
  assign vi_paragraph_3 = 'Menos tempo à procura. Mais tempo a treinar.'
  assign vi_steps = 'DO CLIQUE AO TREINO'
  assign vi_s1 = 'Explora'
  assign vi_s1d = 'Encontra equipamento por marca ou modalidade.'
  assign vi_s2 = 'Escolhe'
  assign vi_s2d = 'Compara os produtos e seleciona o que precisas.'
  assign vi_s3 = 'Encomenda'
  assign vi_s3d = 'Faz a tua compra de forma simples e segura.'
  assign vi_s4 = 'Treina'
  assign vi_s4d = 'Prepara o próximo treino com o teu equipamento.'
  assign vi_contact = 'CONTACTOS'
  assign vi_catalog = 'Ver catálogo'
  if vi_lang == 'en'
    assign vi_tagline = 'ABOUT US'
    assign vi_title_prefix = 'MADE FOR'
    assign vi_title_emphasis = 'THOSE WHO TRAIN.'
    assign vi_paragraph_1 = 'VIRIATTO is a Portuguese multibrand online store dedicated to combat sports.'
    assign vi_paragraph_2 = 'Boxing, Muay Thai, MMA or jiu-jitsu. All the brands you need, in one place.'
    assign vi_paragraph_3 = 'Less time searching. More time training.'
    assign vi_steps = 'FROM CLICK TO TRAINING'
    assign vi_s1 = 'Explore'
    assign vi_s1d = 'Browse equipment by brand or discipline.'
    assign vi_s2 = 'Choose'
    assign vi_s2d = 'Compare products and find what you need.'
    assign vi_s3 = 'Order'
    assign vi_s3d = 'Complete your purchase simply and securely.'
    assign vi_s4 = 'Train'
    assign vi_s4d = 'Get ready for your next session.'
    assign vi_contact = 'CONTACT'
    assign vi_catalog = 'Shop catalogue'
  elsif vi_lang == 'es'
    assign vi_tagline = 'SOBRE NOSOTROS'
    assign vi_title_prefix = 'HECHO PARA'
    assign vi_title_emphasis = 'QUIENES ENTRENAN.'
    assign vi_paragraph_1 = 'VIRIATTO es una tienda online portuguesa multimarca dedicada a los deportes de combate.'
    assign vi_paragraph_2 = 'Boxeo, Muay Thai, MMA o jiu-jitsu. Las marcas que buscas, en un solo lugar.'
    assign vi_paragraph_3 = 'Menos tiempo buscando. Más tiempo entrenando.'
    assign vi_steps = 'DEL CLIC AL ENTRENAMIENTO'
    assign vi_s1 = 'Explora'
    assign vi_s1d = 'Busca equipamiento por marca o disciplina.'
    assign vi_s2 = 'Elige'
    assign vi_s2d = 'Compara productos y selecciona lo que necesitas.'
    assign vi_s3 = 'Compra'
    assign vi_s3d = 'Realiza tu pedido de forma sencilla y segura.'
    assign vi_s4 = 'Entrena'
    assign vi_s4d = 'Prepárate para tu próximo entrenamiento.'
    assign vi_contact = 'CONTACTO'
    assign vi_catalog = 'Ver catálogo'
  endif
-%}
<section class="vi-min-about" aria-labelledby="ViAboutTitle">
  <div class="vi-min-about__inner vi-info-rail">
    <header class="vi-min-about__intro">
      <p class="vi-min-eyebrow">{{ vi_tagline }}</p>
      <h1 id="ViAboutTitle">{{ vi_title_prefix }} <span>{{ vi_title_emphasis }}</span></h1>
      <p>{{ vi_paragraph_1 }}</p>
      <p>{{ vi_paragraph_2 }}</p>
      <p>{{ vi_paragraph_3 }}</p>
    </header>
    <div class="vi-min-about__process">
      <h2>{{ vi_steps }}</h2>
      <div class="vi-min-about__grid">
        <div class="vi-min-about__step"><span>01</span><h3>{{ vi_s1 }}</h3><p>{{ vi_s1d }}</p></div>
        <div class="vi-min-about__step"><span>02</span><h3>{{ vi_s2 }}</h3><p>{{ vi_s2d }}</p></div>
        <div class="vi-min-about__step"><span>03</span><h3>{{ vi_s3 }}</h3><p>{{ vi_s3d }}</p></div>
        <div class="vi-min-about__step"><span>04</span><h3>{{ vi_s4 }}</h3><p>{{ vi_s4d }}</p></div>
      </div>
    </div>
    <div class="vi-min-about__bottom">
      <span>{{ vi_contact }}</span>
      <a href="mailto:business@boxeup.com">business@boxeup.com</a>
      <a href="{{ routes.all_products_collection_url }}" class="vi-min-about__shop">{{ vi_catalog }} <span aria-hidden="true">{% render 'viri-arrow-icon' %}</span></a>
    </div>
  </div>
</section>