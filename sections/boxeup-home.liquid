<section class="vh-home" aria-label="{{ 'boxeup_sections.aria_home' | t }}">
  <div class="vh-hero" id="ViriattoHero-{{ section.id }}">
    <div class="vh-hero__media" aria-hidden="true">
      {%- if section.settings.hero_image != blank -%}
        {{ section.settings.hero_image | image_url: width: 2200 | image_tag: class: 'vh-hero__image', widths: '800,1200,1600,2200', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: '' }}
      {%- else -%}
        <img class="vh-hero__image" src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-hero-video-poster.jpg?v=1793029300" alt="" width="1920" height="1080" loading="eager" fetchpriority="high">
      {%- endif -%}
      {%- if section.settings.hero_video != blank -%}
        {{ section.settings.hero_video | video_tag: class: 'vh-hero__video', autoplay: true, muted: true, loop: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1600x' }}
      {%- endif -%}
    </div>
    {%- if section.settings.hero_video != blank -%}
      <button type="button" class="vh-hero__video-toggle" data-state="paused" aria-label="{{ vh_video_play | escape }}" data-play-label="{{ vh_video_play | escape }}" data-pause-label="{{ vh_video_pause | escape }}">
        <svg class="vh-hero__icon-play" aria-hidden="true" viewBox="0 0 24 24"><path d="m8 5 11 7-11 7z"/></svg>
        <svg class="vh-hero__icon-pause" aria-hidden="true" viewBox="0 0 24 24"><path d="M8 5v14M16 5v14"/></svg>
      </button>
    {%- endif -%}
    <div class="vh-frame vh-hero__inner">
      <div class="vh-hero__copy">
        <p class="vh-eyebrow">{{ vh_eyebrow }}</p>
        <h1 class="vh-title">{{ vh_title_a }}<br>{{ vh_title_b }}</h1>
        <p class="vh-intro">{{ vh_intro }}</p>
        <div class="vh-actions">
          <a class="vh-button vh-button--primary" href="{{ routes.all_products_collection_url }}">{{ vh_shop }} <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></a>
