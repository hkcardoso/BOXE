  </div>

  {%- if section.settings.hero_video != blank -%}
    <script>
      (() => {
        const hero = document.getElementById('ViriattoHero-{{ section.id }}');
        const video = hero?.querySelector('.vh-hero__video');
        const button = hero?.querySelector('.vh-hero__video-toggle');
        if (!hero || !video || !button) return;

        // iOS Safari autoplay needs muted + playsinline. Keep the poster visible
        // until a video frame plays, and allow an explicit tap in Low Power Mode.
        video.muted = true;
        video.defaultMuted = true;
        video.playsInline = true;
        video.setAttribute('playsinline', '');
        video.setAttribute('webkit-playsinline', '');
        let manuallyPaused = false;
        let inViewport = true;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const update = () => {
          const playing = !video.paused && !video.ended;
          button.dataset.state = playing ? 'playing' : 'paused';
          button.setAttribute('aria-label', button.dataset[playing ? 'pauseLabel' : 'playLabel']);
          button.setAttribute('aria-pressed', String(playing));
        };
        const tryPlay = () => {
          if (document.hidden || !inViewport || manuallyPaused || reduceMotion.matches) {
            update();
            return;
          }
          const attempt = video.play();
          if (attempt && typeof attempt.catch === 'function') attempt.catch(update);
        };
        video.addEventListener('playing', () => {
          hero.classList.add('vh-hero--video-ready');
          update();
        });
        video.addEventListener('pause', update);
        video.addEventListener('error', update);
        button.addEventListener('click', () => {
          if (video.paused) {
            manuallyPaused = false;
            const attempt = video.play();
            if (attempt && typeof attempt.catch === 'function') attempt.catch(update);
          } else {
            manuallyPaused = true;
            video.pause();
          }
        });
        if ('IntersectionObserver' in window) {
          new IntersectionObserver(([entry]) => {
            inViewport = !!entry?.isIntersecting;
            if (!inViewport) video.pause();
            else tryPlay();
          }, { threshold: .05 }).observe(hero);
        }
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) video.pause();
          else tryPlay();
        });
        window.addEventListener('pageshow', tryPlay);
        tryPlay();
        update();
      })();
    </script>
  {%- endif -%}

