{% doc %}
  @param {string} id - Unique ID for the FAQ heading.
{% enddoc %}
<section class="bx-faq" aria-labelledby="{{ id }}">
  <p class="bx-eyebrow">{{ 'boxeup_experience.faq_eyebrow' | t }}</p>
  <h2 id="{{ id }}">{{ 'boxeup_experience.faq_title' | t }}</h2>
  {% assign bx_faq_keys = 'weights,availability,shipping,returns,help' | split: ',' %}
  {% for key in bx_faq_keys %}
    {% assign bx_question = 'boxeup_experience.faq_' | append: key | append: '_question' %}
    {% assign bx_answer = 'boxeup_experience.faq_' | append: key | append: '_answer' %}
    <details class="bx-faq-item">
      <summary>{{ bx_question | t }}<span aria-hidden="true">+</span></summary>
      <div class="bx-faq-answer">
        <p>{{ bx_answer | t }}</p>
        {% case key %}
          {% when 'weights' %}<button type="button" class="bx-text-button" data-bx-open="BxSizeGuide">{{ 'boxeup_experience.size_guide' | t }} →</button>
          {% when 'shipping' %}<a href="{{ shop.shipping_policy.url | default: pages['envios-e-entregas'].url | default: '/pages/envios-e-entregas' }}">{{ 'boxeup_experience.shipping' | t }} →</a>
          {% when 'returns' %}<a href="{{ shop.refund_policy.url | default: pages['devolucoes-e-garantias'].url | default: '/pages/devolucoes-e-garantias' }}">{{ 'boxeup_experience.returns' | t }} →</a>
          {% when 'help' %}<a href="mailto:business@boxeup.com">business@boxeup.com →</a>
        {% endcase %}
      </div>
    </details>
  {% endfor %}
</section>
