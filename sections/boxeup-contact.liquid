<section class="boxeup-contact page-width">
  <nav class="boxeup-breadcrumb" aria-label="Percurso de navegação">
    <a href="{{ routes.root_url }}">Início</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Contacto</span>
  </nav>
  <div class="boxeup-contact__heading">
    <p class="boxeup-contact__eyebrow">02 / {{ section.settings.eyebrow | escape }}</p>
    <h1>{{ section.settings.heading | escape }}</h1>
    <p>{{ section.settings.description | escape }}</p>
  </div>
  <div class="boxeup-contact__grid">
    <aside class="boxeup-contact__details">
      <div class="boxeup-contact__detail">
        <span class="boxeup-contact__detail-number">01 — APOIO</span>
        <h2>{{ section.settings.details_heading | escape }}</h2>
        <p>{{ section.settings.details_text | escape }}</p>
      </div>
      <div class="boxeup-contact__detail">
        <span class="boxeup-contact__detail-number">02 — EXPLORAR</span>
        <h2>Procura equipamento?</h2>
        <p>Consulta o catálogo e encontra artigos para a tua modalidade.</p>
        <a class="boxeup-contact__link" href="{{ routes.all_products_collection_url }}">Explorar catálogo <span aria-hidden="true">↗</span></a>
      </div>
      {% if page.content != blank %}
        <div class="boxeup-contact__extra rte">
          {{ page.content }}
        </div>
      {% endif %}
    </aside>

    <div class="boxeup-contact__form-wrap">
      <span class="boxeup-contact__form-overline">ENVIAR PEDIDO <span>↗</span></span>
      <h2>{{ section.settings.form_heading | escape }}</h2>
      <p class="boxeup-contact__form-intro">{{ section.settings.form_intro | escape }}</p>
      {% form 'contact', id: 'BoxeupContactForm', class: 'boxeup-contact__form' %}
        {% if form.posted_successfully? %}
          <div class="boxeup-contact__success" role="status" tabindex="-1" autofocus>
            <strong>Mensagem enviada.</strong>
            <p>Recebemos o teu contacto. Obrigado!</p>
          </div>
        {% endif %}
        {% if form.errors %}
          <div class="boxeup-contact__error" role="alert" tabindex="-1" autofocus>
            <strong>Não foi possível enviar a mensagem.</strong>
            {{ form.errors | default_errors }}
          </div>
        {% endif %}
        <div class="boxeup-contact__fields">
          <div class="boxeup-contact__field">
            <label for="BoxeupContactName">Nome <span aria-hidden="true">*</span></label>
            <input type="text" id="BoxeupContactName" name="contact[name]" autocomplete="name"
              value="{{ form.name | escape }}" placeholder="O teu nome" required>
          </div>
          <div class="boxeup-contact__field">
            <label for="BoxeupContactEmail">Email <span aria-hidden="true">*</span></label>
            <input type="email" id="BoxeupContactEmail" name="contact[email]" autocomplete="email"
              value="{{ form.email | escape }}" placeholder="exemplo@email.com" autocapitalize="off" spellcheck="false"
              {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="BoxeupEmailError"{% endif %} required>
            {% if form.errors contains 'email' %}
              <span id="BoxeupEmailError" class="boxeup-contact__field-error">Confirma o endereço de email.</span>
            {% endif %}
          </div>
          <div class="boxeup-contact__field boxeup-contact__field--full">
            <label for="BoxeupContactPhone">Telefone <span class="boxeup-contact__optional">(opcional)</span></label>
            <input type="tel" id="BoxeupContactPhone" name="contact[phone]" autocomplete="tel"
              value="{{ form.phone | escape }}" placeholder="+351">
          </div>
          <div class="boxeup-contact__field boxeup-contact__field--full">
            <label for="BoxeupContactBody">Mensagem <span aria-hidden="true">*</span></label>
            <textarea id="BoxeupContactBody" name="contact[body]" rows="7" placeholder="Como te podemos ajudar?" required>{{ form.body | escape }}</textarea>
          </div>
        </div>
        <div class="boxeup-contact__submit-row">
          <button type="submit">Enviar mensagem <span aria-hidden="true">↗</span></button>
          <span>* Campos obrigatórios</span>
        </div>
        {% if shop.privacy_policy != blank %}
          <p class="boxeup-contact__privacy">Consulta a nossa <a href="{{ shop.privacy_policy.url }}">Política de Privacidade</a>.</p>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "BOXEUP | Contacto",
  "tag": "section",
  "class": "section-boxeup-contact",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "ESTAMOS AQUI PARA AJUDAR"},
    {"type": "text", "id": "heading", "label": "Título principal", "default": "FALA CONNOSCO."},
    {"type": "textarea", "id": "description", "label": "Introdução", "default": "Precisas de ajuda a escolher equipamento, tens uma dúvida sobre um produto ou queres apresentar uma proposta de parceria? Envia-nos uma mensagem."},
    {"type": "text", "id": "details_heading", "label": "Título do apoio", "default": "COMO PODEMOS AJUDAR?"},
    {"type": "textarea", "id": "details_text", "label": "Texto de apoio", "default": "Dúvidas sobre produtos, encomendas e colaborações. Explica-nos o que precisas e responderemos através do contacto que indicares."},
    {"type": "text", "id": "form_heading", "label": "Título do formulário", "default": "Envia-nos uma mensagem"},
    {"type": "textarea", "id": "form_intro", "label": "Introdução ao formulário", "default": "Preenche os campos abaixo para entrar em contacto com a BOXEUP."}
  ],
  "presets": [{"name": "BOXEUP | Contacto"}]
}
{% endschema %}
