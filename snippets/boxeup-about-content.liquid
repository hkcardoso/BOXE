<section class="bx-about" aria-labelledby="bx-about-title">
  <div class="bx-about__hero">
    <img class="bx-about__hero-image" style="-webkit-mask-image:linear-gradient(to right,transparent 0%,rgba(0,0,0,.24) 22%,rgba(0,0,0,.72) 53%,#000 87%);mask-image:linear-gradient(to right,transparent 0%,rgba(0,0,0,.24) 22%,rgba(0,0,0,.72) 53%,#000 87%)" src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-home-hero-2026.jpg?v=1793013818" alt="{{ 'boxeup_experience.alt_boxer' | t | escape }}" width="1920" height="1280" fetchpriority="high">
    <div class="bx-about__hero-shade" aria-hidden="true" style="background:linear-gradient(to right,rgba(8,9,11,.84) 0%,rgba(8,9,11,.60) 34%,rgba(8,9,11,.25) 60%,transparent 88%)"></div>
    <div class="bx-about__container bx-about__hero-content">
      <p class="bx-about__eyebrow bx-about__eyebrow--light">{{ 'boxeup_experience.about_label' | t }}</p>
      <h1 id="bx-about-title">{{ 'boxeup_experience.about_title' | t }}</h1>
      <p class="bx-about__hero-description">{{ 'boxeup_experience.about_origin' | t }}</p>
      <a class="bx-about__button bx-about__button--red" href="{{ routes.all_products_collection_url }}">{{ 'boxeup_experience.catalog' | t }} <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="bx-about__trust">
    <div class="bx-about__container bx-about__trust-grid">
      <div class="bx-about__benefit">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 6h18l5 8-14 15L2 14 7 6Z"/><path d="M2 14h28M11 6l-4 8 9 15 9-15-4-8"/></svg>
        <div><strong>{{ 'boxeup_experience.selection_label' | t }}</strong><span>{{ 'boxeup_experience.selection_desc' | t }}</span></div>
      </div>
      <div class="bx-about__benefit">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 7h18v17H2zM20 13h5l5 6v5H20z"/><circle cx="8" cy="25" r="3"/><circle cx="25" cy="25" r="3"/></svg>
        <div><strong>{{ 'boxeup_experience.shipping' | t }}</strong><span>{{ 'boxeup_experience.shipping_help' | t }}</span></div>
      </div>
      <div class="bx-about__benefit">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round" aria-hidden="true"><path d="m16 2 12 5v8c0 8-5 12-12 15C9 27 4 23 4 15V7l12-5Z"/><path d="M16 8v16"/></svg>
        <div><strong>{{ 'boxeup_experience.support' | t }}</strong><span>{{ 'boxeup_experience.about_support' | t }}</span></div>
      </div>
      <div class="bx-about__benefit">
        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="28" height="20" rx="2"/><path d="M2 12h28M7 21h7"/></svg>
        <div><strong>{{ 'boxeup_experience.secure' | t }}</strong><span>{{ 'boxeup_experience.secure_desc' | t }}</span></div>
      </div>
    </div>
  </div>

  <div class="bx-about__mission bx-about__container">
    <div class="bx-about__mission-copy">
      <p class="bx-about__eyebrow">{{ 'boxeup_experience.about_mission_label' | t }}</p>
      <h2>{{ 'boxeup_experience.about_mission_title' | t }}</h2>
      <p>{{ 'boxeup_experience.about_mission' | t }}</p>
      <p>{{ 'boxeup_experience.about_future' | t }}</p>
    </div>
    <div class="bx-about__mosaic">
      <div class="bx-about__mosaic-main"><img src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-training-editorial-2026.jpg?v=1793013824" alt="{{ 'boxeup_experience.alt_equipment' | t | escape }}" width="1600" height="1068" loading="lazy"></div>
      <div><img src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-muay-thai.jpg?v=1792197595" alt="{{ 'boxeup_experience.alt_thai' | t | escape }}" width="1000" height="1000" loading="lazy"></div>
      <div><img src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-boxe.jpg?v=1792197588" alt="{{ 'boxeup_experience.alt_preparation' | t | escape }}" width="1000" height="1000" loading="lazy"></div>
    </div>
  </div>

  <div class="bx-about__community">
    <div class="bx-about__community-photo">
      <img src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-disciplina-banner.jpg?v=1793120726" alt="{{ 'boxeup_experience.alt_boxer_training' | t | escape }}" width="2172" height="724" loading="lazy">
    </div>
    <div class="bx-about__community-copy">
      <p class="bx-about__eyebrow">{{ 'boxeup_experience.about_approach_label' | t }}</p>
      <h2>{{ 'boxeup_experience.about_approach_title' | t }}</h2>
      <p>{{ 'boxeup_experience.about_approach' | t }}</p>
    </div>
  </div>

  <div class="bx-about__categories bx-about__container">
    <div class="bx-about__categories-heading">
      <div><p class="bx-about__eyebrow">{{ 'boxeup_experience.about_categories' | t }}</p><h2>{{ 'boxeup_experience.about_categories_title' | t }}</h2></div>
      <a href="{{ routes.all_products_collection_url }}" class="bx-about__text-link">{{ 'boxeup_experience.catalog' | t }} <span aria-hidden="true">→</span></a>
    </div>
    <div class="bx-about__categories-grid">
      <a href="{{ collections['luvas-de-boxe-e-muay-thai'].url | default: routes.all_products_collection_url }}" class="bx-about__category">
        <img src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-boxe.jpg?v=1792197588" alt="{{ 'boxeup_experience.alt_gloves' | t | escape }}" width="1000" height="1000" loading="lazy">
        <span>{{ 'boxeup_experience.gloves' | t }} <span aria-hidden="true">→</span></span>
      </a>
      <a href="{{ collections['caneleiras-de-muay-thai-e-kickboxing'].url | default: routes.all_products_collection_url }}" class="bx-about__category">
        <img src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-muay-thai.jpg?v=1792197595" alt="{{ 'boxeup_experience.alt_shins' | t | escape }}" width="1000" height="1000" loading="lazy">
        <span>{{ 'boxeup_experience.shins' | t }} <span aria-hidden="true">→</span></span>
      </a>
      <a href="{{ collections['calcoes-e-roupa-de-combate'].url | default: routes.all_products_collection_url }}" class="bx-about__category">
        <img src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-mma.jpg?v=1792197601" alt="{{ 'boxeup_experience.alt_combat' | t | escape }}" width="1000" height="1000" loading="lazy">
        <span>{{ 'boxeup_experience.apparel' | t }} <span aria-hidden="true">→</span></span>
      </a>
      <a href="{{ collections['boqueiras-e-protecoes'].url | default: routes.all_products_collection_url }}" class="bx-about__category">
        <img src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-jiu-jitsu.jpg?v=1792197608" alt="{{ 'boxeup_experience.alt_protection' | t | escape }}" width="1000" height="1000" loading="lazy">
        <span>{{ 'boxeup_experience.protection' | t }} <span aria-hidden="true">→</span></span>
      </a>
      <a href="{{ collections['mochilas-e-sacos-de-treino-1'].url | default: routes.all_products_collection_url }}" class="bx-about__category">
        <img src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-comunidade.webp?v=1793121082" alt="{{ 'boxeup_experience.alt_gym' | t | escape }}" width="2048" height="682" loading="lazy">
        <span>{{ 'boxeup_experience.bags' | t }} <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </div>

  <div class="bx-about__contact">
    <img src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-comunidade.webp?v=1793121082" alt="" width="2048" height="682" loading="lazy">
    <div class="bx-about__contact-shade" aria-hidden="true"></div>
    <div class="bx-about__container bx-about__contact-inner">
      <p class="bx-about__eyebrow">{{ 'boxeup_experience.about_contact_label' | t }}</p>
      <h2>{{ 'boxeup_experience.about_contact_title' | t }}</h2>
      <p>{{ 'boxeup_experience.about_contact_text' | t }}</p>
      <a class="bx-about__button bx-about__button--white" href="{{ pages['contact'].url | default: '/pages/contact' }}">{{ 'boxeup_experience.contact' | t }} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
