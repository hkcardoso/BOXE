{% comment %}VIRIATTO — full-bleed dark background behind the centered category controls.{% endcomment %}
<style>
  #MainContent .shopify-section.section-boxeup-shop-categories,
  #MainContent .section-boxeup-shop-categories {
    background: #111214 !important;
  }
  #MainContent .section-boxeup-shop-categories > .boxeup-catalog-controls {
    background: #111214 !important;
  }
  #boxeup-catalog-filters { scroll-margin-top: 96px; }

  /* VIRIATTO | Third catalog filter, by combat discipline. */
  #boxeup-modalities-filter {scroll-margin-top:96px;margin:20px 0 0}
  #MainContent .boxeup-modalities-filter__heading{
    margin:0 0 12px;color:#e1e1e5;font-size:14px;line-height:1.4;font-weight:600;letter-spacing:0
  }
  #MainContent .boxeup-modalities-list{display:flex;flex-wrap:wrap;gap:9px}
  #MainContent .boxeup-modality-chip{
    min-height:41px;display:inline-flex;align-items:center;justify-content:center;gap:8px;
    padding:10px 18px;border-radius:5px;background:#1e1f23;border:1px solid #393b43;
    color:#f5f5f7!important;font-size:12px;font-weight:750;line-height:1.3;
    text-decoration:none;transition:border-color .18s,background .18s,transform .18s
  }
  #MainContent a.boxeup-modality-chip:hover{background:#27292f;border-color:#767984;transform:translateY(-1px)}
  #MainContent a.boxeup-modality-chip[aria-current="page"]{background:#292126;border-color:#ed2437;color:#fff!important}
  #MainContent a.boxeup-modality-chip:focus-visible{outline:2px solid white;outline-offset:2px}
  #MainContent .boxeup-modality-chip--coming{
    opacity:.46;cursor:not-allowed;user-select:none
  }
  #MainContent .boxeup-modality-chip--coming small{font-size:10px;font-weight:500}
  @media(max-width:749px){
    #boxeup-modalities-filter{margin-top:18px;scroll-margin-top:74px}
    #MainContent .boxeup-modalities-filter__heading{font-size:13px;margin-bottom:9px}
    #MainContent .boxeup-modalities-list{gap:7px}
    #MainContent .boxeup-modality-chip{min-height:38px;padding:9px 12px;font-size:11px}
  }
  @media(prefers-reduced-motion:reduce){
    #MainContent .boxeup-modality-chip{transition:none}
    #MainContent a.boxeup-modality-chip:hover{transform:none}
  }


  /* VIRIATTO | Always-visible brand logos on the collection navigation. */
  #MainContent .boxeup-brands-always-open { margin: 19px 0 0; }
  #MainContent .boxeup-brands-always-open__heading {
    color:#e1e1e5!important;
    font-size:14px;
    font-weight:600;
    line-height:1.4;
    margin:0 0 12px;
    letter-spacing:0;
  }
  #MainContent .boxeup-brand-grid {
    display:grid;
    grid-template-columns:repeat(8,minmax(0,1fr));
    gap:9px;
    margin:0;
  }
  /* Eight brand logos on one desktop row; adapt to narrower screens below. */
  @media (min-width: 990px) {
    body.boxeup-page-catalog #MainContent .boxeup-brand-grid {
      grid-template-columns: repeat(8, minmax(0, 1fr)) !important;
    }
  }
  #MainContent .boxeup-brand-card {
    display:flex;
    align-items:center;
    justify-content:center;
    min-width:0;
    min-height:77px;
    padding:11px 12px;
    border:1px solid #34363c;
    border-radius:6px;
    background:#191a1e;
    text-decoration:none;
    transition:background .18s ease,border-color .18s ease,transform .18s ease;
  }
  #MainContent .boxeup-brand-card:hover {
    background:#23252a;
    border-color:#666972;
    transform:translateY(-2px);
  }
  #MainContent .boxeup-brand-card[aria-current="page"] {
    border-color:#ed2437;
    background:#242025;
  }
  #MainContent .boxeup-brand-card:focus-visible {
    outline:2px solid #fff;
    outline-offset:2px;
  }
  #MainContent .boxeup-brand-card__logo {
    display:block;
    width:100%;
    max-width:115px;
    height:51px;
    object-fit:contain;
    object-position:center;
    background:transparent;
    /* Reproduce the monochrome white styling from the homepage. */
    filter:brightness(0) saturate(100%) invert(100%);
    opacity:.94;
  }
  #MainContent .boxeup-brand-card:hover .boxeup-brand-card__logo {opacity:1}
  @media(max-width:989px){
    #MainContent .boxeup-brand-grid {grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
  }
  @media(max-width:749px){
    #MainContent .boxeup-brands-always-open {margin-top:16px}
    #MainContent .boxeup-brands-always-open__heading {font-size:13px;margin-bottom:9px}
    #MainContent .boxeup-brand-grid {grid-template-columns:repeat(2,minmax(0,1fr))}
    #MainContent .boxeup-brand-card {min-height:62px;padding:9px 8px}
    #MainContent .boxeup-brand-card__logo {height:39px;max-width:96px}
  }
  @media(prefers-reduced-motion:reduce){
    #MainContent .boxeup-brand-card {transition:none}
    #MainContent .boxeup-brand-card:hover {transform:none}
  }

  #MainContent .boxeup-brand-grid {max-width:1440px;margin-inline:auto}
  #MainContent .viri-catalog-types {display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:8px;margin:20px 0 4px}
  #MainContent .viri-catalog-types__link {display:inline-flex;align-items:center;min-height:38px;padding:8px 13px;text-decoration:none;color:#e4e5e8;border:1px solid #34363c;border-radius:5px;background:#191a1e;font-size:12px;font-weight:650;white-space:nowrap;transition:background .15s,border-color .15s}
  #MainContent .viri-catalog-types__link:hover {background:#24262b;border-color:#737680;color:#fff}
  #MainContent .viri-catalog-types__link[aria-current="page"] {border-color:#ed2437;background:#242025;color:#fff}
  #MainContent .viri-catalog-types__link:focus-visible {outline:2px solid #fff;outline-offset:2px}
  @media(max-width:749px){#MainContent .viri-catalog-types {justify-content:flex-start;flex-wrap:nowrap;overflow-x:auto;padding:2px 0 10px;scrollbar-width:thin}}
</style>
<section id="boxeup-catalog-filters" class="boxeup-catalog-controls page-width" aria-label="{{ 'boxeup_navigation.categories' | t }}">
  <div class="boxeup-brands-always-open">
    <nav class="boxeup-brand-grid" aria-label="{{ 'boxeup_navigation.brands' | t }}">
      <a class="boxeup-brand-card" data-boxeup-catalog href="{{ collections['viriatto'].url | default: '/collections/viriatto' }}" aria-label="VIRIATTO"{% if collection.handle == 'viriatto' %} aria-current="page"{% endif %}><img class="boxeup-brand-card__logo" src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/viriatto-logo-original-transparente.png?v=1793188281" alt="VIRIATTO" loading="lazy" width="140" height="72"></a>
      <a class="boxeup-brand-card" data-boxeup-catalog href="{{ collections['charlie'].url | default: '/collections/charlie' }}" aria-label="Charlie"{% if collection.handle == 'charlie' %} aria-current="page"{% endif %}><img class="boxeup-brand-card__logo" src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-charlie-white.png?v=1793040801" alt="Charlie" loading="lazy" width="140" height="72"></a>
      <a class="boxeup-brand-card" data-boxeup-catalog href="{{ collections['fairtex'].url | default: '/collections/fairtex' }}" aria-label="Fairtex"{% if collection.handle == 'fairtex' %} aria-current="page"{% endif %}><img class="boxeup-brand-card__logo" src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-fairtex-white.png?v=1793040787" alt="Fairtex" loading="lazy" width="140" height="72"></a>
      <a class="boxeup-brand-card" data-boxeup-catalog href="{{ collections['venum'].url | default: '/collections/venum' }}" aria-label="Venum"{% if collection.handle == 'venum' %} aria-current="page"{% endif %}><img class="boxeup-brand-card__logo" src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-venum-white.png?v=1793040818" alt="Venum" loading="lazy" width="140" height="72"></a>
      <a class="boxeup-brand-card" data-boxeup-catalog href="{{ collections['cleto-reyes'].url | default: '/collections/cleto-reyes' }}" aria-label="Cleto Reyes"{% if collection.handle == 'cleto-reyes' %} aria-current="page"{% endif %}><img class="boxeup-brand-card__logo" src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-reyes-white.png?v=1793040826" alt="Cleto Reyes" loading="lazy" width="140" height="72"></a>
      <a class="boxeup-brand-card" data-boxeup-catalog href="{{ collections['rival'].url | default: '/collections/rival' }}" aria-label="Rival"{% if collection.handle == 'rival' %} aria-current="page"{% endif %}><img class="boxeup-brand-card__logo" src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-rival-white.png?v=1793040835" alt="Rival" loading="lazy" width="140" height="72"></a>
      <a class="boxeup-brand-card" data-boxeup-catalog href="{{ collections['twins'].url | default: '/collections/twins' }}" aria-label="Twins"{% if collection.handle == 'twins' %} aria-current="page"{% endif %}><img class="boxeup-brand-card__logo" src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-twins-white.png?v=1793040843" alt="Twins" loading="lazy" width="140" height="72"></a>
      <a class="boxeup-brand-card" data-boxeup-catalog href="{{ collections['everlast'].url | default: '/collections/everlast' }}" aria-label="Everlast"{% if collection.handle == 'everlast' %} aria-current="page"{% endif %}><img class="boxeup-brand-card__logo" src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-everlast-white.png?v=1793040849" alt="Everlast" loading="lazy" width="140" height="72"></a>
    </nav>
    {%- liquid
      assign viri_catalog_lang = request.locale.iso_code | slice: 0, 2
      assign viri_catalog_handles = 'luvas-de-boxe-e-muay-thai,caneleiras-de-muay-thai-e-kickboxing,capacetes-de-boxe,boqueiras-e-protecoes,calcoes-de-combate,roupa-e-fightwear,mochilas-e-sacos-de-treino-1,equipamento-de-treino' | split: ','
      assign viri_catalog_labels = 'Luvas,Caneleiras,Capacetes,Boqueiras e proteções,Calções,Roupa,Mochilas e sacos,Equipamento de treino' | split: ','
      if viri_catalog_lang == 'en'
        assign viri_catalog_labels = 'Gloves,Shin guards,Headguards,Mouthguards and protection,Shorts,Clothing,Bags and backpacks,Training equipment' | split: ','
      elsif viri_catalog_lang == 'es'
        assign viri_catalog_labels = 'Guantes,Espinilleras,Cascos,Bucales y protecciones,Pantalones cortos,Ropa,Bolsas y mochilas,Equipamiento de entrenamiento' | split: ','
      endif
    -%}
    <nav class="viri-catalog-types" aria-label="{{ 'boxeup_navigation.categories' | t }}">
      {%- for viri_handle in viri_catalog_handles -%}
        {%- assign viri_category = collections[viri_handle] -%}
        {%- if viri_category != blank -%}
          <a class="viri-catalog-types__link" href="{{ viri_category.url }}"{% if collection.handle == viri_handle %} aria-current="page"{% endif %}>{{ viri_catalog_labels[forloop.index0] | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>
  </div>
  <p class="boxeup-catalog-message" role="status" aria-live="polite" data-loading="{{ 'boxeup_navigation.loading' | t }}" data-loaded="{{ 'boxeup_navigation.loaded' | t }}" data-error="{{ 'boxeup_navigation.error' | t }}"></p>
</section>
{% schema %}
{"name":"VIRIATTO | Categorias","tag":"section","class":"section-boxeup-shop-categories","settings":[],"presets":[{"name":"VIRIATTO | Categorias"}]}
{% endschema %}

