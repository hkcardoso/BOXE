<section class="boxeup-contact bx-contact" aria-labelledby="BxContactTitle">
  <div class="bx-contact__hero">
    {% if section.settings.hero_image != blank %}
      {{ section.settings.hero_image | image_url: width: 2200 | image_tag: class: 'bx-contact__hero-image', loading: 'eager', sizes: '100vw', alt: '' }}
    {% else %}
      <img class="bx-contact__hero-image" src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-disciplina-banner.jpg?v=1793120726" alt="" width="2172" height="724" fetchpriority="high">
    {% endif %}
    <div class="bx-contact__hero-overlay" aria-hidden="true"></div>
    <div class="bx-contact__wrap bx-contact__hero-inner">
      <nav class="bx-contact__breadcrumb" aria-label="{{ 'boxeup_sections.aria_breadcrumb' | t }}">
        <a href="{{ routes.root_url }}">{{ 'boxeup_sections.contact_home' | t }}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ 'boxeup_sections.contact_contact' | t }}</span>
      </nav>
      <div class="bx-contact__headline">
        <p class="bx-contact__eyebrow">{{ bx_hero_tagline }}</p>
        <h1 id="BxContactTitle">{{ bx_hero_title | remove: '.' }}<span aria-hidden="true">.</span></h1>
        <p class="bx-contact__hero-description">{{ bx_hero_description }}</p>
      </div>
    </div>
  </div>

  <div class="bx-contact__wrap bx-contact__body">
    <div class="bx-contact__grid">
      <aside class="bx-contact__sidebar" aria-label="{{ bx_support }}">
        <div class="bx-contact__quicklinks">
          <button type="button" class="bx-contact__quicklink" data-bx-contact-subject="produto">
            <span class="bx-contact__quicklink-icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18v-3a10 10 0 0 1 20 0v3"/><rect x="3" y="16" width="6" height="10" rx="2"/><rect x="23" y="16" width="6" height="10" rx="2"/><path d="M26 26c0 3-3 4-10 4h-3"/></svg>
            </span>
            <span class="bx-contact__quicklink-copy"><strong>{{ bx_support }}</strong><small>{{ bx_support_desc }}</small></span>
            <span class="bx-contact__quicklink-arrow" aria-hidden="true">→</span>
          </button>
          <button type="button" class="bx-contact__quicklink" data-bx-contact-subject="encomenda">
            <span class="bx-contact__quicklink-icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m4 10 12-6 12 6v13l-12 6-12-6V10Z"/><path d="m4 10 12 7 12-7M16 17v12M10 7l12 7"/></svg>
            </span>
            <span class="bx-contact__quicklink-copy"><strong>{{ bx_orders }}</strong><small>{{ bx_orders_desc }}</small></span>
            <span class="bx-contact__quicklink-arrow" aria-hidden="true">→</span>
          </button>
          <button type="button" class="bx-contact__quicklink" data-bx-contact-subject="parceria">
            <span class="bx-contact__quicklink-icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 12 7-6 7 4 5-4 7 6-6 9-7 7-7-7-6-9Z"/><path d="m11 17 5 5 4-4M7 16l5 9m14-9-5 9"/></svg>
            </span>
            <span class="bx-contact__quicklink-copy"><strong>{{ bx_partners }}</strong><small>{{ bx_partners_desc }}</small></span>
            <span class="bx-contact__quicklink-arrow" aria-hidden="true">→</span>
          </button>
        </div>

        <div class="bx-contact__faq">
          <p class="bx-contact__eyebrow">{{ bx_faq }}</p>
          <details class="bx-contact__faq-item">
            <summary><span class="bx-contact__faq-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="2" y="5" width="13" height="12" rx="1"/><path d="M15 9h4l3 4v4h-7M5 19h2m9 0h2"/><circle cx="9" cy="18" r="2"/><circle cx="19" cy="18" r="2"/></svg></span>{{ bx_faq_shipping }}<span class="bx-contact__faq-chevron" aria-hidden="true">⌄</span></summary>
            <div class="bx-contact__faq-answer"><p>{{ bx_faq_shipping_text }}</p><a href="{{ pages['envios-e-entregas'].url | default: '/pages/envios-e-entregas' }}">{{ 'boxeup_experience.shipping' | t }} →</a></div>
          </details>
          <details class="bx-contact__faq-item">
            <summary><span class="bx-contact__faq-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20 8a8 8 0 0 0-14-2L3 9M3 4v5h5M4 16a8 8 0 0 0 14 2l3-3m0 5v-5h-5"/></svg></span>{{ bx_faq_returns }}<span class="bx-contact__faq-chevron" aria-hidden="true">⌄</span></summary>
            <div class="bx-contact__faq-answer"><p>{{ bx_faq_returns_text }}</p><a href="{{ pages['devolucoes-e-garantias'].url | default: '/pages/devolucoes-e-garantias' }}">{{ 'boxeup_experience.returns' | t }} →</a></div>
          </details>
          <details class="bx-contact__faq-item">
            <summary><span class="bx-contact__faq-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 20 20 4M7 7l10 10M4 13l2 2m3-11 2 2m3 13 2 2M18 7l2 2"/></svg></span>{{ bx_faq_sizes }}<span class="bx-contact__faq-chevron" aria-hidden="true">⌄</span></summary>
            <div class="bx-contact__faq-answer"><p>{{ bx_faq_sizes_text }}</p><button type="button" data-bx-contact-subject="produto">{{ 'boxeup_experience.contact' | t }} →</button></div>
          </details>
          <details class="bx-contact__faq-item">
            <summary><span class="bx-contact__faq-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h5"/></svg></span>{{ bx_faq_payments }}<span class="bx-contact__faq-chevron" aria-hidden="true">⌄</span></summary>
            <div class="bx-contact__faq-answer"><p>{{ bx_faq_payments_text }}</p></div>
          </details>
          <button class="bx-contact__faq-all" type="button" data-bx-contact-subject="produto">{{ bx_faq_all }} <span aria-hidden="true">→</span></button>
        </div>
      </aside>

      <div class="boxeup-contact__form-wrap bx-contact__form-panel" id="BxContactFormPanel">
        <p class="bx-contact__eyebrow">{{ bx_form_tagline }}</p>
        <h2>{{ bx_form_title }}</h2>
        <p class="bx-contact__form-intro">{{ bx_form_intro }}</p>
        {% form 'contact', id: 'BoxeupContactForm', class: 'bx-contact__form' %}
          {% if form.posted_successfully? %}
            <div class="bx-contact__feedback bx-contact__feedback--success" role="status" tabindex="-1">
              <strong>{{ 'boxeup_sections.contact_sent' | t }}</strong>
              <p>{{ 'boxeup_sections.contact_received' | t }}</p>
            </div>
          {% endif %}
          {% if form.errors %}
            <div class="bx-contact__feedback bx-contact__feedback--error" role="alert" tabindex="-1">
              <strong>{{ 'boxeup_sections.contact_error' | t }}</strong>
              {{ form.errors | default_errors }}
            </div>
          {% endif %}
          <div class="bx-contact__fields">
            <div class="bx-contact__field">
              <label for="BoxeupContactName">{{ 'boxeup_sections.contact_name' | t }} <span>*</span></label>
              <input id="BoxeupContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" placeholder="{{ 'boxeup_sections.contact_your_name' | t }}" required>
            </div>
            <div class="bx-contact__field">
              <label for="BoxeupContactEmail">{{ 'boxeup_sections.contact_email' | t }} <span>*</span></label>
              <input id="BoxeupContactEmail" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" value="{{ form.email | escape }}" placeholder="exemplo@email.com" {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="BxContactEmailError"{% endif %} required>
              {% if form.errors contains 'email' %}<small id="BxContactEmailError">{{ 'boxeup_sections.contact_email_error' | t }}</small>{% endif %}
            </div>
            <div class="bx-contact__field bx-contact__field--wide">
              <label for="BoxeupContactSubject">{{ 'boxeup_experience.contact_subject' | t }} <span>*</span></label>
              <select id="BoxeupContactSubject" name="contact[assunto]" required>
                <option value="" disabled {% if form.assunto == blank %}selected{% endif %}>{{ 'boxeup_experience.subject_placeholder' | t }}</option>
                {% assign bx_subjects = 'produto,encomenda,devolucao,parceria' | split: ',' %}
                {% for value in bx_subjects %}
                  {% assign bx_subject_key = 'boxeup_experience.subject_' | append: value %}
                  <option value="{{ value }}" {% if form.assunto == value %}selected{% endif %}>{{ bx_subject_key | t }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="bx-contact__field bx-contact__field--wide">
              <label for="BoxeupContactBody">{{ 'boxeup_sections.contact_message' | t }} <span>*</span></label>
              <textarea id="BoxeupContactBody" name="contact[body]" rows="5" maxlength="1000" placeholder="{{ 'boxeup_sections.contact_message_help' | t }}" required>{{ form.body | escape }}</textarea>
              <output class="bx-contact__counter" for="BoxeupContactBody" aria-live="off"><span data-bx-contact-count>0</span> / 1000</output>
            </div>
          </div>
          <button type="submit" class="bx-contact__submit">{{ 'boxeup_sections.contact_send_message' | t }} <span aria-hidden="true">→</span></button>
          <p class="bx-contact__form-note">{{ 'boxeup_sections.contact_required' | t }}
            {% if shop.privacy_policy != blank %} · <a href="{{ shop.privacy_policy.url }}">{{ 'boxeup_sections.contact_policy' | t }}</a>{% endif %}
          </p>
        {% endform %}
      </div>
    </div>
  </div>

  <div class="bx-contact__benefits">
    <div class="bx-contact__wrap bx-contact__benefits-grid">
      <div class="bx-contact__benefit"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><path d="m18 2-12 17h9l-2 11 13-18h-9l1-10Z"/></svg><span><strong>{{ bx_reply }}</strong><small>{{ bx_reply_desc }}</small></span></div>
      <div class="bx-contact__benefit"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><path d="m16 2 12 5v9c0 7-5 11-12 14C9 27 4 23 4 16V7L16 2Z"/><path d="m11 16 3 3 7-7"/></svg><span><strong>{{ bx_help }}</strong><small>{{ bx_help_desc }}</small></span></div>
      <div class="bx-contact__benefit"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><path d="m4 14 8-7 5 4 5-4 6 7-7 12-5-4-5 4L4 14Z"/><path d="m12 16 4 4 5-5"/></svg><span><strong>{{ bx_collab }}</strong><small>{{ bx_collab_desc }}</small></span></div>
      <div class="bx-contact__benefit"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="14" width="20" height="16" rx="2"/><path d="M10 14v-5a6 6 0 1 1 12 0v5"/></svg><span><strong>{{ bx_secure }}</strong><small>{{ bx_secure_desc }}</small></span></div>
    </div>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector('.bx-contact');
    if (!root) return;
    const subject = root.querySelector('#BoxeupContactSubject');
    const panel = root.querySelector('#BxContactFormPanel');
    root.querySelectorAll('[data-bx-contact-subject]').forEach(button => {
      button.addEventListener('click', () => {
        if (!subject || !panel) return;
        subject.value = button.dataset.bxContactSubject;
        panel.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
        subject.focus({ preventScroll: true });
      });
    });
    const message = root.querySelector('#BoxeupContactBody');
    const count = root.querySelector('[data-bx-contact-count]');
    if (message && count) {
      const updateCount = () => { count.textContent = message.value.length; };
      message.addEventListener('input', updateCount);
      updateCount();
    }
  })();
</script>

{% schema %}
{
  "name": "BOXEUP | Contacto",
  "tag": "section",
  "class": "section-boxeup-contact",
  "settings": [
    {"type": "image_picker", "id": "hero_image", "label": "Imagem do hero"},
    {"type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "ESTAMOS AQUI PARA AJUDAR"},
    {"type": "text", "id": "heading", "label": "Título principal", "default": "Fala connosco."},
    {"type": "textarea", "id": "description", "label": "Introdução", "default": "Precisas de ajuda a escolher equipamento, tens uma dúvida sobre um produto ou queres apresentar uma proposta de parceria? Envia-nos uma mensagem."},
    {"type": "text", "id": "form_heading", "label": "Título do formulário", "default": "Envia-nos uma mensagem"},
    {"type": "textarea", "id": "form_intro", "label": "Introdução ao formulário", "default": "Preenche os campos abaixo para entrar em contacto com a BOXEUP."}
  ],
  "presets": [{"name": "BOXEUP | Contacto"}]
}
{% endschema %}