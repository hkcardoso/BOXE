{%- comment -%}
  BoxeUp flag-based language selector. Uses native Shopify localization form and
  lists only the languages available in the current market.
  Expected localPosition: unique header/footer localization form prefix.
{%- endcomment -%}
{%- assign bxp_current_locale_code = localization.language.iso_code | slice: 0, 2 | upcase -%}
<div class="disclosure boxeup-language-disclosure" data-boxeup-language-picker="flags-v1">
  <button
    type="button"
    class="disclosure__button localization-form__select localization-selector link link--text caption-large boxeup-lang-trigger"
    aria-label="{{ 'localization.language_label' | t }}: {{ localization.language.endonym_name | escape }}"
    aria-expanded="false"
    aria-controls="{{ localPosition }}List"
    aria-describedby="{{ localPosition }}Label"
  >
    <span class="boxeup-lang-flag">{% render 'boxeup-language-flag', language_code: localization.language.iso_code %}</span>
    <span class="boxeup-lang-code">{{ bxp_current_locale_code }}</span>
  </button>
  <div class="disclosure__list-wrapper language-selector boxeup-lang-panel" hidden>
    <ul id="{{ localPosition }}List" role="list" class="disclosure__list list-unstyled boxeup-lang-list">
      {%- for language in localization.available_languages -%}
        {%- assign bxp_option_locale_code = language.iso_code | slice: 0, 2 | upcase -%}
        {%- unless language.iso_code == localization.language.iso_code -%}
          <li class="disclosure__item" tabindex="-1">
            <a
              class="link link--text disclosure__link caption-large focus-inset boxeup-lang-option"
              href="#"
              hreflang="{{ language.iso_code }}"
              lang="{{ language.iso_code }}"
              title="{{ language.endonym_name | escape }}"
              data-value="{{ language.iso_code }}"
            >
              <span class="boxeup-lang-flag">{% render 'boxeup-language-flag', language_code: language.iso_code %}</span>
              <span class="boxeup-lang-code">{{ bxp_option_locale_code }}</span>
            </a>
          </li>
        {%- endunless -%}
      {%- endfor -%}
    </ul>
  </div>
  {%- if localPosition == 'FooterLanguage' -%}
    {%- comment -%}
      Mobile footer: show every available language in one stable row instead of
      a floating popover that separates the selected language from the options.
      The existing localization-form JS handles clicks on these links.
    {%- endcomment -%}
    <div class="boxeup-lang-mobile" role="group" aria-label="{{ 'localization.language_label' | t | escape }}">
      {%- for language in localization.available_languages -%}
        {%- assign bxp_mobile_locale_code = language.iso_code | slice: 0, 2 | upcase -%}
        {%- if language.iso_code == localization.language.iso_code -%}
          <span class="boxeup-lang-mobile__option is-current" lang="{{ language.iso_code }}" aria-current="true" title="{{ language.endonym_name | escape }}">
            <span class="boxeup-lang-flag">{% render 'boxeup-language-flag', language_code: language.iso_code %}</span>
            <span class="boxeup-lang-code">{{ bxp_mobile_locale_code }}</span>
          </span>
        {%- else -%}
          <a class="boxeup-lang-mobile__option link focus-inset"
             href="#"
             hreflang="{{ language.iso_code }}"
             lang="{{ language.iso_code }}"
             title="{{ language.endonym_name | escape }}"
             aria-label="{{ language.endonym_name | escape }}"
             data-value="{{ language.iso_code }}">
            <span class="boxeup-lang-flag">{% render 'boxeup-language-flag', language_code: language.iso_code %}</span>
            <span class="boxeup-lang-code">{{ bxp_mobile_locale_code }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
<input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}">
