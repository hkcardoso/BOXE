  "viriatto_product_copy": {
    "charlie-bat-x-luvas-de-treino": {
      "intro": "Natural buffalo leather, a wide hook-and-loop strap and classic Charlie identity. The Bat-X is designed for boxing, Muay Thai and kickboxing training.",
      "description": "The Charlie Bat-X combines 100% natural buffalo leather with a wide hook-and-loop wrist strap. The closure offers a practical way to adjust the gloves between exercises.||Designed for regular boxing, Muay Thai and kickboxing training, this model features the Charlie wrist logo and embossed Bat-X details. Check the variant photographs for its colour and finish.",
      "features": "100% natural buffalo leather|Wide hook-and-loop wrist strap|Embossed Charlie and Bat-X details|For boxing, Muay Thai and kickboxing training",
      "fit": "Ounces describe the weight of a glove, not its hand size. Choose according to your body weight, training session and coach’s advice. Check the fit with hand wraps; for sparring, confirm your gym’s required glove weight.",
      "care": "Wipe the outside with a slightly damp cloth after training and leave the gloves open in a ventilated place. Avoid machine washing, direct heat and sunlight. Store only when dry.",
      "technical": "Material::100% natural buffalo leather||Closure::Wide hook-and-loop strap||Sports::Boxing, Muay Thai and kickboxing",
      "benefits": "layers::Natural buffalo leather::The Bat-X is built from 100% natural buffalo leather. Leave the gloves open after each session so the inside can dry before storage.||adjust::Wide wrist strap::The wide hook-and-loop strap lets you adjust the fit and remove the gloves between exercises. Check the fit with your usual hand wraps.||target::For different training sessions::Boxing, Muay Thai or kickboxing: choose the glove weight for the planned session. Always confirm the required weight with your coach before sparring."
    },
    "charlie-gel-metallic-luvas-de-boxe": {
      "intro": "Charlie boxing gloves in buffalo leather, with a Navy Blue metallic finish and hook-and-loop closure.",
