{% comment %}
  VIRIATTO | Full cart page (Multilingue PT EN ES)
  Uses native Shopify Liquid cart totals and checkout form.
{% endcomment %}
{% liquid
  assign bx_lang = request.locale.iso_code | slice: 0, 2
  case bx_lang
    when 'en'
      assign bx_items = 'items'
      assign bx_remove = 'Remove'
      assign bx_coupon_heading = 'Promotional code'
      assign bx_coupon_info = 'Enter your code. Its validity and the final discount are confirmed at checkout.'
      assign bx_coupon_placeholder = 'Discount code'
      assign bx_coupon_apply = 'Apply'
      assign bx_delivery_heading = 'Delivery'
      assign bx_delivery_text = 'Delivery methods, charges and estimated times are shown at checkout for your address.'
      assign bx_summary_heading = 'Summary'
      assign bx_subtotal = 'Subtotal'
      assign bx_discount = 'Discounts'
      assign bx_shipping = 'Shipping'
      assign bx_shipping_value = 'Calculated at checkout'
      assign bx_total = 'Total'
      assign bx_checkout = 'Checkout'
      assign bx_continue = 'Continue shopping'
      assign bx_empty_title = 'Your cart is empty'
      assign bx_empty_desc = 'Browse the catalogue and find equipment for your next training session.'
      assign bx_help = 'Final shipping charges and taxes, where applicable, are confirmed at checkout.'
      assign bx_error = 'Your cart could not be updated. Please try again.'
      assign bx_qminus = 'Decrease quantity'
      assign bx_qplus = 'Increase quantity'
    when 'es'
      assign bx_items = 'artículos'
      assign bx_remove = 'Eliminar'
      assign bx_coupon_heading = 'Código promocional'
      assign bx_coupon_info = 'Introduce tu código. La validez y el descuento final se confirman al pagar.'
      assign bx_coupon_placeholder = 'Código de descuento'
      assign bx_coupon_apply = 'Aplicar'
      assign bx_delivery_heading = 'Entrega'
      assign bx_delivery_text = 'Los métodos, gastos y plazos de envío se indican al pagar, según tu dirección.'
      assign bx_summary_heading = 'Resumen'
      assign bx_subtotal = 'Subtotal'
      assign bx_discount = 'Descuentos'
      assign bx_shipping = 'Envío'
      assign bx_shipping_value = 'Calculado al pagar'
      assign bx_total = 'Total'
      assign bx_checkout = 'Finalizar compra'
      assign bx_continue = 'Seguir comprando'
      assign bx_empty_title = 'Tu carrito está vacío'
      assign bx_empty_desc = 'Explora el catálogo y encuentra el equipamiento para tu próximo entrenamiento.'
      assign bx_help = 'Los gastos de envío y los impuestos aplicables se confirman al pagar.'
      assign bx_error = 'No se ha podido actualizar el carrito. Vuelve a intentarlo.'
      assign bx_qminus = 'Reducir cantidad'
      assign bx_qplus = 'Aumentar cantidad'
    else
      assign bx_items = 'artigos'
      assign bx_remove = 'Remover'
      assign bx_coupon_heading = 'Códigos promocionais'
      assign bx_coupon_info = 'Introduz o teu código. A validade e o desconto final são confirmados no checkout.'
      assign bx_coupon_placeholder = 'Código promocional'
      assign bx_coupon_apply = 'Aplicar'
      assign bx_delivery_heading = 'Entrega'
      assign bx_delivery_text = 'Os métodos, portes e prazos de entrega são apresentados no checkout, conforme a tua morada.'
      assign bx_summary_heading = 'Resumo'
      assign bx_subtotal = 'Subtotal'
      assign bx_discount = 'Descontos'
      assign bx_shipping = 'Envio'
      assign bx_shipping_value = 'Calculado no checkout'
      assign bx_total = 'Total'
      assign bx_checkout = 'Finalizar a compra'
      assign bx_continue = 'Continuar a comprar'
      assign bx_empty_title = 'O teu carrinho está vazio'
      assign bx_empty_desc = 'Explora o catálogo e encontra o equipamento para o teu próximo treino.'
      assign bx_help = 'Os portes e os impostos aplicáveis são confirmados no checkout.'
      assign bx_error = 'Não foi possível atualizar o carrinho. Tenta novamente.'
      assign bx_qminus = 'Reduzir quantidade'
      assign bx_qplus = 'Aumentar quantidade'
  endcase
%}
<section class="bx-cart-page" data-bx-cart-page data-bx-cart-url="{{ routes.cart_url }}" data-bx-error="{{ bx_error | escape }}" aria-labelledby="BxCartPageTitle">
  <div class="bx-cart-page__wrap">
    <header class="bx-cart-page__header">
      <h1 id="BxCartPageTitle">{{ 'sections.cart.title' | t }}</h1>
      <p>{{ cart.item_count }} {{ bx_items }}</p>
    </header>
    {% if cart.item_count > 0 %}
      <div class="bx-cart-page__layout">
        <div class="bx-cart-page__main">
          {% for item in cart.items %}
            <article class="bx-cart-page__line" data-bx-cart-line="{{ forloop.index }}" data-bx-cart-quantity="{{ item.quantity }}">
              <a class="bx-cart-page__photo" href="{{ item.url }}">
                {% if item.image %}
                  <img src="{{ item.image | image_url: width: 360 }}" alt="{{ item.image.alt | default: item.product.title | escape }}" width="190" height="{{ 190 | divided_by: item.image.aspect_ratio | ceil }}" loading="lazy">
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </a>
              <div class="bx-cart-page__line-content">
                <a class="bx-cart-page__product-name" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                {% unless item.variant.title == 'Default Title' or item.variant.title == blank %}
                  <span class="bx-cart-page__variant">{{ item.variant.title | escape }}</span>
                {% endunless %}
                {% for property in item.properties %}
                  {% assign first_char = property.first | slice: 0 %}
                  {% unless property.last == blank or first_char == '_' %}
                    <span class="bx-cart-page__variant">{{ property.first | escape }}: {{ property.last | escape }}</span>
                  {% endunless %}
                {% endfor %}
                <div class="bx-cart-page__line-footer">
                  <div class="bx-cart-page__qty">
                    <button type="button" data-bx-cart-delta="-1" aria-label="{{ bx_qminus }}" {% if item.quantity <= 1 %}disabled{% endif %}>−</button>
                    <span aria-label="{{ item.quantity }}">{{ item.quantity }}</span>
                    <button type="button" data-bx-cart-delta="1" aria-label="{{ bx_qplus }}">+</button>
                  </div>
                  <button class="bx-cart-page__remove" type="button" data-bx-cart-remove>{{ bx_remove }}</button>
                  <span class="bx-cart-page__price">
                    {% if item.original_line_price > item.final_line_price %}
                      <s class="bx-cart-page__old-price">{{ item.original_line_price | money }}</s>
                    {% endif %}
                    {{ item.final_line_price | money_with_currency }}
                  </span>
                </div>
              </div>
            </article>
          {% endfor %}
          <div class="bx-cart-page__card">
            <h2>{{ bx_coupon_heading }}</h2>
            <p>{{ bx_coupon_info }}</p>
            <form data-bx-discount-form class="bx-cart-page__code-row">
              <label class="visually-hidden" for="BxCartPromo">{{ bx_coupon_placeholder }}</label>
              <input id="BxCartPromo" type="text" name="discount" autocomplete="off" placeholder="{{ bx_coupon_placeholder }}" maxlength="80">
              <button type="submit">{{ bx_coupon_apply }}</button>
            </form>
          </div>
          <a class="bx-cart-page__continue" href="{{ routes.all_products_collection_url }}">{{ bx_continue }} {% render 'viri-arrow-icon' %}</a>
        </div>
        <aside class="bx-cart-page__aside">
          <div class="bx-cart-page__card">
            <h2>{{ bx_delivery_heading }}</h2>
            <div class="bx-cart-page__delivery">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2"/></svg>
              <p>{{ bx_delivery_text }}</p>
            </div>
          </div>
          <div class="bx-cart-page__card">
            <h2>{{ bx_summary_heading }}</h2>
            <div class="bx-cart-page__summary-row"><span>{{ bx_subtotal }}</span><strong>{{ cart.items_subtotal_price | money_with_currency }}</strong></div>
            {% if cart.total_discount > 0 %}
              <div class="bx-cart-page__summary-row"><span>{{ bx_discount }}</span><strong>-{{ cart.total_discount | money_with_currency }}</strong></div>
            {% endif %}
            <div class="bx-cart-page__summary-row"><span>{{ bx_shipping }}</span><strong>{{ bx_shipping_value }}</strong></div>
            <div class="bx-cart-page__summary-total"><span>{{ bx_total }}</span><strong>{{ cart.total_price | money_with_currency }}</strong></div>
          </div>
          <div class="bx-cart-page__checkout-wrap">
            <form action="{{ routes.cart_url }}" method="post" id="BxCartCheckoutForm">
              <button class="bx-cart-page__checkout" type="submit" name="checkout">{{ bx_checkout }}</button>
            </form>
            <p class="bx-cart-page__footer-note">{{ bx_help }}</p>
          </div>
        </aside>
      </div>
    {% else %}
      <div class="bx-cart-page__empty">
        <h2>{{ bx_empty_title }}</h2>
        <p>{{ bx_empty_desc }}</p>
        <a href="{{ routes.all_products_collection_url }}">{{ bx_continue }} {% render 'viri-arrow-icon' %}</a>
      </div>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "VIRIATTO | Carrinho",
  "tag": "section",
  "class": "section-boxeup-cart-page",
  "settings": [],
  "presets": [{"name": "VIRIATTO | Carrinho"}]
}
{% endschema %}
