{{ 'boxeup-contact-v2.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign bx_lang = request.locale.iso_code | slice: 0, 2
  case bx_lang
    when 'en'
      assign bx_contact_tag = 'CONTACT'
      assign bx_contact_heading = 'TALK TO US.'
      assign bx_contact_intro = 'Need help with a product, an order or a partnership? Send us a message.'
      assign bx_contact_email_label = 'DIRECT CONTACT'
      assign bx_contact_links_label = 'USEFUL LINKS'
      assign bx_contact_shipping = 'Shipping and delivery'
      assign bx_contact_returns = 'Returns and warranty'
      assign bx_contact_form_title = 'TELL US WHAT YOU NEED.'
      assign bx_contact_form_intro = 'Fill in the form and we will get back to you as soon as possible.'
      assign bx_contact_send = 'Send message'
      assign bx_contact_required = 'Required fields'
      assign bx_contact_placeholder_email = 'you@example.com'
      assign bx_contact_count = 'characters'
    when 'es'
      assign bx_contact_tag = 'CONTACTO'
      assign bx_contact_heading = 'HABLEMOS.'
      assign bx_contact_intro = '¿Tienes dudas sobre un producto, un pedido o una colaboración? Envíanos un mensaje.'
      assign bx_contact_email_label = 'CONTACTO DIRECTO'
      assign bx_contact_links_label = 'ENLACES ÚTILES'
      assign bx_contact_shipping = 'Envíos y entregas'
      assign bx_contact_returns = 'Devoluciones y garantías'
      assign bx_contact_form_title = 'CUÉNTANOS QUÉ NECESITAS.'
      assign bx_contact_form_intro = 'Completa el formulario y responderemos lo antes posible.'
      assign bx_contact_send = 'Enviar mensaje'
      assign bx_contact_required = 'Campos obligatorios'
      assign bx_contact_placeholder_email = 'ejemplo@email.com'
      assign bx_contact_count = 'caracteres'
    else
      assign bx_contact_tag = 'CONTACTOS'
      assign bx_contact_heading = 'FALA CONNOSCO.'
      assign bx_contact_intro = 'Dúvidas sobre produtos, encomendas ou parcerias? Envia-nos uma mensagem.'
      assign bx_contact_email_label = 'CONTACTO DIRETO'
      assign bx_contact_links_label = 'INFORMAÇÕES ÚTEIS'
      assign bx_contact_shipping = 'Envios e entregas'
      assign bx_contact_returns = 'Devoluções e garantias'
      assign bx_contact_form_title = 'DIZ-NOS O QUE PRECISAS.'
      assign bx_contact_form_intro = 'Preenche o formulário e responderemos assim que possível.'
      assign bx_contact_send = 'Enviar mensagem'
      assign bx_contact_required = 'Campos obrigatórios'
      assign bx_contact_placeholder_email = 'exemplo@email.com'
      assign bx_contact_count = 'caracteres'
  endcase
-%}
<section class="viri-contact" aria-labelledby="ViriContactTitle">
  <div class="viri-contact__container">
    <div class="viri-contact__grid">
      <aside class="viri-contact__intro">
        <p class="viri-contact__eyebrow">{{ bx_contact_tag | escape }}</p>
        <h1 id="ViriContactTitle">{{ bx_contact_heading | escape }}</h1>
        <p class="viri-contact__lead">{{ bx_contact_intro | escape }}</p>
        <div class="viri-contact__details">
          <div class="viri-contact__detail">
            <p class="viri-contact__detail-title">{{ bx_contact_email_label | escape }}</p>
            <a href="mailto:business@boxeup.com">business@boxeup.com <span aria-hidden="true">↗</span></a>
          </div>
          <div class="viri-contact__detail">
            <p class="viri-contact__detail-title">{{ bx_contact_links_label | escape }}</p>
            <a href="{{ pages['envios-e-entregas'].url | default: '/pages/envios-e-entregas' }}">{{ bx_contact_shipping | escape }} <span aria-hidden="true">↗</span></a>
            <a href="{{ pages['devolucoes-e-garantias'].url | default: '/pages/devolucoes-e-garantias' }}">{{ bx_contact_returns | escape }} <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </aside>
      <div class="viri-contact__panel">
        <h2>{{ bx_contact_form_title | escape }}</h2>
        <p class="viri-contact__form-lead">{{ bx_contact_form_intro | escape }}</p>
        {% form 'contact', id: 'ViriContactForm', class: 'viri-contact__form' %}
          {% if form.posted_successfully? %}
            <div class="viri-contact__feedback viri-contact__feedback--success" role="status" tabindex="-1">
              {{ 'boxeup_sections.contact_sent' | t }}
              <p>{{ 'boxeup_sections.contact_received' | t }}</p>
            </div>
          {% endif %}
          {% if form.errors %}
            <div class="viri-contact__feedback viri-contact__feedback--error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}
          <div class="viri-contact__fields">
            <div class="viri-contact__field">
              <label for="ViriContactName">{{ 'boxeup_sections.contact_name' | t }} <span aria-hidden="true">*</span></label>
              <input id="ViriContactName" name="contact[name]" type="text" autocomplete="name" placeholder="{{ 'boxeup_sections.contact_your_name' | t | escape }}" value="{{ form.name | escape }}" required>
            </div>
            <div class="viri-contact__field">
              <label for="ViriContactEmail">{{ 'boxeup_sections.contact_email' | t }} <span aria-hidden="true">*</span></label>
              <input id="ViriContactEmail" name="contact[email]" type="email" autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" placeholder="{{ bx_contact_placeholder_email | escape }}" value="{{ form.email | escape }}" required {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}>
            </div>
            <div class="viri-contact__field viri-contact__field--full">
              <label for="ViriContactSubject">{{ 'boxeup_experience.contact_subject' | t }} <span aria-hidden="true">*</span></label>
              <select id="ViriContactSubject" name="contact[assunto]" required>
                <option value="" disabled {% if form.assunto == blank %}selected{% endif %}>{{ 'boxeup_experience.subject_placeholder' | t }}</option>
                {%- assign bx_subjects = 'produto,encomenda,devolucao,parceria' | split: ',' -%}
                {%- for value in bx_subjects -%}
                  {%- assign bx_subject_label = 'boxeup_experience.subject_' | append: value -%}
                  <option value="{{ value }}" {% if form.assunto == value %}selected{% endif %}>{{ bx_subject_label | t }}</option>
                {%- endfor -%}
              </select>
            </div>
            <div class="viri-contact__field viri-contact__field--full">
              <label for="ViriContactMessage">{{ 'boxeup_sections.contact_message' | t }} <span aria-hidden="true">*</span></label>
              <textarea id="ViriContactMessage" name="contact[body]" rows="5" maxlength="1000" placeholder="{{ 'boxeup_sections.contact_message_help' | t | escape }}" required>{{ form.body | escape }}</textarea>
              <output class="viri-contact__counter" for="ViriContactMessage"><span id="ViriContactCount">0</span> / 1000</output>
            </div>
          </div>
          <div class="viri-contact__form-actions">
            <button class="viri-contact__submit" type="submit">{{ bx_contact_send | escape }} <span aria-hidden="true">↗</span></button>
            <p><span aria-hidden="true">*</span> {{ bx_contact_required | escape }}{% if shop.privacy_policy != blank %} · <a href="{{ shop.privacy_policy.url }}">{{ 'boxeup_sections.contact_policy' | t }}</a>{% endif %}</p>
          </div>
        {% endform %}
      </div>
    </div>
  </div>
</section>
<script>
  (() => {
    const field = document.getElementById('ViriContactMessage');
    const count = document.getElementById('ViriContactCount');
    if (!field || !count) return;
    const update = () => { count.textContent = String(field.value.length); };
    field.addEventListener('input', update);
    update();
  })();
</script>
{% schema %}
{
  "name": "VIRIATTO | Contactos",
  "tag": "section",
  "class": "section-boxeup-contact",
  "settings": [
    {"type": "image_picker", "id": "hero_image", "label": "Imagem do hero (legado)"},
    {"type": "text", "id": "eyebrow", "label": "Etiqueta (legado)", "default": "ESTAMOS AQUI PARA AJUDAR"},
    {"type": "text", "id": "heading", "label": "Título principal (legado)", "default": "Fala connosco."},
    {"type": "textarea", "id": "description", "label": "Introdução (legado)", "default": "Precisas de ajuda a escolher equipamento, tens uma dúvida sobre um produto ou queres apresentar uma proposta de parceria? Envia-nos uma mensagem."},
    {"type": "text", "id": "form_heading", "label": "Título do formulário (legado)", "default": "Envia-nos uma mensagem"},
    {"type": "textarea", "id": "form_intro", "label": "Introdução ao formulário (legado)", "default": "Preenche os campos abaixo para entrar em contacto com a BOXEUP."}
  ],
  "presets": [{"name": "VIRIATTO | Contactos"}]
}
{% endschema %}
