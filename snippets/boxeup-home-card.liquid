{% comment %}
  VIRIATTO / homepage image-first product tile.
  Shopify compare-at prices and discounts are never invented.
  The existing quick-add popup remains connected to the plus button.
{% endcomment %}
{%- if product != blank -%}
  {%- liquid
    assign vh_discount = 0
    if product.compare_at_price > product.price
      assign vh_discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
    endif
    comment
      Short display-only product names for homepage tiles. Keep the full
      Shopify product title in the link, alt text, quick-add and product page.
    endcomment
    assign vh_tile_name = product.title | split: ' — ' | first | split: ' – ' | first | split: ' - ' | first | strip
    if vh_tile_name == blank
      assign vh_tile_name = product.title
    endif
    assign vh_second_image = blank
    if product.images.size > 1
      assign vh_second_image = product.images[1]
    endif
  -%}
  <article class="vh-tile{% if vh_second_image != blank %} vh-tile--has-alt{% endif %}">
    <a class="vh-tile__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '300,450,650,800,1000', sizes: '(min-width: 1100px) 19vw, (min-width: 750px) 31vw, 48vw', alt: product.title, class: 'vh-tile__photo vh-tile__photo--primary' }}
        {%- if vh_second_image != blank -%}
          {{ vh_second_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '300,450,650,800,1000', sizes: '(min-width: 1100px) 19vw, (min-width: 750px) 31vw, 48vw', alt: '', class: 'vh-tile__photo vh-tile__photo--secondary' }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'vh-tile__photo vh-tile__photo--primary' }}
      {%- endif -%}
      <span class="vh-tile__shade" aria-hidden="true"></span>
      {%- if vh_discount > 0 -%}
        <span class="vh-tile__discount">−{{ vh_discount }}%</span>
      {%- elsif product.available == false -%}
        <span class="vh-tile__discount vh-tile__discount--sold">{{ 'boxeup_sections.home_sold_out' | t }}</span>
      {%- endif -%}
      <span class="vh-tile__prices">
        {%- if product.compare_at_price > product.price -%}
          <del>{{ product.compare_at_price | money }}</del>
        {%- endif -%}
        <strong>{{ product.price | money }}</strong>
      </span>
      <span class="vh-tile__name" title="{{ product.title | escape }}">{{ vh_tile_name | escape }}</span>
    </a>
    {%- if product.available -%}
      <modal-opener class="vh-tile__opener" data-modal="#VHomeQuick-{{ section_id }}-{{ product.id }}">
        <button class="vh-tile__plus" type="button"
          aria-haspopup="dialog"
          aria-label="{{ 'boxeup_sections.choose_variant' | t }}: {{ product.title | escape }}"
          data-product-url="{{ product.url }}">
          <span class="vh-tile__plus-icon" aria-hidden="true">+</span>
          {% render 'loading-spinner' %}
        </button>
      </modal-opener>
      <quick-add-modal id="VHomeQuick-{{ section_id }}-{{ product.id }}" class="quick-add-modal">
        <div role="dialog"
          aria-label="{{ 'products.product.choose_product_options' | t: product_name: product.title | escape }}"
          aria-modal="true" class="quick-add-modal__content global-settings-popup" tabindex="-1">
          <button id="ModalClose-VHome-{{ section_id }}-{{ product.id }}" type="button" class="quick-add-modal__toggle" aria-label="{{ 'accessibility.close' | t }}">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </button>
          <div id="QuickAddInfo-VHome-{{ section_id }}-{{ product.id }}" class="quick-add-modal__content-info"></div>
        </div>
      </quick-add-modal>
    {%- endif -%}
  </article>
{%- endif -%}
