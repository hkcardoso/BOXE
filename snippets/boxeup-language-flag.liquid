{%- liquid
  assign flag_language = language_code | downcase | slice: 0, 2
-%}
{%- case flag_language -%}
  {%- when 'pt' -%}
    <svg class="boxeup-language-flag" viewBox="0 0 24 16" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Portugal"><rect width="24" height="16" fill="#ed2939"/><rect width="10" height="16" fill="#006600"/><circle cx="10" cy="8" r="4" fill="none" stroke="#ffcc00" stroke-width="1.25"/><path d="M7 5.5h6v4L10 12 7 9.5z" fill="#fff" stroke="#cc1c2c" stroke-width=".8"/><circle cx="10" cy="8" r="1.15" fill="#2a63af"/></svg>
  {%- when 'en' -%}
    <svg class="boxeup-language-flag" viewBox="0 0 24 16" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="United Kingdom"><rect width="24" height="16" fill="#012169"/><path d="m0 0 24 16m0-16L0 16" stroke="#fff" stroke-width="3.4"/><path d="m0 0 24 16m0-16L0 16" stroke="#c8102e" stroke-width="1.15"/><path d="M12 0v16M0 8h24" stroke="#fff" stroke-width="5"/><path d="M12 0v16M0 8h24" stroke="#c8102e" stroke-width="2.5"/></svg>
  {%- when 'es' -%}
    <svg class="boxeup-language-flag" viewBox="0 0 24 16" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="España"><rect width="24" height="16" fill="#aa151b"/><rect y="4" width="24" height="8" fill="#f1bf00"/><rect x="6" y="6" width="2.5" height="4" fill="#aa151b"/><path d="M6 6h2.5M5.6 7.3h3.3" stroke="#fff" stroke-width=".5"/></svg>
  {%- when 'fr' -%}
    <svg class="boxeup-language-flag" viewBox="0 0 24 16" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="France"><rect width="8" height="16" fill="#002395"/><rect x="8" width="8" height="16" fill="#fff"/><rect x="16" width="8" height="16" fill="#ed2939"/></svg>
  {%- when 'de' -%}
    <svg class="boxeup-language-flag" viewBox="0 0 24 16" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Deutschland"><rect width="24" height="16" fill="#ffce00"/><rect width="24" height="5.33" fill="#111"/><rect y="5.33" width="24" height="5.34" fill="#dd0000"/></svg>
  {%- when 'it' -%}
    <svg class="boxeup-language-flag" viewBox="0 0 24 16" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Italia"><rect width="8" height="16" fill="#009246"/><rect x="8" width="8" height="16" fill="#fff"/><rect x="16" width="8" height="16" fill="#ce2b37"/></svg>
  {%- else -%}
    <svg class="boxeup-language-flag" viewBox="0 0 24 16" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Idioma"><rect width="24" height="16" rx="2" fill="#484a50"/><circle cx="12" cy="8" r="5" fill="none" stroke="#fff"/><path d="M7 8h10M12 3c-2 2-2 8 0 10M12 3c2 2 2 8 0 10" fill="none" stroke="#fff" stroke-width=".8"/></svg>
{%- endcase -%}
