{% doc %}
  @param {string} variant - Desktop or mobile collection navigation.
{% enddoc %}
{% assign bx_native_brand = false %}
{% for filter in collection.filters %}{% if filter.param_name == 'filter.p.vendor' %}{% assign bx_native_brand = true %}{% endif %}{% endfor %}
{% unless bx_native_brand %}
<details class="facets__disclosure bx-brand-filter{% if variant == 'mobile' %} bx-brand-filter--mobile{% endif %}">
  <summary class="facets__summary caption-large focus-offset"><div><span>{{ 'boxeup_experience.brand_navigation' | t }}</span>{{ 'icon-caret.svg' | inline_asset_content }}</div></summary>
  <nav class="bx-brand-panel" aria-label="{{ 'boxeup_experience.brand_navigation' | t }}">
    {% comment %}Use the exact PNG logos and brand order from the homepage.{% endcomment %}
    {%- assign bx_brand_handles = 'fairtex,venum,everlast,leone-1947,charlie,rdx,cleto-reyes,rival,twins' | split: ',' -%}
    {%- for bx_brand_handle in bx_brand_handles -%}
      {%- assign bx_brand_collection = collections[bx_brand_handle] -%}
      {%- assign bx_brand_name = bx_brand_handle | replace: '-', ' ' | capitalize -%}
      {%- assign bx_brand_logo = '' -%}
        {%- case bx_brand_handle -%}
          {%- when 'fairtex' -%}{%- assign bx_brand_name = 'Fairtex' -%}{%- assign bx_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-fairtex-white.png?v=1793040787' -%}
          {%- when 'venum' -%}{%- assign bx_brand_name = 'Venum' -%}{%- assign bx_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-venum-white.png?v=1793040818' -%}
          {%- when 'everlast' -%}{%- assign bx_brand_name = 'Everlast' -%}{%- assign bx_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-everlast-white.png?v=1793040849' -%}
          {%- when 'leone-1947' -%}{%- assign bx_brand_name = 'Leone 1947' -%}{%- assign bx_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/viriatto-leone-1947-logo-white.png?v=1793191434' -%}
          {%- when 'charlie' -%}{%- assign bx_brand_name = 'Charlie' -%}{%- assign bx_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-charlie-white.png?v=1793040801' -%}
          {%- when 'rdx' -%}{%- assign bx_brand_name = 'RDX' -%}{%- assign bx_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/viriatto-rdx-logo-white.png?v=1793191429' -%}
          {%- when 'cleto-reyes' -%}{%- assign bx_brand_name = 'Cleto Reyes' -%}{%- assign bx_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-reyes-white.png?v=1793040826' -%}
          {%- when 'rival' -%}{%- assign bx_brand_name = 'Rival' -%}{%- assign bx_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-rival-white.png?v=1793040835' -%}
          {%- when 'twins' -%}{%- assign bx_brand_name = 'Twins' -%}{%- assign bx_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-twins-white.png?v=1793040843' -%}
        {%- endcase -%}
      <a {% if bx_brand_collection != blank %}data-boxeup-catalog {% endif %}href="{% if bx_brand_collection != blank %}{{ bx_brand_collection.url }}{% else %}{{ routes.search_url }}?q={{ bx_brand_name | url_encode }}{% endif %}" aria-label="{{ bx_brand_name | escape }}"{% if collection.handle == bx_brand_handle %} aria-current="page"{% endif %}>
        <img class="bx-brand-directory__logo" src="{{ bx_brand_logo }}" alt="{{ bx_brand_name | escape }}" width="120" height="50" loading="lazy">
      </a>
    {%- endfor -%}
  </nav>
</details>
{% endunless %}
