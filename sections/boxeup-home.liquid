  assign vh_video_play = 'Reproduzir vídeo'
  assign vh_video_pause = 'Pausar vídeo'
  assign vh_brands = 'EXPLORAR MARCAS'
  assign vh_featured = 'EM DESTAQUE'
  assign vh_new = 'NOVIDADES'
  assign vh_all = 'VER TODOS'
  assign vh_delivery = 'ENTREGA EM PORTUGAL'
  assign vh_delivery_desc = 'Portugal Continental'
  assign vh_returns = 'DEVOLUÇÕES'
  assign vh_returns_desc = 'Consulta as condições'
  assign vh_support = 'APOIO AO CLIENTE'
  assign vh_support_desc = 'Estamos aqui para ajudar'
  assign vh_shipping = 'PORTES GRÁTIS'
  assign vh_shipping_desc = 'Em encomendas superiores a 79 €'
