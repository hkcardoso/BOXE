      font-size: 12px !important;
      opacity: 1 !important;
      visibility: visible;
      transform: none;
    }
    #MainContent[data-template="index"] .section-boxeup-home .vh-home .vh-tile__opener {
      top: 6px !important;
      left: 6px !important;
      bottom: auto !important;
      opacity: 1 !important;
      transform: none !important;
      pointer-events: auto !important;
    }
  }
  @media (max-width:749px) {
    #MainContent[data-template="index"] .section-boxeup-home .vh-home .vh-tile__name {
      left: 9px;
      right: clamp(60px, 37%, 96px);
      bottom: 10px;
      font-size: 12px !important;
    }
  }
  @media (prefers-reduced-motion:reduce) {
    #MainContent[data-template="index"] .section-boxeup-home .vh-home .vh-tile__name {
      transition: none !important;
      transform: none !important;
    }
  }

</style>

<section class="vh-home" aria-label="{{ 'boxeup_sections.aria_home' | t }}">
  <div class="vh-hero">
    {%- if section.settings.hero_image != blank -%}
      {{ section.settings.hero_image | image_url: width: 2200 | image_tag: class: 'vh-hero__image', widths: '800,1200,1600,2200', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: '' }}
    {%- else -%}
      <img class="vh-hero__image" src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-hero-video-poster.jpg?v=1793029300" alt="" width="1920" height="1080" loading="eager" fetchpriority="high">
    {%- endif -%}
    {%- if section.settings.hero_video != blank -%}
      {%- liquid
        assign vh_video_desktop = blank
        assign vh_video_mobile = blank
        assign vh_video_fallback = blank
        for vh_source in section.settings.hero_video.sources
          if vh_source.format == 'mp4'
            if vh_video_fallback == blank
              assign vh_video_fallback = vh_source.url
            endif
            if vh_source.height == 1080
              assign vh_video_desktop = vh_source.url
            endif
            if vh_source.height <= 720 and vh_source.height >= 360
              assign vh_video_mobile = vh_source.url
            endif
          endif
        endfor
        assign vh_video_desktop = vh_video_desktop | default: vh_video_fallback
        assign vh_video_mobile = vh_video_mobile | default: vh_video_desktop
      -%}
      {%- if vh_video_desktop != blank -%}
        <video class="vh-hero__video" autoplay muted loop playsinline preload="metadata" poster="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-hero-video-poster.jpg?v=1793029300" aria-hidden="true" tabindex="-1" disablepictureinpicture>
          <source src="{{ vh_video_mobile | escape }}" media="(max-width: 749px)" type="video/mp4">
          <source src="{{ vh_video_desktop | escape }}" type="video/mp4">
        </video>
      {%- else -%}
        {{ section.settings.hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'vh-hero__video' }}
      {%- endif -%}
    {%- endif -%}
    <div class="vh-frame vh-hero__inner">
      <div class="vh-hero__copy">
        <p class="vh-eyebrow">{{ vh_eyebrow }}</p>
        <h1 class="vh-title">{{ vh_title_a }}<br>{{ vh_title_b }}</h1>
        <p class="vh-intro">{{ vh_intro }}</p>
        <div class="vh-actions">
          <a class="vh-button vh-button--primary" href="{{ routes.all_products_collection_url }}">{{ vh_shop }} <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></a>
          <a class="vh-button vh-button--secondary" href="#VHomeBrands">{{ vh_brands }}</a>
        </div>
      </div>
    </div>
    
  </div>

  <nav class="vh-brands" id="VHomeBrands" aria-label="{{ vh_brands }}">
    <div class="vh-frame vh-brands__inner">
      {%- assign vh_brand_handles = 'fairtex,venum,everlast,leone-1947,charlie,rdx,cleto-reyes,rival,twins' | split: ',' -%}
      {%- for vh_brand_handle in vh_brand_handles -%}
        {%- assign vh_brand_collection = collections[vh_brand_handle] -%}
        {%- assign vh_brand_name = vh_brand_handle | replace: '-', ' ' | capitalize -%}
        {%- assign vh_brand_logo = '' -%}
        {%- case vh_brand_handle -%}
          {%- when 'fairtex' -%}{%- assign vh_brand_name = 'Fairtex' -%}{%- assign vh_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-fairtex-white.png?v=1793040787' -%}
          {%- when 'venum' -%}{%- assign vh_brand_name = 'Venum' -%}{%- assign vh_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-venum-white.png?v=1793040818' -%}
          {%- when 'everlast' -%}{%- assign vh_brand_name = 'Everlast' -%}{%- assign vh_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-everlast-white.png?v=1793040849' -%}
          {%- when 'leone-1947' -%}{%- assign vh_brand_name = 'Leone 1947' -%}{%- assign vh_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/viriatto-leone-1947-logo-white.png?v=1793191434' -%}
          {%- when 'charlie' -%}{%- assign vh_brand_name = 'Charlie' -%}{%- assign vh_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-charlie-white.png?v=1793040801' -%}
          {%- when 'rdx' -%}{%- assign vh_brand_name = 'RDX' -%}{%- assign vh_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/viriatto-rdx-logo-white.png?v=1793191429' -%}
          {%- when 'cleto-reyes' -%}{%- assign vh_brand_name = 'Cleto Reyes' -%}{%- assign vh_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-reyes-white.png?v=1793040826' -%}
          {%- when 'rival' -%}{%- assign vh_brand_name = 'Rival' -%}{%- assign vh_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-rival-white.png?v=1793040835' -%}
          {%- when 'twins' -%}{%- assign vh_brand_name = 'Twins' -%}{%- assign vh_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-twins-white.png?v=1793040843' -%}
        {%- endcase -%}
        <a class="vh-brand vh-brand--{{ vh_brand_handle }}" href="{% if vh_brand_collection != blank %}{{ vh_brand_collection.url }}{% else %}{{ routes.search_url }}?q={{ vh_brand_name | url_encode }}{% endif %}" aria-label="{{ vh_brand_name | escape }}">
          {%- if vh_brand_logo != blank -%}<img src="{{ vh_brand_logo }}" alt="{{ vh_brand_name | escape }}" width="120" height="50" loading="lazy">
          {%- else -%}<span class="vh-brand__word">{{ vh_brand_name }}</span>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </nav>

  <div class="vh-frame">
    <section class="vh-products" id="VHomeFeatured" aria-labelledby="VHomeFeaturedTitle">
      <div class="vh-products__heading">
        <h2 id="VHomeFeaturedTitle">{{ vh_featured }}</h2>
        <a class="vh-products__all" href="{{ routes.all_products_collection_url }}">{{ vh_all }} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></a>
      </div>
      <div class="vh-grid">
        {%- assign vh_featured_ids = '|' -%}
        {%- assign vh_featured_count = 0 -%}
        {%- for product in vh_featured_products -%}
          {%- assign vh_vendor = product.vendor | downcase | strip -%}
          {%- assign vh_product_title = product.title | downcase | strip -%}
          {%- if product.price == 0 or vh_vendor == 'my store' or product.tags contains 'boxeup:hidden' or vh_product_title == 'test' or vh_product_title == 'teste' -%}{%- continue -%}{%- endif -%}
          {%- capture vh_id_marker -%}|{{ product.id }}|{%- endcapture -%}
          {%- if vh_featured_ids contains vh_id_marker -%}{%- continue -%}{%- endif -%}
          {% render 'boxeup-home-card', product: product, section_id: section.id %}
          {%- assign vh_featured_ids = vh_featured_ids | append: product.id | append: '|' -%}
          {%- assign vh_featured_count = vh_featured_count | plus: 1 -%}
          {%- if vh_featured_count >= 8 -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
        {%- if vh_featured_count < 8 -%}
          {%- for product in collections['all'].products -%}
            {%- assign vh_vendor = product.vendor | downcase | strip -%}
            {%- assign vh_product_title = product.title | downcase | strip -%}
            {%- if product.price == 0 or vh_vendor == 'my store' or product.tags contains 'boxeup:hidden' or vh_product_title == 'test' or vh_product_title == 'teste' -%}{%- continue -%}{%- endif -%}
            {%- capture vh_id_marker -%}|{{ product.id }}|{%- endcapture -%}
            {%- if vh_featured_ids contains vh_id_marker -%}{%- continue -%}{%- endif -%}
            {% render 'boxeup-home-card', product: product, section_id: section.id %}
            {%- assign vh_featured_ids = vh_featured_ids | append: product.id | append: '|' -%}
            {%- assign vh_featured_count = vh_featured_count | plus: 1 -%}
            {%- if vh_featured_count >= 8 -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
      {%- if vh_featured_count == 0 -%}<p class="vh-empty">{{ 'boxeup_sections.home_empty' | t }}</p>{%- endif -%}
    </section>

    <section class="vh-products" id="VHomeNew" aria-labelledby="VHomeNewTitle">
      <div class="vh-products__heading">
        <h2 id="VHomeNewTitle">{{ vh_new }}</h2>
        <a class="vh-products__all" href="{{ routes.all_products_collection_url }}?sort_by=created-descending">{{ vh_all }} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></a>
      </div>
      <div class="vh-grid">
        {%- assign vh_new_count = 0 -%}
        {%- for product in vh_latest_products -%}
          {%- assign vh_vendor = product.vendor | downcase | strip -%}
          {%- assign vh_product_title = product.title | downcase | strip -%}
          {%- if product.price == 0 or vh_vendor == 'my store' or product.tags contains 'boxeup:hidden' or vh_product_title == 'test' or vh_product_title == 'teste' -%}{%- continue -%}{%- endif -%}
          {%- capture vh_id_marker -%}|{{ product.id }}|{%- endcapture -%}
          {%- if vh_featured_ids contains vh_id_marker -%}{%- continue -%}{%- endif -%}
          {% render 'boxeup-home-card', product: product, section_id: section.id %}
          {%- assign vh_new_count = vh_new_count | plus: 1 -%}
          {%- if vh_new_count >= 8 -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
      </div>
      {%- if vh_new_count == 0 -%}<p class="vh-empty">{{ 'boxeup_sections.home_empty' | t }}</p>{%- endif -%}
    </section>
  </div>

  <div class="vh-trust">
    <div class="vh-frame vh-trust__inner">
      <div class="vh-trust__item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 6h12v11H2zM14 10h4l4 4v3h-8M6 19a2 2 0 1 0 4 0 2 2 0 0 0-4 0Zm10 0a2 2 0 1 0 4 0 2 2 0 0 0-4 0Z"/></svg><span><strong>{{ vh_shipping }}</strong><small>{{ vh_shipping_desc }}</small></span></div>
      <div class="vh-trust__item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 9 5v10l-9 5-9-5V7zM3 7l9 5 9-5M12 12v10"/></svg><span><strong>{{ vh_delivery }}</strong><small>{{ vh_delivery_desc }}</small></span></div>
      <div class="vh-trust__item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 8 4v7c0 5-4 8-8 9-4-1-8-4-8-9V6zM8 12l3 3 5-6"/></svg><span><strong>{{ vh_returns }}</strong><small>{{ vh_returns_desc }}</small></span></div>
      <div class="vh-trust__item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 15v-4a8 8 0 0 1 16 0v4M4 14H2v5h4v-5zM20 14h2v5h-4v-5zM18 20c-1 2-4 2-6 2"/></svg><span><strong>{{ vh_support }}</strong><small>{{ vh_support_desc }}</small></span></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BOXEUP | Homepage premium",
  "tag": "section",
  "class": "section-boxeup-home",
  "settings": [
    {"type":"product_list","id":"featured_products","label":"Seleção manual de produtos","limit":10},
    {"type":"collection","id":"featured_collection","label":"Coleção de produtos em destaque"},
    {"type":"image_picker","id":"hero_image","label":"Fotografia do hero (recomendado)","info":"Imagem horizontal com atleta à direita e espaço para texto à esquerda."},
    {"type":"video","id":"hero_video","label":"Vídeo do destaque (Shopify)","info":"Opcional. Por defeito, é apresentada uma animação otimizada do vídeo enviado."},
    {"type":"image_picker","id":"editorial_image","label":"Fotografia da secção Disciplina","info":"Opcional: substitui a fotografia editorial da BOXEUP."}
  ],
  "blocks": [
    {
      "type":"category",
      "name":"Modalidade",
      "limit":4,
      "settings":[
        {"type":"text","id":"title","label":"Nome","default":"Boxe"},
        {"type":"text","id":"subtitle","label":"Descrição","default":"Descobre o equipamento"},
        {"type":"text","id":"search_term","label":"Termo de pesquisa","default":"boxe"},
        {"type":"image_picker","id":"image","label":"Fotografia"}
      ]
    }
  ],
  "max_blocks":4,
  "presets":[{"name":"BOXEUP | Homepage premium","blocks":[
    {"type":"category","settings":{"title":"Boxe","subtitle":"Luvas, proteção e treino","search_term":"boxe"}},
    {"type":"category","settings":{"title":"Muay Thai","subtitle":"Técnica e potência","search_term":"muay thai"}},
    {"type":"category","settings":{"title":"MMA","subtitle":"Preparação e combate","search_term":"mma"}},
    {"type":"category","settings":{"title":"Jiu-Jitsu","subtitle":"Equipamento de tatami","search_term":"jiu jitsu"}}
  ]}]
}
{% endschema %}

