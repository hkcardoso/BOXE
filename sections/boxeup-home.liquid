{{ 'boxeup-home.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<style>
  /* BOXEUP SVG arrows: section-local style to prevent emoji rendering */
  .section-boxeup-home .bxv2 .bxv2-arrow-svg{display:block;width:15px;height:15px;flex:none;stroke:currentColor;fill:none;vertical-align:middle}
  .section-boxeup-home .bxv2 .bxv2-btn>span[aria-hidden="true"]{display:inline-flex;align-items:center;justify-content:center;font-size:0!important;background:transparent!important;border:0!important;box-shadow:none!important}
  .section-boxeup-home .bxv2 .bxv2-cat .bxv2-cat__arrow{display:grid;place-items:center;width:27px;height:27px;font-size:0!important;background:rgba(12,13,16,.35);border:1px solid rgba(255,255,255,.48);box-shadow:none;border-radius:50%}
  .section-boxeup-home .bxv2 .bxv2-cat .bxv2-cat__arrow .bxv2-arrow-svg{width:14px;height:14px}
  .section-boxeup-home .bxv2 .bxv2-mod__arrow .bxv2-arrow-svg{width:15px;height:15px}
  @media(max-width:749px){.section-boxeup-home .bxv2 .bxv2-btn>span[aria-hidden="true"] .bxv2-arrow-svg{width:14px;height:14px}}

  /* BOXEUP: dark overlay INSIDE the video layer so it always covers the footage.
     Keep the copy and action buttons above the entire video stack. */
  #shopify-section-{{ section.id }} .bxv2-hero__media {
    position: absolute !important;
    inset: 0 !important;
    overflow: hidden !important;
    z-index: 0 !important;
  }
  /* Preserve the original brightness of the footage. */
  #shopify-section-{{ section.id }} .bxv2-hero__media .bxv2-hero__motion,
  #shopify-section-{{ section.id }} .bxv2-hero__media .bxv2-hero__still {
    filter: none !important;
  }
  #shopify-section-{{ section.id }} .bxv2-hero__video-overlay {
    display: block !important;
    position: absolute !important;
    inset: 0 !important;
    z-index: 4 !important;
    width: 100% !important;
    height: 100% !important;
    pointer-events: none !important;
    /* Balanced left-to-right fade: readable copy, visible gym footage. */
    background: linear-gradient(90deg,
      rgba(3,4,6,.86) 0%, rgba(3,4,6,.78) 20%,
      rgba(3,4,6,.62) 35%, rgba(3,4,6,.34) 52%,
      rgba(3,4,6,.09) 72%, rgba(3,4,6,.02) 88%,
      rgba(3,4,6,0) 100%),
      linear-gradient(0deg,rgba(3,4,6,.23),transparent 45%) !important;
  }
  @media(max-width:749px) {
    #shopify-section-{{ section.id }} .bxv2-hero__video-overlay {
      background:linear-gradient(0deg,
        rgba(3,4,6,.88) 0%, rgba(3,4,6,.75) 38%,
        rgba(3,4,6,.32) 75%, rgba(3,4,6,.05) 100%),
        linear-gradient(90deg,rgba(3,4,6,.20),transparent 88%) !important;
    }
  }
</style>

{% assign bx_products = section.settings.featured_collection.products | default: collections['all'].products %}

<section class="bxv2" aria-label="{{ 'boxeup_sections.aria_home' | t }}">
  <div class="bxv2-wrap">
    <div class="bxv2-hero">
      <div class="bxv2-hero__media">
        {%- liquid
          assign boxeup_video_hd = blank
          assign boxeup_video_fallback = blank
          if section.settings.hero_video != blank
            for source in section.settings.hero_video.sources
              if source.format == 'mp4'
                if boxeup_video_fallback == blank
                  assign boxeup_video_fallback = source.url
                endif
                if source.height >= 1080
                  assign boxeup_video_hd = source.url
                  break
                endif
              endif
            endfor
          endif
          if boxeup_video_hd == blank
            assign boxeup_video_hd = boxeup_video_fallback
          endif
        -%}
        {% if boxeup_video_hd != blank %}
          <video class="bxv2-hero__motion bxv2-hero__motion--video" autoplay muted loop playsinline preload="metadata" poster="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-hero-video-poster.jpg?v=1793029300" aria-hidden="true" tabindex="-1" disablepictureinpicture>
            <source src="{{ boxeup_video_hd | escape }}" type="video/mp4">
          </video>
        {% elsif section.settings.hero_video != blank %}
          {{ section.settings.hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'bxv2-hero__motion bxv2-hero__motion--video' }}
        {% else %}
          <img class="bxv2-hero__motion" src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-hero-video-poster.jpg?v=1793029300" alt="" width="1600" height="900" fetchpriority="high">
        {% endif %}
        <img class="bxv2-hero__still" src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-hero-video-poster.jpg?v=1793029300" alt="" width="1600" height="900" loading="eager" decoding="async">
        {% comment %}Positioned over the video itself, not behind a separate video stacking layer.{% endcomment %}
        <div class="bxv2-hero__video-overlay" aria-hidden="true"></div>
      </div>
      <div class="bxv2-hero__inner">
        <p class="bxv2-overline"><span class="bxv2-dot"></span> {{ 'boxeup_sections.home_overline' | t }}</p>
        <h1>{{ 'boxeup_sections.home_h1a' | t }}<br>{{ 'boxeup_sections.home_h1b' | t }} <em>{{ 'boxeup_sections.home_h1c' | t }}</em></h1>
        <p class="bxv2-hero__desc">{{ 'boxeup_experience.home_intro' | t }}</p>
        <div class="bxv2-actions">
          <a class="bxv2-btn bxv2-btn--red" href="{{ routes.all_products_collection_url }}">{{ 'boxeup_sections.home_catalog' | t }} <span aria-hidden="true"><svg class="bxv2-arrow-svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 18 18 6M8 6h10v10"/></svg></span></a>
          <a class="bxv2-btn bxv2-btn--glass" href="#bxv2-modalidades">{{ 'boxeup_sections.home_disciplines' | t }} <span aria-hidden="true"><svg class="bxv2-arrow-svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 18 18 6M8 6h10v10"/></svg></span></a>
        </div>
        <span class="bxv2-hero__index">{{ 'boxeup_sections.home_boxing' | t }} <b>/</b> MUAY THAI <b>/</b> MMA <b>/</b> JIU-JITSU</span>
      </div>
      <button type="button" class="bx-video-toggle" data-bx-video aria-label="{{ 'boxeup_experience.pause' | t }}"><span aria-hidden="true">Ⅱ</span></button>
      <div class="bxv2-hero__stamp" aria-hidden="true">{{ 'boxeup_sections.home_discipline' | t }}<br>{{ 'boxeup_sections.home_focus' | t }}<br>{{ 'boxeup_sections.home_progress' | t }}<span>.</span></div>
      <div class="bxv2-trust" aria-label="{{ 'boxeup_sections.aria_trust' | t }}">
        <span><i aria-hidden="true">✦</i> {{ 'boxeup_sections.home_portuguese' | t }}</span>
        <span><i aria-hidden="true">✦</i> {{ 'boxeup_sections.home_multibrand' | t }}</span>
        <span><i aria-hidden="true">✦</i> {{ 'boxeup_sections.home_secure' | t }}</span>
      </div>
    </div>
  </div>

  {% comment %}Merchandising sections share the same content rail as the catalog, unlike the full-bleed hero.{% endcomment %}
  <div class="bxv2-wrap bxv2-wrap--merchandising">
    <div class="bxv2-block bxv2-block--categories">
      <div class="bxv2-heading">
        <div>
          <p class="bxv2-kicker">{{ 'boxeup_sections.home_choose_gear' | t }}</p>
          <h2>{{ 'boxeup_sections.home_start' | t }}<span class="bxv2-red">.</span></h2>
        </div>
        <a class="bxv2-more" href="{{ routes.all_products_collection_url }}">{{ 'boxeup_sections.home_all_catalog' | t }} <span aria-hidden="true">→</span></a>
      </div>
      <div class="bxv2-cat-grid">
        <a href="{{ collections['luvas-de-boxe-e-muay-thai'].url }}#boxeup-catalog-filters" class="bxv2-cat bxv2-cat--1" aria-label="{{ 'boxeup_sections.aria_gloves' | t }}">
          {% render 'boxeup-category-product', product_handle: 'charlie-bat-x-luvas-de-treino', alt: 'Luvas Charlie Bat-X vermelhas' %}
          <span class="bxv2-cat__label"><strong>{{ 'boxeup_sections.home_gloves' | t }}</strong><span class="bxv2-cat__arrow" aria-hidden="true"><svg class="bxv2-arrow-svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 18 18 6M8 6h10v10"/></svg></span></span>
        </a>
        <a href="{{ collections['caneleiras-de-muay-thai-e-kickboxing'].url }}#boxeup-catalog-filters" class="bxv2-cat bxv2-cat--2" aria-label="{{ 'boxeup_sections.aria_shins' | t }}">
          {% render 'boxeup-category-product', product_handle: 'fairtex-sp5-caneleiras-de-competicao', alt: 'Caneleiras Fairtex SP5' %}
          <span class="bxv2-cat__label"><strong>{{ 'boxeup_sections.home_shinguards' | t }}</strong><span class="bxv2-cat__arrow" aria-hidden="true"><svg class="bxv2-arrow-svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 18 18 6M8 6h10v10"/></svg></span></span>
        </a>
        <a href="{{ collections['boqueiras-e-protecoes'].url }}#boxeup-catalog-filters" class="bxv2-cat bxv2-cat--3" aria-label="{{ 'boxeup_sections.aria_mouth' | t }}">
          {% render 'boxeup-category-product', product_handle: 'venum-challenger-boqueira-com-caixa', alt: 'Boqueira Venum Challenger' %}
          <span class="bxv2-cat__label"><strong>{{ 'boxeup_sections.home_mouthguards' | t }}</strong><span class="bxv2-cat__arrow" aria-hidden="true"><svg class="bxv2-arrow-svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 18 18 6M8 6h10v10"/></svg></span></span>
        </a>
        <a href="{{ collections['calcoes-e-roupa-de-combate'].url }}#boxeup-catalog-filters" class="bxv2-cat bxv2-cat--4" aria-label="{{ 'boxeup_sections.aria_apparel' | t }}">
          {% render 'boxeup-category-product', product_handle: 'fluory-calcoes-de-muay-thai-vermelho-e-preto', alt: 'Calções FLUORY de Muay Thai' %}
          <span class="bxv2-cat__label"><strong>{{ 'boxeup_sections.home_apparel' | t }}</strong><span class="bxv2-cat__arrow" aria-hidden="true"><svg class="bxv2-arrow-svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 18 18 6M8 6h10v10"/></svg></span></span>
        </a>
        <a href="{{ collections['mochilas-e-sacos-de-treino-1'].url }}#boxeup-catalog-filters" class="bxv2-cat bxv2-cat--5" aria-label="{{ 'boxeup_sections.aria_bags' | t }}">
          {% render 'boxeup-category-product', product_handle: 'venum-challenger-pro-evo-mochila-22-5-l', alt: 'Mochila Venum Challenger Pro Evo' %}
          <span class="bxv2-cat__label"><strong>{{ 'boxeup_sections.home_bags' | t }}</strong><span class="bxv2-cat__arrow" aria-hidden="true"><svg class="bxv2-arrow-svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 18 18 6M8 6h10v10"/></svg></span></span>
        </a>
        <a href="{{ collections['equipamento-de-treino'].url }}#boxeup-catalog-filters" class="bxv2-cat bxv2-cat--6" aria-label="{{ 'boxeup_sections.aria_training' | t }}">
          {% render 'boxeup-category-product', product_handle: 'rival-rhg2-capacete-hibrido', alt: 'Capacete Rival RHG2 de treino' %}
          <span class="bxv2-cat__label"><strong>{{ 'boxeup_sections.home_gear' | t }}</strong><span class="bxv2-cat__arrow" aria-hidden="true"><svg class="bxv2-arrow-svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 18 18 6M8 6h10v10"/></svg></span></span>
        </a>
      </div>
    </div>

    <div class="bxv2-block bxv2-block--products" id="bxv2-destaques">
      <div class="bxv2-heading">
        <div><p class="bxv2-kicker">{{ 'boxeup_sections.home_featured' | t }}</p><h2>{{ 'boxeup_sections.home_featured_title' | t }}<span class="bxv2-red">.</span></h2><p>{{ 'boxeup_sections.home_featured_desc' | t }}</p></div>
        <a class="bxv2-more" href="{{ routes.all_products_collection_url }}">{{ 'boxeup_sections.home_all_products' | t }} <span aria-hidden="true">→</span></a>
      </div>
      {% if bx_products.size > 0 %}
        <div class="bxv2-product-grid">
          {% assign bx_shown = 0 %}
          {% assign bx_seen_types = '' %}
          {% assign bx_twice_types = '' %}
          {% for product in bx_products %}
                  {%- capture bx_visible -%}{%- render 'boxeup-product-visible', product: product -%}{%- endcapture -%}
                  {%- if bx_visible == 'false' -%}{%- continue -%}{%- endif -%}
            {% assign bx_vendor = product.vendor | downcase %}
            {% if bx_vendor == 'my store' or product.price == 0 %}{% continue %}{% endif %}
            {% if bx_shown == 10 %}{% break %}{% endif %}
            {% assign bx_type = product.type | default: product.vendor | handleize %}
            {% assign bx_type_marker = '|' | append: bx_type | append: '|' %}
            {% if bx_twice_types contains bx_type_marker %}{% continue %}{% endif %}
            {% if bx_seen_types contains bx_type_marker %}{% assign bx_twice_types = bx_twice_types | append: bx_type_marker %}{% endif %}
            {% assign bx_seen_types = bx_seen_types | append: bx_type_marker %}
            {% assign bx_shown = bx_shown | plus: 1 %}
            <article class="bxv2-product">
              <a class="bxv2-product__image" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,450,600,700', sizes: '(min-width:990px) 18vw, (min-width:750px) 30vw, 47vw', alt: product.title }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'bxv2-product__placeholder' }}
                {% endif %}
                {% if product.compare_at_price > product.price %}<span class="bxv2-product__badge">{{ 'boxeup_sections.home_sale' | t }}</span>{% elsif product.available == false %}<span class="bxv2-product__badge bxv2-product__badge--neutral">{{ 'boxeup_sections.home_sold_out' | t }}</span>{% endif %}
              </a>
              <div class="bxv2-product__info">
                {%- assign bx_home_parts = product.title | split: ' — ' -%}
                {%- if bx_home_parts.size == 1 -%}{%- assign bx_home_parts = product.title | split: ' | ' -%}{%- endif -%}
                <a href="{{ product.url }}" class="bxv2-product__title" aria-label="{{ product.title | escape }}">{% if bx_home_parts.size > 1 %}{{ bx_home_parts.first | escape }}{% else %}{{ product.title | escape }}{% endif %}</a>
                {% if bx_home_parts.size > 1 %}
                  <p class="bxv2-product__subtitle">{{ bx_home_parts[1] | strip | escape }}</p>
                {% elsif product.vendor != blank %}
                  <p class="bxv2-product__subtitle">{{ product.vendor | escape }}</p>
                {% endif %}
                {% render 'boxeup-real-swatches', product: product %}
                <div class="bxv2-product__bottom">
                  <div class="bxv2-product__prices">
                    <strong>{{ product.price | money }}</strong>
                    {% if product.compare_at_price > product.price %}<del>{{ product.compare_at_price | money }}</del>{% endif %}
                  </div>
                  <div class="boxeup-home-card-actions">
                    <a class="bxv2-product__view" href="{{ product.url }}" aria-label="{{ 'boxeup_sections.view_item' | t }} {{ product.title | escape }}"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></a>
                    {% if product.available %}
                      <modal-opener data-modal="#HomeQuickAdd-{{ product.id }}">
                        <button type="button" class="bxv2-product__add" aria-haspopup="dialog" aria-label="{{ 'boxeup_sections.choose_variant' | t }}: {{ product.title | escape }}" data-product-url="{{ product.url }}">
                          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 3.5h2.8l2.2 11.3h11.6l2-8.2H6.2"/><circle cx="9.2" cy="20" r="1.3"/><circle cx="18" cy="20" r="1.3"/></svg>
                          {% render 'loading-spinner' %}
                        </button>
                      </modal-opener>
                      <quick-add-modal id="HomeQuickAdd-{{ product.id }}" class="quick-add-modal">
                        <div role="dialog" aria-label="{{ 'products.product.choose_product_options' | t: product_name: product.title | escape }}" aria-modal="true" class="quick-add-modal__content global-settings-popup" tabindex="-1">
                          <button type="button" id="ModalClose-Home-{{ product.id }}" class="quick-add-modal__toggle" aria-label="{{ 'accessibility.close' | t }}">{{- 'icon-close.svg' | inline_asset_content -}}</button>
                          <div id="QuickAddInfo-Home-{{ product.id }}" class="quick-add-modal__content-info"></div>
                        </div>
                      </quick-add-modal>
                    {% else %}
                      <span class="bxv2-product__add bxv2-product__add--disabled" role="img" aria-label="{{ 'boxeup_sections.home_sold_out' | t }}"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 3.5h2.8l2.2 11.3h11.6l2-8.2H6.2"/><circle cx="9.2" cy="20" r="1.3"/><circle cx="18" cy="20" r="1.3"/></svg></span>
                    {% endif %}
                  </div>
                </div>
              </div>
            </article>
          {% endfor %}
        </div>
      {% else %}
        <div class="bxv2-empty">{{ 'boxeup_sections.home_empty' | t }} <a href="{{ routes.all_products_collection_url }}">{{ 'boxeup_sections.home_empty_catalog' | t }}</a>.</div>
      {% endif %}
    </div>
  </div>

  <div class="bxv2-wrap">
    <div class="bxv2-block bxv2-block--modalities" id="bxv2-modalidades">
      <div class="bxv2-heading">
        <div><p class="bxv2-kicker">{{ 'boxeup_sections.home_sport_label' | t }}</p><h2>{{ 'boxeup_sections.home_sport_heading' | t }}<span class="bxv2-red">.</span></h2></div>
        <a class="bxv2-more" href="{{ routes.all_products_collection_url }}">{{ 'boxeup_sections.home_explore_catalog' | t }} <span aria-hidden="true">→</span></a>
      </div>
      <div class="bxv2-mod-grid">
        {% for block in section.blocks %}
          {% if block.type == 'category' %}
            {% assign bx_modality_handle = block.settings.title | handleize %}
            {% if bx_modality_handle == 'muay-thai' %}{% assign bx_modality_handle = 'muay-thai-e-kickboxing' %}{% endif %}
            {% assign bx_modality = collections[bx_modality_handle] %}
            <a class="bxv2-mod{% if bx_modality_handle == 'mma' or bx_modality_handle == 'jiu-jitsu' %} bxv2-mod--coming{% endif %}" {% if bx_modality_handle == 'mma' or bx_modality_handle == 'jiu-jitsu' %}role="link" aria-disabled="true"{% else %}href="{{ bx_modality.url | default: routes.all_products_collection_url }}"{% endif %} {{ block.shopify_attributes }}>
              <div class="bxv2-mod__image">
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,800,1000', sizes: '(min-width:990px) 25vw, (min-width:750px) 50vw, 90vw', alt: block.settings.title }}
                {% else %}
                  <span class="bxv2-mod__fallback" aria-hidden="true">{{ block.settings.title | slice: 0, 1 }}</span>
                {% endif %}
              </div>
              <span class="bxv2-mod__body"><strong>{{ block.settings.title | escape }}</strong><small>{% if bx_modality_handle == 'mma' or bx_modality_handle == 'jiu-jitsu' %}{{ 'boxeup_experience.coming' | t }}{% else %}{{ block.settings.subtitle | escape }}{% endif %}</small></span>
              <span class="bxv2-mod__arrow" aria-hidden="true"><svg class="bxv2-arrow-svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 18 18 6M8 6h10v10"/></svg></span>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="bxv2-block bxv2-block--brands">
      <div class="bxv2-heading"><div><p class="bxv2-kicker">{{ 'boxeup_sections.home_brands_kicker' | t }}</p><h2>{{ 'boxeup_sections.home_brands_heading' | t }}<span class="bxv2-red">.</span></h2></div><a class="bxv2-more" href="{{ routes.all_products_collection_url }}">{{ 'boxeup_sections.home_catalog' | t }} <span aria-hidden="true">→</span></a></div>
      <div class="bxv2-brand-grid">
        <a class="bxv2-brand bxv2-brand--with-logo" href="{{ routes.root_url }}collections/fairtex" aria-label="{{ 'boxeup_sections.view_brand' | t }} Fairtex"><img class="bxv2-brand__logo" src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-fairtex-white.png?v=1793040787" alt="Fairtex" width="140" height="72" loading="lazy"></a>
        <a class="bxv2-brand bxv2-brand--with-logo" href="{{ routes.root_url }}collections/charlie" aria-label="{{ 'boxeup_sections.view_brand' | t }} Charlie"><img class="bxv2-brand__logo" src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-charlie-white.png?v=1793040801" alt="Charlie" width="140" height="72" loading="lazy"></a>
        <a class="bxv2-brand bxv2-brand--with-logo" href="{{ routes.root_url }}collections/buddha" aria-label="{{ 'boxeup_sections.view_brand' | t }} Buddha"><img class="bxv2-brand__logo" src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-buddha-white.png?v=1793040808" alt="Buddha" width="140" height="72" loading="lazy"></a>
        <a class="bxv2-brand bxv2-brand--with-logo" href="{{ routes.root_url }}collections/venum" aria-label="{{ 'boxeup_sections.view_brand' | t }} Venum"><img class="bxv2-brand__logo" src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-venum-white.png?v=1793040818" alt="Venum" width="140" height="72" loading="lazy"></a>
        <a class="bxv2-brand bxv2-brand--with-logo" href="{{ routes.root_url }}collections/cleto-reyes" aria-label="{{ 'boxeup_sections.view_brand' | t }} Cleto Reyes"><img class="bxv2-brand__logo" src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-reyes-white.png?v=1793040826" alt="Cleto Reyes" width="140" height="72" loading="lazy"></a>
        <a class="bxv2-brand bxv2-brand--with-logo" href="{{ routes.root_url }}collections/rival" aria-label="{{ 'boxeup_sections.view_brand' | t }} Rival"><img class="bxv2-brand__logo" src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-rival-white.png?v=1793040835" alt="Rival" width="140" height="72" loading="lazy"></a>
        <a class="bxv2-brand bxv2-brand--with-logo" href="{{ routes.root_url }}collections/twins" aria-label="{{ 'boxeup_sections.view_brand' | t }} Twins"><img class="bxv2-brand__logo" src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-twins-white.png?v=1793040843" alt="Twins" width="140" height="72" loading="lazy"></a>
        <a class="bxv2-brand bxv2-brand--with-logo" href="{{ routes.root_url }}collections/everlast" aria-label="{{ 'boxeup_sections.view_brand' | t }} Everlast"><img class="bxv2-brand__logo" src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-everlast-white.png?v=1793040849" alt="Everlast" width="140" height="72" loading="lazy"></a>
      </div>
    </div>
  </div>

  <div class="bxv2-story">
    <div class="bxv2-story__art"><img src="https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-comunidade.webp?v=1793121082" alt="Ginásio de boxe com sacos de treino BOXEUP" width="2048" height="682" loading="lazy"></div>
    <div class="bxv2-story__copy">
      <p class="bxv2-kicker">{{ 'boxeup_sections.home_history_kicker' | t }}</p>
      <h2>{{ 'boxeup_sections.home_history_a' | t }}<br><em>{{ 'boxeup_sections.home_history_b' | t }}</em></h2>
      <p>{{ 'boxeup_sections.home_history_desc' | t }}</p>
      <a class="bxv2-more bxv2-more--light" href="{{ routes.root_url }}pages/sobre-a-boxeup">{{ 'boxeup_sections.home_learn' | t }} <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="bxv2-wrap bx-choice-section">
    <p class="bxv2-kicker">{{ 'boxeup_experience.new_here' | t }}</p>
    <h2>{{ 'boxeup_experience.help_title' | t }}</h2>
    <p>{{ 'boxeup_experience.new_here_intro' | t }}</p>
    <div class="bx-choice-grid">
      <button type="button" class="bx-choice-card" data-bx-open="BxGuide"><strong>{{ 'boxeup_experience.first_gloves' | t }}</strong><span>{{ 'boxeup_experience.first_gloves_text' | t }}</span><span aria-hidden="true">↗</span></button>
      <a class="bx-choice-card" href="{{ collections['muay-thai-e-kickboxing'].url | default: routes.all_products_collection_url }}"><strong>{{ 'boxeup_experience.thai_kit' | t }}</strong><span>{{ 'boxeup_experience.thai_kit_text' | t }}</span><span aria-hidden="true">↗</span></a>
      <button type="button" class="bx-choice-card" data-bx-open="BxSizeGuide"><strong>{{ 'boxeup_experience.size_guide' | t }}</strong><span>{{ 'boxeup_experience.help_text' | t }}</span><span aria-hidden="true">↗</span></button>
    </div>
  </div>
  <div class="bxv2-wrap bxv2-wrap--newsletter">
    <div class="bxv2-news">
      <div><p class="bxv2-kicker">{{ 'boxeup_sections.home_join' | t }}</p><h2>{{ 'boxeup_sections.home_newsletter_heading' | t }}</h2><p>{{ 'boxeup_sections.home_newsletter_desc' | t }}</p></div>
      {% form 'customer', class: 'bxv2-news__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="bxv2-email-{{ section.id }}">{{ 'boxeup_sections.home_your_email' | t }}</label>
        <input id="bxv2-email-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'boxeup_sections.home_your_email' | t }}" required aria-required="true" value="{{ form.email | escape }}">
        <button type="submit" aria-label="{{ 'boxeup_sections.aria_subscribe' | t }}">{{ 'boxeup_sections.home_subscribe' | t }}</button>
        {% if form.posted_successfully? %}<p class="bxv2-news__feedback" role="status">{{ 'boxeup_sections.home_success' | t }}</p>{% elsif form.errors %}<p class="bxv2-news__feedback" role="alert">{{ form.errors | default_errors }}</p>{% endif %}
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BOXEUP | Homepage premium",
  "tag": "section",
  "class": "section-boxeup-home",
  "settings": [
    {"type":"collection","id":"featured_collection","label":"Coleção de produtos em destaque"},
    {"type":"video","id":"hero_video","label":"Vídeo do destaque (Shopify)","info":"Opcional. Por defeito, é apresentada uma animação otimizada do vídeo enviado."},
    {"type":"image_picker","id":"editorial_image","label":"Fotografia da secção Disciplina","info":"Opcional: substitui a fotografia editorial da BOXEUP."}
  ],
  "blocks": [
    {
      "type":"category",
      "name":"Modalidade",
      "limit":4,
      "settings":[
        {"type":"text","id":"title","label":"Nome","default":"Boxe"},
        {"type":"text","id":"subtitle","label":"Descrição","default":"Descobre o equipamento"},
        {"type":"text","id":"search_term","label":"Termo de pesquisa","default":"boxe"},
        {"type":"image_picker","id":"image","label":"Fotografia"}
      ]
    }
  ],
  "max_blocks":4,
  "presets":[{"name":"BOXEUP | Homepage premium","blocks":[
    {"type":"category","settings":{"title":"Boxe","subtitle":"Luvas, proteção e treino","search_term":"boxe"}},
    {"type":"category","settings":{"title":"Muay Thai","subtitle":"Técnica e potência","search_term":"muay thai"}},
    {"type":"category","settings":{"title":"MMA","subtitle":"Preparação e combate","search_term":"mma"}},
    {"type":"category","settings":{"title":"Jiu-Jitsu","subtitle":"Equipamento de tatami","search_term":"jiu jitsu"}}
  ]}]
}
{% endschema %}

