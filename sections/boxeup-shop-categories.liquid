{% comment %}BOXEUP — full-bleed dark background behind the centered category controls.{% endcomment %}
<style>
  /* Catalogue uses Shopify's accessible filter drawer above the products.
     Never overlay a second floating filter button on product cards. */
  body .bx-mobile-filters:not([hidden]),
  body [data-bx-mobile-filters]:not([hidden]) {
    display:none!important;
  }
  @media screen and (max-width:749px){
    /* Brand logos now live inside the bottom sheet; keep category chips compact. */
    body #MainContent .section-boxeup-shop-categories .bx-mobile-brand-strip,
    body #MainContent #boxeup-catalog-filters .bx-mobile-brand-strip{
      display:none!important;
    }
    body #MainContent #boxeup-catalog-filters{
      padding-block:8px 4px!important;
      margin-bottom:0!important;
    }
    body #MainContent #boxeup-catalog-filters .boxeup-chip-list{
      gap:6px!important;
      padding-block:2px 6px!important;
      margin-bottom:0!important;
    }
    body #MainContent #boxeup-catalog-filters .boxeup-chip{
      min-height:35px!important;
      padding:7px 11px!important;
      font-size:11px!important;
    }
    body #MainContent #boxeup-catalog-filters .bx-tools-row{
      gap:16px!important;
      margin:5px 0 0!important;
      padding:0!important;
    }
    body #MainContent #boxeup-catalog-filters .bx-text-button{
      min-height:34px!important;
      padding-block:6px!important;
      font-size:11px!important;
    }
  }
</style>
<section id="boxeup-catalog-filters" class="boxeup-catalog-controls page-width" aria-label="{{ 'boxeup_navigation.categories' | t }}">
  <h2 class="visually-hidden">{{ 'boxeup_navigation.heading' | t }}</h2>
  <nav class="boxeup-chip-list" aria-label="{{ 'boxeup_navigation.categories' | t }}">
    <a class="boxeup-chip" data-boxeup-catalog href="{{ routes.all_products_collection_url }}"{% if collection.handle == 'all' %} aria-current="page"{% endif %}>{{ 'boxeup_navigation.all' | t }}</a>
    {% assign category_handles = 'luvas-de-boxe-e-muay-thai,caneleiras-de-muay-thai-e-kickboxing,boqueiras-e-protecoes,vestuario-e-fightwear,mochilas-e-sacos-de-treino-1,equipamento-de-treino' | split: ',' %}
    {% assign category_labels = 'luvas,caneleiras,boqueiras,roupa,mochilas,treino' | split: ',' %}
    {% for category_handle in category_handles %}
      {% assign category = collections[category_handle] %}
      {% assign label_key = 'boxeup_navigation.' | append: category_labels[forloop.index0] %}
      {% if category != blank %}<a class="boxeup-chip" data-boxeup-catalog href="{{ category.url }}"{% if collection.handle == category_handle %} aria-current="page"{% endif %}>{{ label_key | t }}</a>{% endif %}
    {% endfor %}
  </nav>
  {% comment %}
    Match exactly the brand artwork and order shown on the VIRIATTO homepage.
    A single captured set supplies both the desktop directory and mobile strip.
  {% endcomment %}
  {%- assign bx_brand_handles = 'fairtex,venum,everlast,leone-1947,charlie,rdx,cleto-reyes,rival,twins' | split: ',' -%}
  {%- capture bx_catalog_brand_links -%}
    {%- for bx_brand_handle in bx_brand_handles -%}
      {%- assign bx_brand_collection = collections[bx_brand_handle] -%}
      {%- assign bx_brand_name = bx_brand_handle | replace: '-', ' ' | capitalize -%}
      {%- assign bx_brand_logo = '' -%}
        {%- case bx_brand_handle -%}
          {%- when 'fairtex' -%}{%- assign bx_brand_name = 'Fairtex' -%}{%- assign bx_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-fairtex-white.png?v=1793040787' -%}
          {%- when 'venum' -%}{%- assign bx_brand_name = 'Venum' -%}{%- assign bx_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-venum-white.png?v=1793040818' -%}
          {%- when 'everlast' -%}{%- assign bx_brand_name = 'Everlast' -%}{%- assign bx_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-everlast-white.png?v=1793040849' -%}
          {%- when 'leone-1947' -%}{%- assign bx_brand_name = 'Leone 1947' -%}{%- assign bx_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/viriatto-leone-1947-logo-white.png?v=1793191434' -%}
          {%- when 'charlie' -%}{%- assign bx_brand_name = 'Charlie' -%}{%- assign bx_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-charlie-white.png?v=1793040801' -%}
          {%- when 'rdx' -%}{%- assign bx_brand_name = 'RDX' -%}{%- assign bx_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/viriatto-rdx-logo-white.png?v=1793191429' -%}
          {%- when 'cleto-reyes' -%}{%- assign bx_brand_name = 'Cleto Reyes' -%}{%- assign bx_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-reyes-white.png?v=1793040826' -%}
          {%- when 'rival' -%}{%- assign bx_brand_name = 'Rival' -%}{%- assign bx_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-rival-white.png?v=1793040835' -%}
          {%- when 'twins' -%}{%- assign bx_brand_name = 'Twins' -%}{%- assign bx_brand_logo = 'https://cdn.shopify.com/s/files/1/0944/3937/5184/files/boxeup-logo-twins-white.png?v=1793040843' -%}
        {%- endcase -%}
      <a {% if bx_brand_collection != blank %}data-boxeup-catalog {% endif %}href="{% if bx_brand_collection != blank %}{{ bx_brand_collection.url }}{% else %}{{ routes.search_url }}?q={{ bx_brand_name | url_encode }}{% endif %}" aria-label="{{ bx_brand_name | escape }}"{% if collection.handle == bx_brand_handle %} aria-current="page"{% endif %}>
        <img class="bx-brand-directory__logo" src="{{ bx_brand_logo }}" alt="{{ bx_brand_name | escape }}" width="120" height="50" loading="lazy">
      </a>
    {%- endfor -%}
  {%- endcapture -%}
  <details class="bx-brand-directory" id="BxBrands">
    <summary>{{ 'boxeup_experience.brands' | t }} <span aria-hidden="true">+</span></summary>
    <nav aria-label="{{ 'boxeup_experience.brand_navigation' | t }}">{{ bx_catalog_brand_links }}</nav>
  </details>
  <nav class="bx-mobile-brand-strip" aria-label="{{ 'boxeup_experience.brand_navigation' | t }}">{{ bx_catalog_brand_links }}</nav>
  <div class="bx-tools-row">
    <button type="button" class="bx-text-button" data-bx-open="BxGuide">{{ 'boxeup_experience.guide' | t }} <span class="bx-inline-arrow" aria-hidden="true"><svg class="bxv2-arrow-svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M5 19 19 5M8 5h11v11"/></svg></span></button>
    <button type="button" class="bx-text-button" data-bx-open="BxSizeGuide">{{ 'boxeup_experience.size_guide' | t }}</button>
  </div>
  <p class="boxeup-catalog-message" role="status" aria-live="polite" data-loading="{{ 'boxeup_navigation.loading' | t }}" data-loaded="{{ 'boxeup_navigation.loaded' | t }}" data-error="{{ 'boxeup_navigation.error' | t }}"></p>
</section>
{% schema %}
{"name":"BOXEUP | Categorias","tag":"section","class":"section-boxeup-shop-categories","settings":[],"presets":[{"name":"BOXEUP | Categorias"}]}
{% endschema %}


