{%- liquid
  assign og_title = seo_title | default: page_title | default: 'VIRIATTO'
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_description | default: page_description | default: shop.description | default: 'VIRIATTO'
  assign og_image = page_image

  if request.page_type == 'product'
    assign og_type = 'product'
    if product.featured_image != blank
      assign og_image = product.featured_image
    endif
  elsif request.page_type == 'collection'
    if collection.image != blank
      assign og_image = collection.image
    endif
  elsif request.page_type == 'article'
    assign og_type = 'article'
    if article.image != blank
      assign og_image = article.image
    endif
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
-%}

<meta property="og:site_name" content="VIRIATTO">
<meta property="og:url" content="{{ og_url | escape }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if og_image != blank -%}
  {%- assign og_image_url = og_image | image_url: width: 1200 | prepend: 'https:' -%}
  <meta property="og:image" content="{{ og_image_url | escape }}">
  <meta property="og:image:secure_url" content="{{ og_image_url | escape }}">
  <meta property="og:image:alt" content="{{ og_title | escape }}">
  <meta name="twitter:image" content="{{ og_image_url | escape }}">
{%- elsif request.page_type == 'index' -%}
  {%- assign viriatto_preview_image = 'viriatto-pack-training.jpg' | asset_url | prepend: 'https:' -%}
  <meta property="og:image" content="{{ viriatto_preview_image | escape }}">
  <meta property="og:image:secure_url" content="{{ viriatto_preview_image | escape }}">
  <meta property="og:image:alt" content="Equipamento de treino VIRIATTO para desportos de combate">
  <meta name="twitter:image" content="{{ viriatto_preview_image | escape }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
