{% comment %}
  Square category image from a live Shopify product. The image updates automatically
  when the selected product's featured image is changed in the Shopify admin.
{% endcomment %}
{% assign boxeup_category_item = all_products[product_handle] %}
{% if boxeup_category_item != blank and boxeup_category_item.featured_image != blank %}
  {{ boxeup_category_item.featured_image | image_url: width: 760 | image_tag: loading: 'lazy', widths: '240,360,520,760', sizes: '(min-width: 1100px) 16vw, (min-width: 750px) 33vw, 48vw', class: 'bxv2-cat__photo', alt: alt }}
{% else %}
  {{ 'product-1' | placeholder_svg_tag: 'bxv2-cat__photo bxv2-cat__fallback' }}
{% endif %}
