{%- liquid
  assign vi_lang = request.locale.iso_code | slice: 0, 2
  assign vi_tagline = 'CONTACTOS'
  assign vi_title = 'FALA CONNOSCO.'
  assign vi_intro = 'Dúvidas sobre produtos, encomendas ou parcerias? Envia-nos uma mensagem.'
  assign vi_location = 'LOCALIZAÇÃO'
  assign vi_location_value = 'Portugal · Loja online'
  assign vi_contact = 'CONTACTO'
  assign vi_form_title = 'DIZ-NOS O QUE PRECISAS.'
  assign vi_faq_shipping = 'Envios e entregas'
  assign vi_faq_returns = 'Devoluções e garantias'
  assign vi_subject_label = 'Assunto'
  assign vi_subject_prompt = 'Seleciona o assunto'
  assign vi_subject_product = 'Equipamento e tamanhos'
  assign vi_subject_order = 'Encomendas e entregas'
  assign vi_subject_returns = 'Trocas, devoluções e garantias'
  assign vi_subject_partner = 'Parcerias e distribuição'
  assign vi_subject_other = 'Outro assunto'
  if vi_lang == 'en'
    assign vi_tagline = 'CONTACT'
    assign vi_title = 'LET’S TALK.'
    assign vi_intro = 'Questions about products, orders or partnerships? Send us a message.'
    assign vi_location = 'LOCATION'
    assign vi_location_value = 'Portugal · Online store'
    assign vi_contact = 'CONTACT'
    assign vi_form_title = 'TELL US WHAT YOU NEED.'
    assign vi_faq_shipping = 'Shipping and delivery'
    assign vi_faq_returns = 'Returns and warranty'
    assign vi_subject_label = 'Subject'
    assign vi_subject_prompt = 'Choose a subject'
    assign vi_subject_product = 'Equipment and sizing'
    assign vi_subject_order = 'Orders and delivery'
    assign vi_subject_returns = 'Exchanges, returns and warranty'
    assign vi_subject_partner = 'Partnerships and distribution'
    assign vi_subject_other = 'Other enquiry'
  elsif vi_lang == 'es'
    assign vi_tagline = 'CONTACTO'
    assign vi_title = 'HABLEMOS.'
    assign vi_intro = '¿Dudas sobre productos, pedidos o colaboraciones? Envíanos un mensaje.'
    assign vi_location = 'UBICACIÓN'
    assign vi_location_value = 'Portugal · Tienda online'
    assign vi_contact = 'CONTACTO'
    assign vi_form_title = 'CUÉNTANOS QUÉ NECESITAS.'
    assign vi_faq_shipping = 'Envíos y entregas'
    assign vi_faq_returns = 'Devoluciones y garantías'
    assign vi_subject_label = 'Asunto'
    assign vi_subject_prompt = 'Selecciona el asunto'
    assign vi_subject_product = 'Equipamiento y tallas'
    assign vi_subject_order = 'Pedidos y entregas'
    assign vi_subject_returns = 'Cambios, devoluciones y garantías'
    assign vi_subject_partner = 'Colaboraciones y distribución'
    assign vi_subject_other = 'Otra consulta'
  endif
-%}
<section class="boxeup-contact bx-contact vi-min-contact" aria-labelledby="BxContactTitle">
  <div class="vi-min-contact__layout vi-info-rail">
    <aside class="vi-min-contact__details">
      <p class="vi-min-eyebrow">{{ vi_tagline }}</p>
      <h1 id="BxContactTitle">{{ vi_title }}</h1>
      <p class="vi-min-contact__intro">{{ vi_intro }}</p>
      <div class="vi-min-contact__info">
        <div><strong>{{ vi_location }}:</strong><span>{{ vi_location_value }}</span></div>
        <div><strong>{{ vi_contact }}:</strong><a href="mailto:business@boxeup.com">business@boxeup.com</a></div>
      </div>
      <nav class="vi-min-contact__links" aria-label="{{ vi_contact }}">
        <a href="{{ pages['envios-e-entregas'].url | default: '/pages/envios-e-entregas' }}">{{ vi_faq_shipping }} <span aria-hidden="true">→</span></a>
        <a href="{{ pages['devolucoes-e-garantias'].url | default: '/pages/devolucoes-e-garantias' }}">{{ vi_faq_returns }} <span aria-hidden="true">→</span></a>
      </nav>
    </aside>
    <div class="vi-min-contact__form" id="BxContactFormPanel">
      <h2>{{ vi_form_title }}</h2>
      {% form 'contact', id: 'BoxeupContactForm', class: 'bx-contact__form' %}
          {% if form.posted_successfully? %}
            <div class="bx-contact__feedback bx-contact__feedback--success" role="status" tabindex="-1">
              <strong>{{ 'boxeup_sections.contact_sent' | t }}</strong>
              <p>{{ 'boxeup_sections.contact_received' | t }}</p>
            </div>
          {% endif %}
          {% if form.errors %}
            <div class="bx-contact__feedback bx-contact__feedback--error" role="alert" tabindex="-1">
              <strong>{{ 'boxeup_sections.contact_error' | t }}</strong>
              {{ form.errors | default_errors }}
            </div>
          {% endif %}
          <div class="bx-contact__fields">
            <div class="bx-contact__field">
              <label for="BoxeupContactName">{{ 'boxeup_sections.contact_name' | t }} <span>*</span></label>
              <input id="BoxeupContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" placeholder="{{ 'boxeup_sections.contact_your_name' | t }}" required>
            </div>
            <div class="bx-contact__field">
              <label for="BoxeupContactEmail">{{ 'boxeup_sections.contact_email' | t }} <span>*</span></label>
              <input id="BoxeupContactEmail" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" value="{{ form.email | escape }}" placeholder="exemplo@email.com" {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="BxContactEmailError"{% endif %} required>
              {% if form.errors contains 'email' %}<small id="BxContactEmailError">{{ 'boxeup_sections.contact_email_error' | t }}</small>{% endif %}
            </div>
            <div class="bx-contact__field bx-contact__field--wide">
              <label for="BoxeupContactSubject">{{ vi_subject_label }} <span>*</span></label>
              <select id="BoxeupContactSubject" name="contact[assunto]" required aria-required="true">
                <option value="" disabled {% if form.assunto == blank %}selected{% endif %}>{{ vi_subject_prompt }}</option>
                <option value="{{ vi_subject_product | escape }}" {% if form.assunto == vi_subject_product %}selected{% endif %}>{{ vi_subject_product }}</option>
                <option value="{{ vi_subject_order | escape }}" {% if form.assunto == vi_subject_order %}selected{% endif %}>{{ vi_subject_order }}</option>
                <option value="{{ vi_subject_returns | escape }}" {% if form.assunto == vi_subject_returns %}selected{% endif %}>{{ vi_subject_returns }}</option>
                <option value="{{ vi_subject_partner | escape }}" {% if form.assunto == vi_subject_partner %}selected{% endif %}>{{ vi_subject_partner }}</option>
                <option value="{{ vi_subject_other | escape }}" {% if form.assunto == vi_subject_other %}selected{% endif %}>{{ vi_subject_other }}</option>
              </select>
            </div>
            <div class="bx-contact__field bx-contact__field--wide">
              <label for="BoxeupContactBody">{{ 'boxeup_sections.contact_message' | t }} <span>*</span></label>
              <textarea id="BoxeupContactBody" name="contact[body]" rows="5" maxlength="1000" placeholder="{{ 'boxeup_sections.contact_message_help' | t }}" required>{{ form.body | escape }}</textarea>
              <output class="bx-contact__counter" for="BoxeupContactBody" aria-live="off"><span data-bx-contact-count>0</span> / 1000</output>
            </div>
          </div>
          <button type="submit" class="bx-contact__submit">{{ 'boxeup_sections.contact_send_message' | t }} <span aria-hidden="true">→</span></button>
          <p class="bx-contact__form-note">{{ 'boxeup_sections.contact_required' | t }}
            {% if shop.privacy_policy != blank %} · <a href="{{ shop.privacy_policy.url }}">{{ 'boxeup_sections.contact_policy' | t }}</a>{% endif %}
          </p>
        {% endform %}
    </div>
  </div>
</section>
<script>
  (() => {
    const root = document.querySelector('.vi-min-contact');
    if (!root) return;
    const message = root.querySelector('#BoxeupContactBody');
    const counter = root.querySelector('[data-bx-contact-count]');
    if (message && counter) {
      const updateCount = () => { counter.textContent = message.value.length; };
      message.addEventListener('input', updateCount);
      updateCount();
    }
  })();
</script>
{% schema %}
{
  "name": "VIRIATTO | Contactos",
  "tag": "section",
  "class": "section-boxeup-contact",
  "settings": [],
  "presets": [{"name": "VIRIATTO | Contactos"}]
}
{% endschema %}