{%- comment -%}
  SVG arrows for buttons and links. Unlike the Unicode arrows, these cannot
  fall back to emoji glyphs on iOS. Inherits the surrounding text colour.
{%- endcomment -%}
<svg class="viri-arrow-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" style="display:inline-block;vertical-align:-.13em;flex-shrink:0">
  {%- if diagonal -%}
    <path d="M5 19 19 5M7 5h12v12"/>
  {%- else -%}
    <path d="M4 12h16m-6-6 6 6-6 6"/>
  {%- endif -%}
</svg>
