{{ 'viriatto-product-details.css' | asset_url | stylesheet_tag }}
<section class="vpr-section" aria-labelledby="vpr-title-{{ section.id }}">
  <header class="vpr-header">
    <h2 id="vpr-title-{{ section.id }}">{{ 'viriatto_product.reviews' | t }}</h2>
    <p>{{ product.title | escape }}</p>
  </header>
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}{% render block %}{%- endfor -%}
  {%- elsif section.settings.show_demo -%}
    <div data-vpr-demo>
      <p class="vpr-preview-note">{{ 'viriatto_product.demo_notice' | t }}</p>
      <div class="vpr-layout">
        <aside aria-label="{{ 'viriatto_product.demo_summary' | t }}">
          <p class="vpr-score">4,6<span style="font-size:18px"> / 5</span></p>
          <div class="vpr-stars" aria-label="{{ 'viriatto_product.demo_summary' | t }}">★★★★★</div>
          <p>{{ 'viriatto_product.demo_count' | t }}</p>
          <div class="vpr-bars">
            {%- assign counts = '10,4,1,0,0' | split: ',' -%}
            {%- for count in counts -%}
              {%- assign stars = 6 | minus: forloop.index -%}
              <div class="vpr-bar"><span>{{ stars }} ★</span><progress max="15" value="{{ count }}" aria-label="{{ stars }} / 5"></progress><span>{{ count }}</span></div>
            {%- endfor -%}
          </div>
        </aside>
        <div>
          <div class="vpr-controls">
            <label for="vpr-filter-{{ section.id }}">{{ 'viriatto_product.filter_rating' | t }}</label>
            <select id="vpr-filter-{{ section.id }}" class="vpr-filter" data-vpr-filter>
              <option value="all">{{ 'viriatto_product.all_ratings' | t }}</option>
              <option value="5">5 ★</option><option value="4">4 ★</option><option value="3">3 ★</option>
            </select>
            <span data-vpr-count role="status" aria-live="polite"></span>
          </div>
          {%- assign names = 'Miguel R.,Joana S.,Tiago M.,Rita F.,André C.,Inês P.,Pedro A.,Sofia L.,Bruno T.,Mariana G.,Diogo N.,Catarina B.,Rui V.,Ana D.,Nuno E.' | split: ',' -%}
          {%- assign ratings = '5,5,4,5,5,4,5,5,3,5,4,5,5,4,5' | split: ',' -%}
          {%- for index in (1..15) -%}
            {%- liquid
              assign offset = index | minus: 1
              assign rating = ratings[offset] | plus: 0
              assign review_key = 'viriatto_review_demo.item_' | append: index
              assign title_key = review_key | append: '.title'
              assign body_key = review_key | append: '.body'
            -%}
            <article class="vpr-review" data-vpr-review data-rating="{{ rating }}"{% if index > 5 %} hidden{% endif %}>
              <div><span class="vpr-stars" aria-label="{{ rating }} / 5">{% for star in (1..5) %}{% if star <= rating %}★{% else %}☆{% endif %}{% endfor %}</span><span class="vpr-demo-badge">{{ 'viriatto_product.demo_badge' | t }}</span></div>
              <h3>{{ title_key | t }}</h3>
              <p>{{ body_key | t }}</p>
              <footer>{{ names[offset] | escape }} · {{ 'viriatto_product.fictional_profile' | t }}</footer>
            </article>
          {%- endfor -%}
          <button type="button" class="vpr-more" data-vpr-more>{{ 'viriatto_product.more_reviews' | t }}</button>
        </div>
      </div>
    </div>
  {%- else -%}
    <p class="vpr-empty">{{ 'viriatto_product.no_reviews' | t }}</p>
  {%- endif -%}
</section>
{% javascript %}
  function initViriattoReviews(scope) {
    scope.querySelectorAll('[data-vpr-demo]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = 'true';
      const filter = root.querySelector('[data-vpr-filter]');
      const more = root.querySelector('[data-vpr-more]');
      const status = root.querySelector('[data-vpr-count]');
      const reviews = [...root.querySelectorAll('[data-vpr-review]')];
      let limit = 5;
      const update = () => {
        const matching = reviews.filter((review) => filter.value === 'all' || review.dataset.rating === filter.value);
        reviews.forEach((review) => { review.hidden = !matching.includes(review) || matching.indexOf(review) >= limit; });
        more.hidden = limit >= matching.length;
        status.textContent = `${Math.min(limit, matching.length)} / ${matching.length}`;
      };
      filter.addEventListener('change', () => { limit = 5; update(); });
      more.addEventListener('click', () => {
        const firstNew = reviews.filter((review) => filter.value === 'all' || review.dataset.rating === filter.value)[limit];
        limit += 5;
        update();
        if (firstNew) { firstNew.tabIndex = -1; firstNew.focus(); }
      });
      update();
    });
  }
  initViriattoReviews(document);
  document.addEventListener('shopify:section:load', (event) => initViriattoReviews(event.target));
{% endjavascript %}
{% schema %}
{
  "name": "VIRIATTO | Avaliações",
  "tag": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "checkbox", "id": "show_demo", "label": "Mostrar 15 avaliações de demonstração", "default": true, "info": "Exemplos fictícios visíveis na loja e identificados como demonstração. Desativa esta opção quando terminares a revisão. Para avaliações reais, adiciona um bloco da tua aplicação." }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "VIRIATTO | Avaliações" }]
}
{% endschema %}
