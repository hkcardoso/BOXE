    assign vh_eyebrow = 'EQUIPAMIENTO PARA'
    assign vh_title_a = 'QUIENES'
    assign vh_title_b = 'ENTRENAN.'
    assign vh_intro = 'Guantes, protecciones, ropa y accesorios de las mejores marcas de deportes de combate.'
    assign vh_shop = 'VER PRODUCTOS'
    assign vh_video_play = 'Reproducir vídeo'
    assign vh_video_pause = 'Pausar vídeo'
    assign vh_brands = 'EXPLORAR MARCAS'
    assign vh_featured = 'DESTACADOS'
    assign vh_new = 'NOVEDADES'
    assign vh_all = 'VER TODOS'
    assign vh_delivery = 'ENTREGAS EN PORTUGAL'
    assign vh_delivery_desc = 'Portugal continental'
    assign vh_returns = 'DEVOLUCIONES'
    assign vh_returns_desc = 'Consulta las condiciones'
    assign vh_support = 'ATENCIÓN AL CLIENTE'
    assign vh_support_desc = 'Estamos para ayudarte'
    assign vh_shipping = 'ENVÍO GRATIS'
    assign vh_shipping_desc = 'En pedidos superiores a 79 €'
  endif
  assign vh_featured_products = section.settings.featured_products | default: section.settings.featured_collection.products | default: collections['all'].products
  assign vh_latest_products = collections['all'].products | sort: 'created_at' | reverse
-%}

<style>
  /* 2026 VIRIATTO homepage — compact premium commerce layout */
  .section-boxeup-home{background:#0c0d0f!important}
  .vh-home,.vh-home *{box-sizing:border-box}
  .vh-home{background:#0c0d0f;color:#f6f6f7;font-family:var(--font-body-family,Arial,sans-serif);overflow:hidden}
  .vh-home a{color:inherit;text-decoration:none}
  .vh-frame{width:min(100%,1440px);margin-inline:auto;padding-inline:clamp(18px,8vw,120px)}
  .vh-hero{height:clamp(390px,34vw,530px);min-height:390px;position:relative;isolation:isolate;display:flex;align-items:center;overflow:hidden;background:#08090b}
  .vh-hero__media{position:absolute;inset:0;z-index:-2;overflow:hidden;background:#08090b}
  .vh-hero__image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 43%;z-index:0}
  .vh-hero__video{display:block;position:absolute;inset:0;z-index:1;width:100%;height:100%;object-fit:cover;object-position:center 43%;background:transparent;opacity:0;transition:opacity .3s ease;pointer-events:none}
  .vh-hero--video-ready .vh-hero__video{opacity:1}
  .vh-hero__video-toggle{position:absolute;z-index:5;right:clamp(18px,3vw,40px);bottom:20px;display:grid;place-items:center;width:42px;height:42px;padding:10px;color:#fff;border:1px solid rgba(255,255,255,.45);border-radius:50%;background:rgba(12,14,17,.6);cursor:pointer;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);transition:background .2s,border-color .2s}
  .vh-hero__video-toggle:hover,.vh-hero__video-toggle:focus-visible{background:rgba(32,35,41,.85);border-color:#fff}
  .vh-hero__video-toggle svg{display:block;width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .vh-hero__video-toggle .vh-hero__icon-pause{display:none}
  .vh-hero__video-toggle[data-state="playing"] .vh-hero__icon-play{display:none}
  .vh-hero__video-toggle[data-state="playing"] .vh-hero__icon-pause{display:block}
  .vh-hero:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(1,2,4,.95) 0%,rgba(1,2,4,.85) 25%,rgba(1,2,4,.55) 47%,rgba(1,2,4,.07) 79%),linear-gradient(0deg,rgba(0,0,0,.48),transparent 34%);z-index:-1}
  .vh-hero__inner{position:relative;width:100%;padding-block:56px 64px}
  .vh-hero__copy{max-width:700px}
  .vh-eyebrow{font-size:12px;letter-spacing:.35em;font-weight:600;margin:0 0 10px;color:#d9d9df}
  .vh-title{font-family:'Benzin',var(--font-heading-family,Arial,sans-serif);font-weight:800;font-size:clamp(52px,5.9vw,96px);letter-spacing:-.055em;line-height:.96;margin:0;color:#fff;text-transform:uppercase}
  .vh-intro{font-size:clamp(13px,1.15vw,16px);line-height:1.46;color:#d5d6db;max-width:440px;margin:18px 0 22px}
  .vh-actions{display:flex;gap:11px;flex-wrap:wrap}
  .vh-button{min-height:39px;padding:10px 18px;display:inline-flex;align-items:center;justify-content:center;gap:17px;border:1px solid rgba(255,255,255,.65);font-size:11px;font-weight:750;letter-spacing:.025em;border-radius:3px;transition:background .18s,border-color .18s,transform .18s}
  .vh-button svg{width:15px;height:15px}
  .vh-button:hover{transform:translateY(-2px)}
  .vh-button--primary{color:#111215!important;background:#fff;border-color:#fff}
  .vh-button--primary:hover{background:#d9d9dc}
  .vh-button--secondary{background:rgba(3,4,6,.38);color:#fff!important}
  .vh-button--secondary:hover{background:rgba(255,255,255,.14)}
  .vh-hero__dash{position:absolute;bottom:18px;left:50%;transform:translateX(-50%);display:flex;gap:7px}
  .vh-hero__dash span{width:29px;height:3px;background:rgba(255,255,255,.32);border-radius:8px}
  .vh-hero__dash span:first-child{background:#fff}
  .vh-brands{border-top:1px solid #2e3034;border-bottom:1px solid #2e3034;background:#0b0c0e}
  .vh-brands__inner{display:grid;grid-template-columns:repeat(9,minmax(0,1fr));align-items:center;gap:clamp(10px,1.8vw,25px);min-height:86px}
  .vh-brand{display:flex;align-items:center;justify-content:center;min-height:67px;opacity:.82;transition:opacity .2s,transform .2s}
  .vh-brand:hover{opacity:1;transform:translateY(-2px)}
  .vh-brand img{display:block;width:100%;max-width:105px;height:46px;object-fit:contain;filter:grayscale(1)}
  .vh-brand__word{color:#fff;font-family:'Benzin',Arial,sans-serif;font-size:clamp(12px,1.05vw,17px);font-weight:750;letter-spacing:-.05em;text-align:center;line-height:1.05}
  .vh-brand__word small{font-size:8px;display:block;letter-spacing:.12em}
  .vh-products{padding-block:19px 3px}
  .vh-products + .vh-products{padding-block:14px 22px}
  .vh-products__heading{display:flex;justify-content:space-between;align-items:center;gap:16px;margin:0 0 13px}
  .vh-products__heading h2{font-family:'Benzin',var(--font-heading-family,Arial,sans-serif);font-weight:800;letter-spacing:-.035em;font-size:clamp(18px,2vw,26px);line-height:1.18;margin:0;color:#f7f7f7}
  .vh-products__all{display:inline-flex;gap:8px;align-items:center;flex-shrink:0;color:#e7e7e9!important;letter-spacing:.04em;font-size:10px;font-weight:700;text-transform:uppercase}
  .vh-products__all svg{width:13px;height:13px;transition:transform .15s}
  .vh-products__all:hover svg{transform:translateX(3px)}
  .vh-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}
  .vh-card{min-width:0;background:#141518;border:1px solid #2e3034;border-radius:4px;overflow:hidden;display:flex;flex-direction:column;transition:border-color .2s,transform .2s}
  .vh-card:hover{border-color:#696b70;transform:translateY(-2px)}
  .vh-card__media{position:relative;display:block;aspect-ratio:1.12/1;background:radial-gradient(ellipse at 47% 32%,#3b3d40 0%,#27292c 49%,#161719 100%);overflow:hidden}
  .vh-card__image,.vh-card__placeholder{width:100%;height:100%;object-fit:contain;display:block;transition:transform .25s;mix-blend-mode:multiply;filter:contrast(1.13) brightness(1.22)}
  .vh-card__image{padding:3%}
  .vh-card:hover .vh-card__image{transform:scale(1.055)}
  .vh-card__badge{position:absolute;top:8px;left:8px;z-index:2;font-size:9px;font-weight:700;padding:4px 6px;background:#ca2438;color:#fff}
  .vh-card__badge--muted{background:#44464b}
  .vh-card__body{padding:9px 10px 10px;min-height:110px;display:flex;flex-direction:column;flex:1}
  .vh-card__vendor{color:#b8b9bd;font-size:9px;font-weight:700;letter-spacing:.045em;text-transform:uppercase;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .vh-card__title{font-size:12px;font-weight:700;line-height:1.24;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .vh-card__type{font-size:9px;color:#a6a7ad;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px}
  .vh-card__end{margin-top:auto;padding-top:8px;display:flex;align-items:flex-end;justify-content:space-between;gap:6px}
  .vh-card__price{display:flex;gap:5px;flex-wrap:wrap;align-items:baseline}
  .vh-card__price strong{color:#fff;font-size:12px;font-weight:800;white-space:nowrap}
  .vh-card__price del{font-size:10px;color:#929399;white-space:nowrap}
  .vh-card__add{flex:0 0 30px;width:30px;height:30px;border:1px solid #66686e;border-radius:3px;background:transparent;color:#fff;display:grid;place-items:center;cursor:pointer;transition:background .2s,border-color .2s}
  .vh-card__add:hover{background:#fff;color:#111;border-color:#fff}
  .vh-card__add svg{width:17px;height:17px}
  .vh-card__add--disabled{opacity:.4}
  .vh-trust{border-top:1px solid #2d2e32;border-bottom:1px solid #2d2e32;margin-top:6px}
  .vh-trust__inner{min-height:63px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;align-items:center}
  .vh-trust__item{display:flex;gap:10px;align-items:center;min-width:0}
  .vh-trust__item svg{width:23px;height:23px;flex:0 0 23px;stroke:#f2f2f3;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
  .vh-trust__item strong{font-size:10px;color:#f8f8f8;display:block;line-height:1.35}
  .vh-trust__item small{font-size:9px;color:#a9aaaf;display:block}
  .vh-empty{font-size:13px;color:#b1b2b7;border:1px dashed #3a3b41;padding:28px;margin:0}
  /* The reference uses a two-level desktop header with visible search. */
  @media(min-width:990px){
    body:has(.vh-home) .header-wrapper{background:#08090b!important;border-bottom:0!important}
    body:has(.vh-home) .header{max-width:1440px!important;padding:6px clamp(18px,8vw,120px) 0!important;min-height:102px!important;display:grid!important;grid-template-columns:minmax(190px,230px) minmax(280px,1fr) auto!important;grid-template-rows:54px 38px!important;gap:0 22px!important;align-items:center!important}
    body:has(.vh-home) .header__heading,body:has(.vh-home) .header__heading-link{grid-row:1!important;grid-column:1!important;justify-self:start!important;align-self:center}
    body:has(.vh-home) .vh-header-search{grid-row:1;grid-column:2;display:block;width:min(100%,570px);justify-self:start}
    body:has(.vh-home) .header__icons{grid-row:1!important;grid-column:3!important;justify-self:end!important}
    body:has(.vh-home) .header__inline-menu{grid-row:2!important;grid-column:1/-1!important;justify-self:start!important;align-self:center!important;display:block!important}
    body:has(.vh-home) .header__inline-menu .list-menu--inline{gap:clamp(4px,1.2vw,18px)}
    body:has(.vh-home) .header__inline-menu .header__menu-item{font-size:12px!important;padding:8px 12px!important}
    body:has(.vh-home) .header__search{display:none!important}
    body:has(.vh-home) .header__heading-logo{max-height:43px;width:auto}
  }
  .vh-header-search{display:none}
  .vh-header-search__form{display:flex;align-items:center;gap:11px;width:100%;height:36px;border-radius:4px;background:#232528;border:1px solid #52545a;padding:0 12px;color:#fff}
  .vh-header-search__form svg{width:17px;height:17px;flex-shrink:0;stroke:#f7f7f8;fill:none;stroke-width:1.8}
  .vh-header-search__form input{background:transparent;border:0;outline:0;color:#fff;font-family:inherit;font-size:12px;width:100%;height:100%}
  .vh-header-search__form input::placeholder{color:#bdbec4}
  .vh-header-search__form:focus-within{border-color:#fff}
  @media(min-width:750px) and (max-width:1100px){
    .vh-brands__inner{gap:8px}
    .vh-grid{gap:9px}
    .vh-card__body{padding:8px}
  }
  @media(max-width:989px){
    .vh-brands__inner{display:flex;overflow-x:auto;gap:24px;scrollbar-width:none;min-height:78px}
    .vh-brand{min-width:94px;flex:0 0 auto}
    .vh-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
    .vh-trust__inner{grid-template-columns:repeat(2,minmax(0,1fr));padding-block:16px;gap:20px}
  }
  @media(max-width:749px){
    .vh-hero{height:clamp(490px,130vw,620px);min-height:490px;align-items:flex-end}
    .vh-hero__image,.vh-hero__video{object-position:66% center}
    .vh-hero__video-toggle{right:18px;bottom:16px;width:40px;height:40px}
    .vh-hero:before{background:linear-gradient(0deg,rgba(1,2,4,.95) 0%,rgba(1,2,4,.81) 25%,rgba(1,2,4,.48) 59%,rgba(1,2,4,.12) 100%)}
    .vh-hero__inner{padding-bottom:70px;padding-top:40px}
    .vh-hero__copy{max-width:100%}
    .vh-eyebrow{font-size:10px;letter-spacing:.25em}
    .vh-title{font-size:clamp(41px,9.4vw,67px)}
    .vh-intro{font-size:13px;max-width:335px}
    .vh-button{font-size:10px;padding:10px 12px;gap:9px}
    .vh-hero__dash{bottom:17px}
    .vh-products{padding-top:22px}
    .vh-products__heading h2{font-size:18px}
    .vh-products__all{font-size:9px}
    .vh-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
    .vh-card__media{aspect-ratio:1/1}
    .vh-card__title{font-size:11px}
    .vh-card__body{min-height:105px;padding:8px}
    .vh-card__end{gap:2px}
    .vh-card__price strong{font-size:11px}
    .vh-trust__item{gap:8px}
    .vh-trust__item svg{width:19px;height:19px;flex-basis:19px}
    .vh-trust__item strong{font-size:9px}
    .vh-trust__item small{font-size:8px}
  }
  @media(prefers-reduced-motion:reduce){.vh-home a,.vh-home img,.vh-home button{transition:none!important}}

  /* VIRIATTO 2026 — header, spacing and card polish */
  .vh-home .vh-frame{width:min(100%,1600px);padding-inline:clamp(20px,5vw,96px)}
  .vh-home .vh-products{padding-block:24px 5px}
  .vh-home .vh-products + .vh-products{padding-block:23px 28px}
  .vh-home .vh-products__heading{margin-bottom:15px}
  .vh-home .vh-grid{grid-template-columns:repeat(5,minmax(0,1fr));gap:16px}
  .vh-home .vh-card{
    background:#151619;border:1px solid #303238;border-radius:5px;
    box-shadow:0 2px 13px rgba(0,0,0,.12);
    transition:transform .22s ease,border-color .22s ease,box-shadow .22s ease;
  }
  .vh-home .vh-card:hover{transform:translateY(-3px);border-color:#666a70;box-shadow:0 12px 27px rgba(0,0,0,.3)}
  .vh-home .vh-card__media{
    aspect-ratio:1 / 1.02;
    background:radial-gradient(ellipse at 50% 34%,#53555a 0%,#36383c 48%,#232529 100%);
    padding:6px;overflow:hidden
  }
  .vh-home .vh-card__image{
    display:block;width:100%;height:100%;object-fit:contain;
    padding:1%;mix-blend-mode:multiply;
    mix-blend-mode:normal!important; filter:none!important; background:#27282b;
    transition:transform .28s ease,filter .28s ease
  }
  .vh-home .vh-card:hover .vh-card__image{
    transform:scale(1.045);
    filter:none!important
  }
  .vh-home .vh-card__body{padding:12px 13px 13px;min-height:129px}
  .vh-home .vh-card__vendor{font-size:10px;letter-spacing:.05em;color:#aaaeb6;margin-bottom:4px}
  .vh-home .vh-card__title{font-size:13px;font-weight:700;line-height:1.32;min-height:34px}
  .vh-home .vh-card__type{font-size:10px;color:#9fa3ad;margin-top:3px}
  .vh-home .vh-card__end{padding-top:10px;align-items:center;gap:8px}
  .vh-home .vh-card__price strong{font-size:14px}
  .vh-home .vh-card__price del{font-size:11px}
  .vh-home .vh-card__add{flex-basis:34px;width:34px;height:34px;border-radius:4px}
  .vh-home .vh-card__add svg{width:19px;height:19px}
  body #MainContent .section-boxeup-home .vh-title{
    font-family:'Benzin',Arial,Helvetica,sans-serif!important;
    font-size:clamp(53px,6vw,104px)!important;
    font-weight:700!important;
    line-height:.94!important;
    letter-spacing:-.07em!important;
    text-wrap:balance
  }
  .vh-home .vh-eyebrow{font-weight:600;letter-spacing:.3em;margin-bottom:14px}
  .vh-home .vh-hero__copy{max-width:850px}
  .vh-home .vh-hero{height:clamp(460px,37vw,570px);min-height:460px}
  .vh-home .vh-hero__inner{padding-block:78px 74px}
  .vh-home .vh-hero:before{
    background:linear-gradient(90deg,rgba(2,3,5,.93) 0%,rgba(2,3,5,.82) 24%,rgba(2,3,5,.43) 49%,rgba(2,3,5,.02) 79%),
      linear-gradient(0deg,rgba(0,0,0,.38),transparent 43%)
  }
  @media(min-width:990px){
    body:has(.vh-home) .header-wrapper{
      background:linear-gradient(180deg,rgba(8,9,12,.97),rgba(9,10,13,.88))!important;
      border-bottom:1px solid rgba(255,255,255,.08)!important;
      backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)
    }
    body:has(.vh-home) .header{
      max-width:1600px!important;
      margin-inline:auto!important;
      padding:6px clamp(20px,5vw,96px) 4px!important;
      min-height:106px!important;
      display:grid!important;
      grid-template-columns:minmax(180px,220px) minmax(280px,1fr) auto!important;
      grid-template-rows:58px 38px!important;
      grid-template-areas:"brand search icons" "nav nav nav"!important;
      column-gap:clamp(18px,3vw,42px)!important;
      row-gap:0!important;
      align-items:center!important
    }
    body:has(.vh-home) .header .header__heading{grid-area:brand!important;align-self:center!important;justify-self:start!important;margin:0!important;min-width:0}
    body:has(.vh-home) .header > .header__heading-link{grid-area:brand!important;justify-self:start!important}
    body:has(.vh-home) .header .vh-header-search{
      grid-area:search!important;
      display:block!important;width:min(100%,660px)!important;
      min-width:0!important;justify-self:center!important;
      margin:0!important;position:relative!important;z-index:2
    }
    body:has(.vh-home) .header .header__icons{grid-area:icons!important;justify-self:end!important;align-self:center!important;margin:0!important}
    body:has(.vh-home) .header .header__inline-menu{
      grid-area:nav!important;grid-row:2!important;grid-column:1/-1!important;
      justify-self:start!important;align-self:center!important;
      display:block!important;position:relative!important;
      margin:0!important;padding:0!important;transform:none!important;z-index:5
    }
    body:has(.vh-home) .header .header__inline-menu .list-menu--inline{
      display:flex!important;flex-wrap:nowrap!important;
      gap:clamp(10px,1.6vw,24px)!important;align-items:center!important
    }
    body:has(.vh-home) .header__inline-menu .header__menu-item{
      font-size:12px!important;font-weight:600!important;padding:9px 5px!important;
      white-space:nowrap!important;opacity:.96;letter-spacing:.01em!important
    }
    body:has(.vh-home) .header .header__search{display:none!important}
    body:has(.vh-home) .header .viriatto-site-logo{
