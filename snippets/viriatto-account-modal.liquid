{% comment %}
  VIRIATTO — branded sign-in UI on top of Shopify Customer Accounts.
  The store never handles passwords, verification codes or OAuth tokens.
  Email uses Shopify's supported login_hint and login_hint_mode=submit flow.
  Google goes to Shopify's official provider chooser. Shop uses Shopify's native login_button.
{% endcomment %}
{%- liquid
  assign viri_lang = request.locale.iso_code | slice: 0, 2
  assign viri_heading = 'Iniciar sessão ou criar conta'
  assign viri_intro = 'Acede às tuas encomendas e aos teus dados.'
  assign viri_email_label = 'E-mail'
  assign viri_email_placeholder = 'O teu endereço de e-mail'
  assign viri_email_continue = 'Continuar com e-mail'
  assign viri_or = 'ou'
  assign viri_google = 'Continuar com Google'
  assign viri_shop = 'Continuar com Shop'
  assign viri_google_note = 'A seleção de Google é feita na página segura da Shopify.'
  assign viri_orders = 'Encomendas'
  assign viri_profile = 'Perfil'
  assign viri_close = 'Fechar'
  if viri_lang == 'en'
    assign viri_heading = 'Sign in or create an account'
    assign viri_intro = 'Access your orders and account details.'
    assign viri_email_label = 'Email'
    assign viri_email_placeholder = 'Your email address'
    assign viri_email_continue = 'Continue with email'
    assign viri_or = 'or'
    assign viri_google = 'Continue with Google'
    assign viri_shop = 'Continue with Shop'
    assign viri_google_note = 'Select Google on Shopify’s secure sign-in page.'
    assign viri_orders = 'Orders'
    assign viri_profile = 'Profile'
    assign viri_close = 'Close'
  elsif viri_lang == 'es'
    assign viri_heading = 'Iniciar sesión o crear una cuenta'
    assign viri_intro = 'Accede a tus pedidos y datos.'
    assign viri_email_label = 'Correo electrónico'
    assign viri_email_placeholder = 'Tu correo electrónico'
    assign viri_email_continue = 'Continuar con correo'
    assign viri_or = 'o'
    assign viri_google = 'Continuar con Google'
    assign viri_shop = 'Continuar con Shop'
    assign viri_google_note = 'Selecciona Google en la página segura de Shopify.'
    assign viri_orders = 'Pedidos'
    assign viri_profile = 'Perfil'
    assign viri_close = 'Cerrar'
  endif
  assign viri_account_parts = routes.account_url | split: '?'
-%}
<div
  id="ViriattoAuthDialog-{{ section.id }}"
  class="viriatto-auth"
  role="dialog"
  aria-modal="false"
  aria-hidden="true"
  inert
  aria-labelledby="ViriattoAuthTitle-{{ section.id }}"
  aria-describedby="ViriattoAuthIntro-{{ section.id }}"
  data-viri-auth
>
  <div class="viriatto-auth__shell">
    <div class="viriatto-auth__top">
      <div>
        <span class="viriatto-auth__eyebrow">VIRIATTO / ACCOUNT</span>
        <h2 id="ViriattoAuthTitle-{{ section.id }}" class="viriatto-auth__title">{{ viri_heading }}</h2>
      </div>
      <button class="viriatto-auth__close" type="button" data-viri-auth-close aria-label="{{ viri_close }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <p class="viriatto-auth__intro" id="ViriattoAuthIntro-{{ section.id }}">{{ viri_intro }}</p>

    <form class="viriatto-auth__form" method="get" action="{{ routes.storefront_login_url }}" data-viri-auth-email-form>
      <label class="viriatto-auth__label" for="ViriattoAuthEmail-{{ section.id }}">{{ viri_email_label }}</label>
      <input id="ViriattoAuthEmail-{{ section.id }}" type="email" name="login_hint" class="viriatto-auth__input"
        placeholder="{{ viri_email_placeholder }}" autocomplete="email" inputmode="email" required>
      <input type="hidden" name="login_hint_mode" value="submit">
      <button type="submit" class="viriatto-auth__button viriatto-auth__button--primary">
        {{ viri_email_continue }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6"/></svg>
      </button>
    </form>

    <div class="viriatto-auth__separator"><span>{{ viri_or }}</span></div>

    <a href="{{ routes.storefront_login_url }}" class="viriatto-auth__button viriatto-auth__button--google" data-viri-auth-google>
      <svg class="viriatto-auth__google-icon" viewBox="0 0 48 48" aria-hidden="true">
        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.77 7.18l7.73 6C44.41 38.03 46.98 31.88 46.98 24.55z"/>
        <path fill="#FBBC05" d="M10.53 28.59A14.5 14.5 0 0 1 9.75 24c0-1.6.27-3.14.76-4.59l-7.98-6.2A23.9 23.9 0 0 0 0 24c0 3.87.93 7.52 2.56 10.78l7.97-6.19z"/>
        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.9-5.8l-7.73-6c-2.14 1.44-4.88 2.3-8.17 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.97 6.19C6.5 42.62 14.62 48 24 48z"/>
      </svg>
      <span>{{ viri_google }}</span>
    </a>
    <p class="viriatto-auth__provider-note">{{ viri_google_note }}</p>

    <div class="viriatto-auth__shop">
      {{ shop | login_button: action: 'default' }}
    </div>

    <div class="viriatto-auth__links">
      <a href="{{ routes.account_url }}">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="6" width="16" height="15" rx="2"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>
        {{ viri_orders }}
      </a>
      <a href="{{ viri_account_parts.first }}/profile{% if viri_account_parts.size > 1 %}?{{ viri_account_parts.last }}{% endif %}">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="9" r="3"/><path d="M6.5 19c.8-3.2 3-4.8 5.5-4.8s4.7 1.6 5.5 4.8"/></svg>
        {{ viri_profile }}
      </a>
    </div>
  </div>
</div>

<style>
  /* Branded custom shell. Shopify continues to own sign-in and the account session. */
  /* Click-only account dropdown below header, matching the cart's downward reveal. */
  .viriatto-auth{
    position:fixed;
    top:var(--viri-auth-top,100px);
    right:var(--viri-auth-right,24px);
    z-index:9999;
    width:min(430px,calc(100vw - 24px));
    max-width:calc(100vw - 24px);
    max-height:calc(100dvh - var(--viri-auth-top,100px) - 12px);
    margin:0;
    padding:0;
    overflow-x:hidden;
    overflow-y:auto;
    background:#151618;
    color:#f9f9f9;
    border:1px solid #303236;
    border-radius:16px;
    box-shadow:0 22px 50px rgba(0,0,0,.55);
    font-family:var(--font-body-family,Arial,sans-serif);
    opacity:0;
    visibility:hidden;
    transform:translateY(-14px);
    pointer-events:none;
    transition:opacity .22s ease,transform .25s cubic-bezier(.2,.8,.2,1),visibility .25s;
  }
  .viriatto-auth.is-open{
    opacity:1;
    visibility:visible;
    transform:translateY(0);
    pointer-events:auto;
  }
  .viriatto-auth__shell{padding:27px 28px 24px}
  .viriatto-auth__top{display:flex;align-items:flex-start;justify-content:space-between;gap:15px}
  .viriatto-auth__eyebrow{display:block;margin-bottom:8px;font-size:10px;letter-spacing:.18em;font-weight:650;color:#aeb0b6}
  .viriatto-auth__title{margin:0;font-family:var(--font-body-family,Arial,sans-serif);font-size:23px;letter-spacing:-.045em;line-height:1.2;font-weight:700;color:#f6f6f6}
  .viriatto-auth__close{flex:0 0 34px;width:34px;height:34px;padding:7px;display:grid;place-items:center;border:0;border-radius:50%;background:#282a2e;color:#e8e8ea;cursor:pointer}
  .viriatto-auth__close:hover{background:#383a40}
  .viriatto-auth__close svg{width:20px;height:20px}
  .viriatto-auth__intro{margin:12px 0 24px;font-size:12px;line-height:1.5;color:#aeb0b6}
  .viriatto-auth__form{display:grid;gap:10px}
  .viriatto-auth__label{font-size:11px;font-weight:650;color:#d2d2d5;letter-spacing:.015em}
  .viriatto-auth__input{display:block;width:100%;min-width:0;height:48px;padding:0 16px!important;background:#242629!important;border:1px solid #55575e!important;border-radius:9px!important;box-shadow:none!important;color:#fff!important;outline:none!important;font-size:14px!important;font-family:inherit}
  .viriatto-auth__input::placeholder{color:#91949b}
  .viriatto-auth__input:focus{border-color:#f5f5f5!important}
  .viriatto-auth__button{display:flex;align-items:center;justify-content:center;gap:12px;min-height:46px;padding:10px 16px;border-radius:9px;text-decoration:none!important;font-family:inherit;font-size:12px;font-weight:680;line-height:1.35;cursor:pointer;transition:background .2s,border-color .2s}
  .viriatto-auth__button--primary{width:100%;border:1px solid #f5f5f6;background:#f5f5f6;color:#101113}
  .viriatto-auth__button--primary:hover{background:#dedee1}
  .viriatto-auth__button--primary svg{width:15px;height:15px;margin-left:auto}
  .viriatto-auth__button--google{width:100%;background:#222428;border:1px solid #4a4d53;color:#f6f6f8!important}
  .viriatto-auth__button--google:hover{background:#2b2d32;border-color:#666970}
  .viriatto-auth__google-icon{width:19px;height:19px;flex:0 0 19px}
  .viriatto-auth__separator{display:flex;align-items:center;gap:12px;margin:20px 0;color:#a4a5ad;font-size:11px;text-transform:uppercase}
  .viriatto-auth__separator:before,.viriatto-auth__separator:after{content:"";height:1px;flex:1;background:#373940}
  .viriatto-auth__provider-note{margin:8px 0 19px;color:#8c8f98;font-size:10px;line-height:1.5;text-align:center}
  .viriatto-auth__shop{width:100%;display:flex;justify-content:center;min-height:47px}
  .viriatto-auth__shop>*{width:100%!important;max-width:100%!important;min-height:45px}
  .viriatto-auth__links{display:grid;grid-template-columns:1fr 1fr;gap:11px;border-top:1px solid #36383d;margin-top:22px;padding-top:22px}
  .viriatto-auth__links a{display:flex;align-items:center;justify-content:center;gap:9px;min-height:41px;border:1px solid #484b51;border-radius:10px;text-decoration:none!important;color:#f4f4f5!important;font-weight:550;font-size:11px;transition:background .2s}
  .viriatto-auth__links a:hover{background:#282a2e}
  .viriatto-auth__links svg{width:17px;height:17px}
  .viriatto-auth__input:focus-visible,.viriatto-auth__button:focus-visible,.viriatto-auth__close:focus-visible,.viriatto-auth__links a:focus-visible{outline:2px solid #fff!important;outline-offset:3px!important}
  @media(max-width:480px){.viriatto-auth{right:12px!important;left:12px!important;width:auto;max-width:none}.viriatto-auth__shell{padding:23px 19px 20px}.viriatto-auth__title{font-size:21px}.viriatto-auth__intro{margin-bottom:19px}}
  @media(prefers-reduced-motion:reduce){.viriatto-auth,.viriatto-auth__button,.viriatto-auth__links a{transition:none}}
</style>

<script>
  (function() {
    const sectionId = {{ section.id | json }};
    const panel = document.getElementById('ViriattoAuthDialog-' + sectionId);
    if (!panel || panel.dataset.viriReady === 'true') return;
    panel.dataset.viriReady = 'true';
    let opener = null;
    let isOpen = false;

    function positionPanel() {
      if (!opener || !opener.isConnected) return;
      const header = opener.closest('.header-wrapper') || opener;
      const headerBottom = header.getBoundingClientRect().bottom;
      const viewportWidth = window.innerWidth;
      const triggerRight = opener.getBoundingClientRect().right;
      const top = Math.max(8, Math.round(headerBottom) + 5);
      const right = Math.max(12, Math.round(viewportWidth - triggerRight));
      panel.style.setProperty('--viri-auth-top', top + 'px');
      panel.style.setProperty('--viri-auth-right', right + 'px');
    }

    function openPanel(trigger) {
      if (isOpen) return;
      opener = trigger;
      positionPanel();
      panel.inert = false;
      panel.setAttribute('aria-hidden', 'false');
      panel.classList.add('is-open');
      opener.setAttribute('aria-expanded', 'true');
      isOpen = true;
      const emailInput = panel.querySelector('input[type="email"]');
      if (emailInput) emailInput.focus({preventScroll: true});
    }

    function closePanel(restoreFocus) {
      if (!isOpen) return;
      panel.classList.remove('is-open');
      panel.setAttribute('aria-hidden', 'true');
      panel.inert = true;
      isOpen = false;
      if (opener && opener.isConnected) {
        opener.setAttribute('aria-expanded', 'false');
        if (restoreFocus) opener.focus({preventScroll: true});
      }
    }

    document.addEventListener('click', function(event) {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest('[data-viri-auth-open]');
      if (trigger && trigger.getAttribute('aria-controls') === panel.id) {
        event.preventDefault();
        if (isOpen) closePanel(true);
        else openPanel(trigger);
        return;
      }
      if (!isOpen) return;
      if (target.closest('[data-viri-auth-close]') && panel.contains(target)) {
        closePanel(true);
        return;
      }
      if (!panel.contains(target)) closePanel(false);
    });

    document.addEventListener('keydown', function(event) {
      if (isOpen && event.key === 'Escape') {
        event.preventDefault();
        closePanel(true);
      }
    });

    window.addEventListener('resize', function() {
      if (isOpen) positionPanel();
    });
    window.addEventListener('scroll', function() {
      if (isOpen) positionPanel();
    }, {passive: true});

    const emailForm = panel.querySelector('[data-viri-auth-email-form]');
    if (emailForm) {
      emailForm.addEventListener('submit', function(event) {
        event.preventDefault();
        const emailField = emailForm.querySelector('input[type="email"]');
        if (!emailField || !emailForm.reportValidity()) return;
        const target = new URL(emailForm.action, window.location.origin);
        target.searchParams.set('login_hint', emailField.value.trim());
        target.searchParams.set('login_hint_mode', 'submit');
        target.searchParams.set('return_to', window.location.pathname + window.location.search);
        window.location.assign(target.href);
      });
    }
  })();
</script>
