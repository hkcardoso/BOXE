{% comment %}BOXEUP — full-bleed dark background behind the centered category controls.{% endcomment %}
<section id="boxeup-catalog-filters" class="boxeup-catalog-controls page-width" aria-label="{{ 'boxeup_navigation.categories' | t }}">
  <h2 class="visually-hidden">{{ 'boxeup_navigation.heading' | t }}</h2>
  <nav class="boxeup-chip-list" aria-label="{{ 'boxeup_navigation.categories' | t }}">
    <a class="boxeup-chip" data-boxeup-catalog href="{{ routes.all_products_collection_url }}"{% if collection.handle == 'all' %} aria-current="page"{% endif %}>{{ 'boxeup_navigation.all' | t }}</a>
    {% assign category_handles = 'luvas-de-boxe-e-muay-thai,caneleiras-de-muay-thai-e-kickboxing,boqueiras-e-protecoes,vestuario-e-fightwear,mochilas-e-sacos-de-treino-1,equipamento-de-treino' | split: ',' %}
    {% assign category_labels = 'luvas,caneleiras,boqueiras,roupa,mochilas,treino' | split: ',' %}
    {% for category_handle in category_handles %}
      {% assign category = collections[category_handle] %}
      {% assign label_key = 'boxeup_navigation.' | append: category_labels[forloop.index0] %}
      {% if category != blank %}<a class="boxeup-chip" data-boxeup-catalog href="{{ category.url }}"{% if collection.handle == category_handle %} aria-current="page"{% endif %}>{{ label_key | t }}</a>{% endif %}
    {% endfor %}
  </nav>
  <details class="bx-brand-directory" id="BxBrands"><summary>{{ 'boxeup_experience.brands' | t }} <span aria-hidden="true">+</span></summary><nav aria-label="{{ 'boxeup_experience.brand_navigation' | t }}">
    {% assign bx_brand_handles = 'fairtex,charlie,buddha,venum,cleto-reyes,rival,twins,everlast' | split: ',' %}
    {% for handle in bx_brand_handles %}
      {% assign bx_brand = collections[handle] %}
      {% assign bx_brand_visible = false %}
      {% for bx_item in bx_brand.products %}
        {% assign bx_vendor = bx_item.vendor | downcase %}
        {% unless bx_item.price == 0 or bx_vendor == 'my store' or bx_item.tags contains 'boxeup:hidden' %}
          {% assign bx_brand_visible = true %}
          {% break %}
        {% endunless %}
      {% endfor %}
      {% if bx_brand_visible %}
        {% assign bx_logo_handle = handle | replace: 'cleto-reyes', 'reyes' %}
        {% assign bx_brand_logo = 'boxeup-brand-' | append: bx_logo_handle | append: '.svg' %}
        <a data-boxeup-catalog href="{{ bx_brand.url }}" aria-label="{{ bx_brand.title | escape }}"{% if collection.handle == handle %} aria-current="page"{% endif %}>
          <img class="bx-brand-directory__logo" src="{{ bx_brand_logo | asset_url }}" alt="{{ bx_brand.title | escape }}" width="120" height="64" loading="lazy">
        </a>
      {% endif %}
    {% endfor %}
  </nav></details>
  {% comment %}
    On phones, display the same brand logo links directly above the filters.
    Desktop retains the existing collapsible brand directory.
  {% endcomment %}
  <nav class="bx-mobile-brand-strip" aria-label="{{ 'boxeup_experience.brand_navigation' | t }}">
    {% for handle in bx_brand_handles %}
      {% assign bx_brand = collections[handle] %}
      {% assign bx_brand_visible = false %}
      {% for bx_item in bx_brand.products %}
        {% assign bx_vendor = bx_item.vendor | downcase %}
        {% unless bx_item.price == 0 or bx_vendor == 'my store' or bx_item.tags contains 'boxeup:hidden' %}
          {% assign bx_brand_visible = true %}
          {% break %}
        {% endunless %}
      {% endfor %}
      {% if bx_brand_visible %}
        {% assign bx_logo_handle = handle | replace: 'cleto-reyes', 'reyes' %}
        {% assign bx_brand_logo = 'boxeup-brand-' | append: bx_logo_handle | append: '.svg' %}
        <a data-boxeup-catalog href="{{ bx_brand.url }}" aria-label="{{ bx_brand.title | escape }}"{% if collection.handle == handle %} aria-current="page"{% endif %}>
          <img src="{{ bx_brand_logo | asset_url }}" alt="{{ bx_brand.title | escape }}" width="120" height="64" loading="lazy">
        </a>
      {% endif %}
    {% endfor %}
  </nav>
  <div class="bx-tools-row">
    <button type="button" class="bx-text-button" data-bx-open="BxGuide">{{ 'boxeup_experience.guide' | t }} <span class="bx-inline-arrow" aria-hidden="true"><svg class="bxv2-arrow-svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M5 19 19 5M8 5h11v11"/></svg></span></button>
    <button type="button" class="bx-text-button" data-bx-open="BxSizeGuide">{{ 'boxeup_experience.size_guide' | t }}</button>
  </div>
  <p class="boxeup-catalog-message" role="status" aria-live="polite" data-loading="{{ 'boxeup_navigation.loading' | t }}" data-loaded="{{ 'boxeup_navigation.loaded' | t }}" data-error="{{ 'boxeup_navigation.error' | t }}"></p>
</section>
{% schema %}
{"name":"BOXEUP | Categorias","tag":"section","class":"section-boxeup-shop-categories","settings":[],"presets":[{"name":"BOXEUP | Categorias"}]}
{% endschema %}


