{% comment %}
  Renders a standard dropdown style menu for the header.

  Usage:
  {% render 'header-dropdown-menu' %}
{% endcomment %}

{%- assign vc_locale = request.locale.iso_code | slice: 0, 2 -%}
{%- assign vc_caps = 'Capacetes' -%}
{%- assign vc_shorts = 'Calções' -%}
{%- assign vc_clothing = 'Roupa' -%}
{%- if vc_locale == 'en' -%}
  {%- assign vc_caps = 'Headguards' -%}{%- assign vc_shorts = 'Shorts' -%}{%- assign vc_clothing = 'Clothing' -%}
{%- elsif vc_locale == 'es' -%}
  {%- assign vc_caps = 'Cascos' -%}{%- assign vc_shorts = 'Pantalones cortos' -%}{%- assign vc_clothing = 'Ropa' -%}
{%- endif -%}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      {%- liquid
        assign vi_hide_primary_link = false
        assign vi_link_label = link.title | downcase | strip
        if link.url contains '/pages/sobre-a-boxeup' or link.url contains '/pages/sobre-a-viriatto' or link.url contains '/pages/contact'
          assign vi_hide_primary_link = true
        elsif link.handle == 'sobre-nos' or link.handle == 'sobre-a-boxeup' or link.handle == 'sobre-a-viriatto' or link.handle == 'about-us' or link.handle == 'about' or link.handle == 'contactos' or link.handle == 'contacto' or link.handle == 'contact' or link.handle == 'contact-us'
          assign vi_hide_primary_link = true
        elsif vi_link_label == 'sobre nós' or vi_link_label == 'about us' or vi_link_label == 'contactos' or vi_link_label == 'contacts' or vi_link_label == 'contact' or vi_link_label == 'contacto'
          assign vi_hide_primary_link = true
        endif
      -%}
      {%- unless vi_hide_primary_link -%}
      <li>
        {%- if link.handle == 'modalidades' -%}
          <div class="boxeup-nav-modalities">
            <a id="HeaderMenu-{{ link.handle }}" href="{{ routes.all_products_collection_url }}#main-collection-filters" class="header__menu-item list-menu__item link link--text focus-inset boxeup-nav-modalities__trigger">
              <span>{{ link.title | escape }}</span>
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </a>
            <ul class="boxeup-nav-modalities__dropdown" role="list" aria-label="{{ link.title | escape }}">
              <li>
                <a class="boxeup-nav-modalities__link focus-inset" href="{{ collections['boxe'].url }}#main-collection-filters"{% if collection.handle == 'boxe' %} aria-current="page"{% endif %}>{{ 'boxeup_navigation.boxe' | t }}</a>
              </li>
              <li>
                <a class="boxeup-nav-modalities__link focus-inset" href="{{ collections['muay-thai-e-kickboxing'].url }}#main-collection-filters"{% if collection.handle == 'muay-thai-e-kickboxing' %} aria-current="page"{% endif %}>{{ 'boxeup_navigation.muay_thai' | t }}</a>
              </li>
              <li class="boxeup-nav-modalities__divider" role="separator" aria-hidden="true"></li>
              <li><span class="boxeup-nav-modalities__link boxeup-nav-modalities__link--disabled" aria-disabled="true">MMA <small class="boxeup-nav-modalities__badge">{{ 'boxeup_navigation.coming_soon' | t }}</small></span></li>
              <li><span class="boxeup-nav-modalities__link boxeup-nav-modalities__link--disabled" aria-disabled="true">Jiu-Jitsu <small class="boxeup-nav-modalities__badge">{{ 'boxeup_navigation.coming_soon' | t }}</small></span></li>
            </ul>
          </div>
        {%- elsif link.links != blank -%}
          {% comment %}
            BOXEUP: same hover/focus menu surface and animation as Modalidades.
            Preserve the existing Shopify menu links, including third-level entries.
          {% endcomment %}
          <div class="boxeup-nav-modalities">
            <a
              id="HeaderMenu-{{ link.handle }}"
              href="{% if link.handle == 'catalogo' %}{{ collections['catalogo-viriatto'].url | default: '/collections/catalogo-viriatto' }}{% elsif link.handle == 'marcas' %}{{ collections['catalogo-viriatto'].url | default: '/collections/catalogo-viriatto' }}#BxBrands{% elsif link.handle == 'novidades' %}{{ collections['novidades-viriatto'].url | default: '/collections/novidades-viriatto' }}{% else %}{{ link.url }}{% endif %}"
              class="header__menu-item list-menu__item link link--text focus-inset boxeup-nav-modalities__trigger"
              {% if link.current %}aria-current="page"{% endif %}
            >
              <span{% if link.child_active %} class="header__active-menu-item"{% endif %}>{{ link.title | escape }}</span>
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </a>
            <ul id="HeaderMenu-MenuList-{{ forloop.index }}" class="boxeup-nav-modalities__dropdown" role="list" aria-label="{{ link.title | escape }}">
              {%- if link.handle == 'marcas' -%}
                <li><a id="HeaderMenu-marcas-viriatto" class="boxeup-nav-modalities__link focus-inset" href="{{ collections['viriatto'].url | default: '/collections/viriatto' }}">VIRIATTO</a></li>
              {%- endif -%}
              {%- for childlink in link.links -%}
                {%- assign vc_child_handle = childlink.url | split: '/collections/' | last | split: '?' | first | split: '#' | first -%}
                {%- if link.handle == 'marcas' and vc_child_handle == 'buddha' -%}{%- continue -%}{%- endif -%}
                {%- if link.handle == 'catalogo' -%}
                  {%- if vc_child_handle == 'boxe' or vc_child_handle == 'muay-thai-e-kickboxing' -%}{%- continue -%}{%- endif -%}
                  {%- if vc_child_handle == 'boqueiras-e-protecoes' -%}
                    <li><a id="HeaderMenu-catalogo-capacetes" class="boxeup-nav-modalities__link focus-inset" href="{{ collections['capacetes-de-boxe'].url | default: '/collections/capacetes-de-boxe' }}">{{ vc_caps }}</a></li>
                  {%- endif -%}
                  {%- if vc_child_handle == 'calcoes-e-roupa-de-combate' -%}
                    <li><a id="HeaderMenu-catalogo-calcoes" class="boxeup-nav-modalities__link focus-inset" href="{{ collections['calcoes-de-combate'].url | default: '/collections/calcoes-de-combate' }}">{{ vc_shorts }}</a></li>
                    <li><a id="HeaderMenu-catalogo-roupa" class="boxeup-nav-modalities__link focus-inset" href="{{ collections['roupa-e-fightwear'].url | default: '/collections/roupa-e-fightwear' }}">{{ vc_clothing }}</a></li>
                    {%- continue -%}
                  {%- endif -%}
                {%- endif -%}

                <li>
                  <a
                    id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                    href="{% if link.handle == 'catalogo' and vc_child_handle == 'all' %}{{ collections['catalogo-viriatto'].url | default: '/collections/catalogo-viriatto' }}{% else %}{{ childlink.url }}{% endif %}"
                    class="boxeup-nav-modalities__link focus-inset"
                    {% if childlink.current %}aria-current="page"{% endif %}
                  >{{ childlink.title | escape }}</a>
                  {%- if childlink.links != blank -%}
                    <ul class="boxeup-nav-modalities__children" role="list">
                      {%- for grandchildlink in childlink.links -%}
                        <li>
                          <a
                            id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                            href="{{ grandchildlink.url }}"
                            class="boxeup-nav-modalities__link boxeup-nav-modalities__link--nested focus-inset"
                            {% if grandchildlink.current %}aria-current="page"{% endif %}
                          >{{ grandchildlink.title | escape }}</a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{% if link.handle == 'catalogo' %}{{ collections['catalogo-viriatto'].url | default: '/collections/catalogo-viriatto' }}{% elsif link.handle == 'marcas' %}{{ collections['catalogo-viriatto'].url | default: '/collections/catalogo-viriatto' }}#BxBrands{% elsif link.handle == 'novidades' %}{{ collections['novidades-viriatto'].url | default: '/collections/novidades-viriatto' }}{% else %}{{ link.url }}{% endif %}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if link.current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endunless -%}
      {%- endfor -%}
    {% render 'viriatto-nav-specials', mode: 'desktop' %}
  </ul>
</nav>
